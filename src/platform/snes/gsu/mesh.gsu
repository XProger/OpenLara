; OpenLara - SNES / Super FX target
; GSU geometry pipeline: matrix, transform, projection, face setup.
;
; This is the half of the renderer the GSU is actually good at. FMULT is a
; signed 16x16 multiply returning the high word -- exactly a fixed-point
; multiply with a 16-bit fraction -- so a 3x3 rotate is nine instructions of
; real work rather than nine library calls, which is what the same code costs
; on the 65816.
;
; Fixed point: matrix elements are 1.15, so 1.0 is $7FFF and FMULT(v, m)
; returns v * m / 2. The doubling is put back after the three products are
; summed, which costs one ADD instead of three.

; ---------------------------------------------------------------------------
; Locals, all inside the LMS/SMS short-address window.
; ---------------------------------------------------------------------------

.DEFINE M_00        $80     ; 3x4 matrix, row major: 3x3 rotate then translate
.DEFINE M_00_BYTE   $0080   ; the same, as an address for LDW/STW
.DEFINE M_01        $82
.DEFINE M_02        $84
.DEFINE M_TX        $86
.DEFINE M_10        $88
.DEFINE M_11        $8A
.DEFINE M_12        $8C
.DEFINE M_TY        $8E
.DEFINE M_20        $90
.DEFINE M_21        $92
.DEFINE M_22        $94
.DEFINE M_TZ        $96

.DEFINE T_LINK      $98     ; call/return saves
.DEFINE T_ROM       $9A     ; ROM cursor while walking model data
.DEFINE T_COUNT     $9C
.DEFINE T_X         $A0     ; model space
.DEFINE T_Y         $A2
.DEFINE T_Z         $A4
.DEFINE T_CX        $A6     ; camera space
.DEFINE T_CY        $A8
.DEFINE T_CZ        $AA
.DEFINE T_ANGLE     $AC
.DEFINE T_LOOP      $AE     ; selected cached vertex-loop entry
.DEFINE T_LINK2     $DE     ; ProjectPoint's link
.DEFINE T_REJECT    $C4     ; set when a vertex cannot be drawn safely
.DEFINE F_BMAX      $C6     ; the deepest bucket OTBuild filed into, and
.DEFINE F_BMIN      $9E     ; the nearest: OTDraw walks only that range

.DEFINE F_LINK      $B0     ; DrawMesh saves
.DEFINE F_ROM       $B2
.DEFINE F_COUNT     $B4
.DEFINE F_I         $B6
.DEFINE F_PTR       $B8     ; cursor into the face's VertexLink array
.DEFINE F_TOP       $BA     ; address of the topmost link
.DEFINE F_SCR0      $BE
.DEFINE F_SCR1      $C0
.DEFINE F_VROM      F_SCR0     ; DrawFace: start of this face's vertex stream
.DEFINE F_NEAR      F_SCR1     ; OTBuild's precomputed near-plane flag
.DEFINE F_LINK2     $D4
; One slot per caller. Sharing one word between OTDraw's link, FaceVisible's
; link and DrawFace's UV scratch meant the first face drawn destroyed the draw
; loop's return address, and the ordering walk never left its last bucket.
.DEFINE F_LINK3     $D6     ; OTDraw
.DEFINE F_LINK4     $D8     ; OTBuild
.DEFINE F_LINK5     $DA     ; FaceVisible / DF_LoadClip, never nested

; $80-$DF was full by the time the shade term arrived, so these live above the
; frame entry block. Still inside the LMS/SMS window, which reaches $1FE.
.DEFINE T_G         $110    ; vertex shade, 0 bright to 31 dark

; --- the room being drawn, out of the level's room table -------------------
.DEFINE R_LINK      $112
.DEFINE R_ROMB      $114    ; GSU ROM bank holding this room's data
.DEFINE R_ADDR      $116    ; geometry, within that bank
.DEFINE R_PADDR     $118    ; portal list, within that bank
.DEFINE R_PCOUNT    $11A
.DEFINE R_X         $11C    ; world offset of the room origin
.DEFINE R_Y         $11E
.DEFINE R_Z         $120
.DEFINE R_CAMX      $122    ; the camera, in this room's frame
.DEFINE R_CAMY      $124
.DEFINE R_CAMZ      $126
.DEFINE R_YBOT      $158    ; how far down the room reaches, from its origin
.DEFINE R_SADDR     $15A    ; sector grid, within the room's bank
.DEFINE R_XS        $15C    ; sectors across and along
.DEFINE R_ZS        $15E
.DEFINE R_IADDR     $19C    ; static mesh placements, within the room's bank
.DEFINE R_ICOUNT    $19E
.DEFINE R_ITADDR    $1F0    ; entity placements, within the room's bank
.DEFINE R_ITCOUNT   $1F2
.DEFINE RF_LINK     $160    ; RoomFind
.DEFINE RF_I        $162
.DEFINE RF_COUNT    $164
.DEFINE RF_BEST     $166
.DEFINE RF_ANY      $182    ; a room that matches in x and z but not in y

; --- static mesh placements ------------------------------------------------
.DEFINE MI_LINK     $184
.DEFINE MI_I        $186
.DEFINE MI_ROM      $188    ; cursor through the room's placement list
.DEFINE MI_BANK     $18A
.DEFINE MI_ADDR     $18C
.DEFINE MI_ANG      $18E
.DEFINE MI_X        $190
.DEFINE MI_Y        $192
.DEFINE MI_Z        $194
.DEFINE MI_CAMX     $196    ; the room's camera, kept while instances move it
.DEFINE MI_CAMY     $198
.DEFINE MI_CAMZ     $19A
.DEFINE MI_ROMB     $1A0    ; the *room's* bank, which each instance overwrites

; --- the matrix stack ------------------------------------------------------
.DEFINE MX_LINK     $1A2
.DEFINE MX_LINK2    $1B8    ; MatrixSinCos; MatrixRotateY is holding MX_LINK
.DEFINE MX_SIN      $1A6
.DEFINE MX_COS      $1A8
.DEFINE MX_ROW      $1AA    ; cursor while walking the three rows
.DEFINE MX_I        $1AC
.DEFINE MX_A        $1AE    ; the two elements a rotation mixes
.DEFINE MX_B        $1B0
.DEFINE MX_X        $1B2    ; a translation, in the current frame
.DEFINE MX_Y        $1B4
.DEFINE MX_Z        $1B6
.DEFINE MX_CA       $1BA    ; byte offsets of the two columns a rotation mixes
.DEFINE MX_CB       $1BC
.DEFINE MX_ANG      $1BE

; --- entity placements, and the model stream one points at -----------------
.DEFINE S_LINK      $F0     ; SphereVisible: link, radius, radius on screen
.DEFINE S_R         $F2
.DEFINE S_RS        $F4
.DEFINE IT_LINK     $1C0
.DEFINE IT_I        $1C2
.DEFINE IT_ROM      $1C4    ; cursor through the room's placement list
.DEFINE IT_ROMB     $1C6    ; the *room's* bank, which each model overwrites
.DEFINE IT_ADDR     $1C8
.DEFINE IT_BANK     $1CA
.DEFINE IT_NODES    $1CC
.DEFINE IT_ANG      $1CE
.DEFINE IT_X        $1D0
.DEFINE IT_Y        $1D2
.DEFINE IT_Z        $1D4
.DEFINE IT_SLOT     $F60C   ; where this entity's state sits in GS_ITEM
.DEFINE R_INDEX     $F62A   ; the room RR_Room is drawing
.DEFINE ENT_COUNT   $F62C   ; one past the highest entity slot
.DEFINE ENT_READY   $F62E   ; EntBuild has run; the host clears it at boot
.DEFINE EB_LINK     $F630
.DEFINE ENT_TABLE   $DC40   ; 4 bytes a slot: model address, bank; ends $DE3F

.DEFINE MD_LINK     $1D6
.DEFINE MD_I        $1D8
.DEFINE MD_ROM      $1DA    ; cursor through the node stream
.DEFINE MD_ROMB     $1DC
.DEFINE MD_ADDR     $1DE
.DEFINE MD_BANK     $1E0
.DEFINE MD_FLAGS    $1E2
.DEFINE MD_X        $1E4
.DEFINE MD_Y        $1E6
.DEFINE MD_Z        $1E8
.DEFINE MD_AX       $1EA
.DEFINE MD_AY       $1EC
.DEFINE MD_AZ       $1EE
.DEFINE MD_FRM      $1F4    ; cursor through the chosen frame
.DEFINE MD_FX       $1F6    ; the root's translate, which is the frame's
.DEFINE MD_FY       $1F8
.DEFINE MD_FZ       $1FA
.DEFINE MD_PHASE    $1FC    ; the host's (animation, frame) for this entity
.DEFINE MD_CULL     $1FE    ; non-zero when DrawModel should test node spheres

; The model header, which has to survive the whole node walk. Past the LMS
; window, so these use LM/SM and their 16-bit address.
.DEFINE MD_BASE     $F600   ; the blob, for finding its animation table
.DEFINE MD_FSTRIDE  $F602
.DEFINE MD_ANIMN    $F604
.DEFINE MD_ATAB     $F606
.DEFINE MD_FBASE    $F608
.DEFINE MD_FBANK    $F60A   ; the animation's frames need not share the bank
.DEFINE WA_MATRIX   $F610   ; Lara's object basis, nine words
.DEFINE WA_ARM      $F622   ; current WeaponArm address in GS_WEAPON
.DEFINE WA_NODE     $F624   ; Lara joint index (0..14)
.DEFINE WA_LARA     $F626   ; model belongs to item slot zero and has 15 nodes
.DEFINE WA_LINK     $F628   ; weapon helper's return address
.DEFINE SC_LINK     $168    ; SectorAt
.DEFINE SC_FLOOR    $16A
.DEFINE SC_CEIL     $16C
.DEFINE SC_TRIG     $F60C   ; the trigger index, or $FFFF
.DEFINE SC_SX       $16E    ; world corner of the sector the probe landed in
.DEFINE SC_SZ       $170
.DEFINE PB_X        $172    ; the point RoomLoad and RoomFind work on
.DEFINE PB_Y        $174
.DEFINE PB_Z        $176
.DEFINE PB_LINK     $178
.DEFINE PB_LINK2    $17A
.DEFINE PB_LINK3    $17C
.DEFINE PB_CX       $17E    ; the camera, kept while the probes wander off it
.DEFINE PB_CZ       $180
.DEFINE T_LINK3     $128    ; TransformPoint's link

; --- portal walk -----------------------------------------------------------
.DEFINE P_LINK      $12A
.DEFINE P_LINK2     $12C
.DEFINE P_I         $12E    ; portal index within the room
.DEFINE P_ROOM      $130    ; the room on the far side
.DEFINE P_FRONT     $132    ; corners in front of the near plane
.DEFINE P_MINX      $134    ; screen bounding box of the portal
.DEFINE P_MAXX      $136
.DEFINE P_MINY      $138
.DEFINE P_MAXY      $13A
.DEFINE P_DOT       $13C    ; sign of dot(normal, corner - camera)
.DEFINE P_ROM       $13E    ; ROM cursor, saved across the transform calls
.DEFINE RL_LINK     $140
.DEFINE RL_LINK2    $142
.DEFINE RL_HEAD     $144    ; queue read cursor
.DEFINE RL_COUNT    $146
.DEFINE RL_J        $148    ; draw cursor, counting down
.DEFINE RL_TMP      $14A
.DEFINE RL_I        $14C    ; portal index; not P_I, which PortalVisible owns
.DEFINE RC_X0       $14E    ; the rectangle the room being expanded was seen
.DEFINE RC_X1       $150    ; through; every portal out of it narrows this
.DEFINE RC_Y0       $152
.DEFINE RC_Y1       $154
.DEFINE RC_SLOT     $156
.DEFINE R_NOTFULL   RC_SLOT ; after collection: OR of this room's clip differences

; The portal box is built by subtracting screen coordinates from each other,
; and a projected corner just past the near plane can be tens of thousands.
; Clamping every corner into +/-PORT_CLAMP first keeps those differences well
; inside a signed word without changing any answer: everything beyond the
; frame edge is equally outside it. The box starts outside that range so the
; first corner always replaces it, and the sentinels still cannot overflow.
.DEFINE PORT_CLAMP  1024
.DEFINE PORT_MIN    2047
.DEFINE PORT_MAX    -2047

; --- near-plane clipper ($60-$7F) ------------------------------------------
.DEFINE C_LINK      $60
.DEFINE C_LINK2     $62
.DEFINE C_N         $64     ; input vertex count
.DEFINE C_M         $66     ; output vertex count
.DEFINE C_I         $68
.DEFINE C_A         $6A     ; pointer to the edge's first vertex
.DEFINE C_B         $6C     ; and its second
.DEFINE C_AIN       $6E     ; is A in front of the near plane
.DEFINE C_BIN       $70
.DEFINE C_T         $72     ; intersection parameter, 8.8
.DEFINE C_DST       $74     ; emit cursor
.DEFINE T_SX        $76     ; ProjectPoint results
.DEFINE T_SY        $78
.DEFINE C_NVERT     $7A     ; vertices in the face finally handed to the raster
.DEFINE C_J         $7C     ; ClipLerp's component counter -- not C_I, which
                            ; belongs to the edge loop calling it
.DEFINE F_PAGE      $C8     ; GSU bank of this face's texture page
.DEFINE F_IDX       $CC     ; index of the face being processed
.DEFINE F_BUCKET    $CE
.DEFINE F_CURSOR    $D2
.DEFINE FACE_FLAT   $80     ; low nibble is a palette index, not a ROM page
.DEFINE FACE_AKILL  $40     ; source-index-zero texels preserve the background

; ---------------------------------------------------------------------------
; Ordering table.
;
; Faces arrive in whatever order the level stores them, which paints near
; geometry under far geometry. OpenLara buckets faces by depth and walks the
; buckets back to front; the same thing here, with the lists living in game
; pak RAM above the frame buffers.
;
; Bucket = camera z >> OT_SHIFT, saturating, so the table covers the whole
; view distance without a divide.
; ---------------------------------------------------------------------------

.DEFINE OT_HEAD     $E000       ; 64 words, $FFFF terminates
.DEFINE OT_BUCKETS  64
.DEFINE OT_SHIFT    9
.DEFINE OT_NEXT     $E080       ; per face: index of the next face in its bucket
.DEFINE OT_OFF      $E500       ; per face: its offset in the packed face list
.DEFINE OT_MAX      576         ; LEVEL1 room 26 has 546; 512 dropped its tail
.DEFINE OT_NEAR     $DA00       ; byte per filed face: any vertex is near
                                ; TV_BASE + 768 * TV_SIZE ends exactly here

; ---------------------------------------------------------------------------
; Clipper work buffers. Sutherland-Hodgman against the near plane turns a quad
; into up to five vertices, so two buffers of eight are ample.
;
;   +0 camera X   +2 camera Y   +4 camera Z   +6 u   +8 v   +10 g
;
; g interpolates with everything else. A vertex the clipper invents sits part
; way along an edge and its shade has to sit part way between the two ends, or
; a clipped floor changes brightness where it meets its unclipped neighbour.
; ---------------------------------------------------------------------------

.DEFINE CLIP_A      $F500
.DEFINE CLIP_B      $F580
.DEFINE CLIP_SIZE   16
.IFDEF SHADING
.DEFINE CLIP_COMPS  6       ; words ClipEmit copies and ClipLerp interpolates
.ELSE
.DEFINE CLIP_COMPS  5       ; without the shade there is nothing at CV_G
.ENDIF
.DEFINE CV_X        0
.DEFINE CV_Y        2
.DEFINE CV_Z        4
.DEFINE CV_U        6
.DEFINE CV_V        8
.DEFINE CV_G        10

; Transformed vertices, 14 bytes each, in the engine data area above the frame
; buffers. Camera space is kept as well as screen space: the near-plane clipper
; interpolates in camera space, because a vertex behind the camera has no
; screen position to interpolate towards.
; $B000-$D9FF holds exactly 768 records. The largest room in LEVEL1 has 620;
; the packer refuses anything over that limit rather than letting vertices
; run into OT_NEAR, the filed-face near flags immediately above them.
.DEFINE TV_BASE     $B000
;
; The field order is not arbitrary. DrawFace's common path copies the first
; three words into a VertexLink; its cold near path copies the camera-space
; triple into a clip vertex. Each destination gets a contiguous pointer walk
; rather than an address computed per field. The final word combines the old
; near flag with the four screen-side flags.
.DEFINE TV_SIZE     14
.DEFINE TV_X        0       ; screen X, valid only when TV_CLIP bit 0 is clear
.DEFINE TV_Y        2       ; screen Y                                    -> VL_Y
.DEFINE TV_G        4       ; shade, straight from the packed vertex      -> VL_G
.DEFINE TV_CX       6       ; camera X                                    -> CV_X
.DEFINE TV_CY       8       ; camera Y                                    -> CV_Y
.DEFINE TV_CZ       10      ; camera Z                                    -> CV_Z
.DEFINE TV_CLIP     12      ; which sides of the clip rectangle the screen
                            ; point is off: 2 left, 4 right, 8 above, 16
                            ; below; a near vertex carries 1 and nothing
                            ; else. OTB_Vertex ANDs them over a face, and a
                            ; face whose vertices share a bit is never
                            ; filed -- half of a room seen from inside it

; The rasterizer clamps spans to the screen and skips scanlines outside it, so
; a vertex being off screen is no longer a reason to drop its face. What is
; still fatal is a vertex at or behind the camera: the projection divides by
; its depth. Those are marked here and their faces dropped, until the
; near-plane clipper replaces them with real intersections.
.DEFINE ZMIN        512

; ZMIN is where the projection's table runs out -- dz = (z >> 8) * 2 has to
; be 4 or more for 65536 / dz to fit FMULT's signed word -- and on GSU-2 it is
; the clip plane as well, which left anything nearer the camera than 512
; undrawn: her whole model, once the combat camera had clipped to a wall 257
; behind her head. FX3 clips at upstream's VIEW_MIN_F instead and projects
; 64..511 out of line (TM_Near, PC_Near, NEAR_SCALE): 128 c / z exactly,
; meeting the table's 128 c / 512 at ZMIN. The sphere tests' "no projection
; to trust" stays ZMIN; their "wholly behind" moves with the plane.
.IFDEF FX3
.DEFINE ZNEAR       64
.ELSE
.DEFINE ZNEAR       ZMIN
.ENDIF

; The face batch: VertexLinks for the faces set up but not yet drawn, in
; the slots OTDraw describes, up to the frame buffers. The limit leaves room
; for the five links a clipped quad can need and the face's edge cell, so a
; slot that starts under it always fits.
.DEFINE BATCH_BASE  $0200
.DEFINE BATCH_END   $1000
.DEFINE BATCH_LIMIT (BATCH_END - 6 * VL_SIZE)
.DEFINE SL_PAGE     10      ; the slot header, in the first link's spare bytes
.DEFINE SL_TOP      12      ; the address of the topmost vertex's VL_Y word
.DEFINE SL_NEXT     14      ; the next slot; the face's edge cell is the one before
.DEFINE B_SLOT      $C2     ; the slot the next face goes in
.DEFINE B_CUR       $D0     ; BatchFlush's cursor through the slots
.DEFINE B_LINK      $7E     ; and its link

; ---------------------------------------------------------------------------
; The room table, at offset 0 of the level's first GSU bank.
;
;   uint16 roomCount
;   uint16 pad
;   RoomEntry rooms[]           32 bytes, so the index is five doublings
;
; RoomEntry:
;   +0  uint16 addr             geometry, within the bank
;   +2  uint16 portalAddr       portal list, within the same bank
;   +4  uint8  bank             relative; LEVEL_BANK_BASE is added here
;   +5  uint8  portalCount
;   +6  int16  x, y, z          world offset of the room origin
;   +12 int16  yBottom          floor-most extent, relative to y
;   +14 uint16 sectorAddr       the 1024-unit sector grid, same bank
;   +16 uint8  xSectors, zSectors
;   +18 uint16 instAddr         static mesh placements, same bank
;   +20 uint8  instCount
;   +21 uint8  itemCount        entity placements -- count first, so the
;   +22 uint16 itemAddr         address stays even inside the 32 bytes
;
; Vertices are stored in the room's own frame. Rather than transform them into
; the world, the camera is moved into the room -- one subtraction per room
; instead of one addition per vertex, and the matrix builder needs no change.
; ---------------------------------------------------------------------------

.DEFINE ROOM_TABLE  $0004
.DEFINE ROOM_ENTRY  32

; ---------------------------------------------------------------------------
; Portal record, 32 bytes, in the same frame as the room's vertices:
;
;   uint16 roomIndex
;   int16  normal[3]           axis aligned unit vector, pointing out
;   int16  corner[4][3]
;
; And the traversal's own state, above the shade maps in game pak RAM.
; ---------------------------------------------------------------------------

.DEFINE PORTAL_SIZE $20

; ---------------------------------------------------------------------------
; Static mesh placement, 12 bytes:
;
;   uint16 addr        the mesh, within its bank
;   uint8  bank        relative to LEVEL_BANK_BASE, or $FF for "nothing here"
;   uint8  angle       Y rotation, top byte of TR's
;   int16  x, y, z     where it stands, in the room's frame
;   uint8  g, pad
;
; The mesh it points at is byte for byte a room: a vertex count, a face count,
; eight-byte vertices, the same face records. Its placement only adds another
; Y rotation, so drawing one is the yaw-only TransformRoom and DrawMesh with
; different addresses, and not a line of new pipeline.
; ---------------------------------------------------------------------------

; The matrix stack. Eight levels is more than TR's deepest model needs, and
; the matrix itself is the twelve words at M_00 -- so pushing is a copy and
; everything downstream keeps reading the same place.
.DEFINE MX_STACK    $F400
.DEFINE MX_WORDS    12
.DEFINE MX_MAX      8

.DEFINE INST_SIZE   12
.DEFINE INST_NONE   $FF

; ---------------------------------------------------------------------------
; Entity placement, 12 bytes, and the model stream it points at.
;
;   uint16 addr        the model's node stream, within its bank
;   uint8  bank        relative to LEVEL_BANK_BASE, or $FF for "nothing here"
;   uint8  index       its slot in the host's per-entity array, GS_PHASE
;   uint8  angle       Y rotation, top byte of TR's
;   uint8  g
;   int16  x, y, z     where it stands, in the room's frame
;
; A static mesh placement has the same twelve bytes with the slot byte
; folded into the address, g after z, and last the mesh's bounding radius
; in units of 32 (its visibility box), for the same test.
;
; A model is a flat stream of node records, one per mesh, in draw order --
; upstream's models, nodes and frameData tables flattened by the packer into
; the one thing the ROM buffer is good at, which is reading forward. Node
; record, NODE_SIZE = 11 bytes:
;
;   uint16 meshAddr    within its bank
;   uint8  meshBank    relative, or $FF to skip the mesh but keep the frame
;   uint8  flags       bit 0 pop, bit 1 push, bit 2 root, bit 3 billboard
;   uint8  radius      sphere about the node origin / 32; zero disables it.
;                      Flags and radius are one little-endian ROM word.
;   int16  x, y, z     translate, in the parent's frame
;
; What varies between frames is not in there. A node's translate is static in
; TR -- only the root's animates -- so a pose is three angles per node, and
; keeping the two apart is what makes animation fit: a whole node stream per
; frame costs 11 bytes a node where this costs 3. So a model is
;
;   uint8  nodeCount
;   uint8  radius      of a sphere holding every frame's box, in units of
;                      32: what DrawRoomItems tests against the clip
;                      rectangle before any of this is read
;   uint16 frameStride 6 + 3 * nodeCount, at most 255
;   uint16 animCount   animations the model owns; the host's animation byte
;                      is clamped against it
;   uint16 animTable   within the same bank: one record per animation saying
;                      where its frames start and how many there are
;   ... nodeCount node records
;   ... the frames, then the animation table
;
; and a frame is the root's translate followed by three angle bytes per node:
;
;   int16  x, y, z
;   uint8  aX, aY, aZ  per node, 256 to the turn, applied Y then X then Z
;
; The angles arrive pre-narrowed because the sine table has 256 entries and
; TR packs three 10-bit fields across a 32-bit word: unpacking that costs a
; dozen shifts here to recover bits the table cannot represent anyway.
; ---------------------------------------------------------------------------

.DEFINE ITEM_SIZE   12
.DEFINE NODE_SIZE   11
.DEFINE MODEL_HDR   8
.DEFINE NODE_POP    $01
.DEFINE NODE_PUSH   $02
.DEFINE NODE_ROOT   $04
.DEFINE NODE_BILLBOARD $08      ; face the camera: no rotation, only position
.DEFINE NODE_SEQUENCE  $10      ; FX3: a run of sprite meshes, chosen by AY
.DEFINE SPRITE_MESH    54       ; one of them (packer SNES_SPRITE_MESH)
.DEFINE RL_LIST     $F000   ; visible rooms, one word each, nearest first
.DEFINE RL_VISITED  $F100   ; one byte per room
.DEFINE RL_RECT     $F200   ; the clip rectangle each was seen through
.DEFINE RL_MAX      6       ; a frame is expensive; this is the ceiling
.DEFINE RL_ROOMS    64

; Projection. dz = z >> PROJ_SHIFT indexes the reciprocal table, so the
; effective focal length is 1 << PROJ_SHIFT pixels -- 64 in the Mode 7
; frame, where the table it indexes (M7_PROJTAB, 32768 / dz) halves the
; result and with it every screen coordinate. Same view, half the pixels.
.DEFINE PROJ_SHIFT  7
; SCREEN_CX / SCREEN_CY live in gsu.inc: FrameStart shears the Y centre.

.BANK 0 SLOT 0
.SECTION "mesh" FREE

; ===========================================================================
; RomWordAt -- R0 = the 16-bit little-endian word at ROMBR:R14, R14 += 2.
;
; Writing R14 starts the fetch and GETB waits for it, so the INCs double as
; the delay the manual asks for.
; ===========================================================================

RomWordAt:
    to r0
    getb                        ; low byte
    inc r14
    with r0
    getbh                       ; high byte
    inc r14
    GRET

; ===========================================================================
; RomByteAt -- R0 = the byte at ROMBR:R14, R14 += 1.
; ===========================================================================

RomByteAt:
    to r0
    getb
    inc r14
    GRET

; ===========================================================================
; RoomLoad -- read room R0's entry out of the level table.
;
; Fills R_ROMB/R_ADDR/R_PADDR/R_PCOUNT with where its data is, and R_CAMX/Y/Z
; with the camera expressed in that room's frame. Everything downstream then
; works exactly as it did when there was only one room at the origin.
; ===========================================================================

RoomLoad:
    sms (R_LINK), r11

    ibt r6, #LEVEL_BANK_BASE
    from r6
    romb

    ; R14 = ROOM_TABLE + index * 32
    to r14
    add r0
    with r14
    add r14
    with r14
    add r14
    with r14
    add r14
    with r14
    add r14
    ibt r6, #ROOM_TABLE
    with r14
    add r6

    GFCALL RomWordAt
    sms (R_ADDR), r0
    GFCALL RomWordAt
    sms (R_PADDR), r0

    GFCALL RomByteAt            ; bank, relative to the level's base
    ibt r6, #LEVEL_BANK_BASE
    with r0
    add r6
    sms (R_ROMB), r0

    GFCALL RomByteAt
    sms (R_PCOUNT), r0

    GFCALL RomWordAt
    sms (R_X), r0
    GFCALL RomWordAt
    sms (R_Y), r0
    GFCALL RomWordAt
    sms (R_Z), r0
    GFCALL RomWordAt
    sms (R_YBOT), r0
    GFCALL RomWordAt
    sms (R_SADDR), r0
    GFCALL RomByteAt
    sms (R_XS), r0
    GFCALL RomByteAt
    sms (R_ZS), r0
    GFCALL RomWordAt
    sms (R_IADDR), r0
    GFCALL RomByteAt
    sms (R_ICOUNT), r0
    GFCALL RomByteAt
    sms (R_ITCOUNT), r0
    GFCALL RomWordAt
    sms (R_ITADDR), r0

    ; The point of interest moves into the room rather than the room into the
    ; world. It is normally the camera; the collision probes borrow it.
    lms r5, (PB_X)
    lms r0, (R_X)
    with r5
    sub r0
    sms (R_CAMX), r5

    lms r5, (PB_Y)
    lms r0, (R_Y)
    with r5
    sub r0
    sms (R_CAMY), r5

    lms r5, (PB_Z)
    lms r0, (R_Z)
    with r5
    sub r0
    sms (R_CAMZ), r5

    lms r11, (R_LINK)
    GRET

; ===========================================================================
; MatrixCamera -- build the view matrix for a camera at FR_CAMX/Y/Z with yaw R0.
;
; The view transform is v = R(-yaw) * (p - c), so the rotation is the inverse
; of the camera's own and the translation is -R(-yaw)*c, not simply -c.
;
;     [  cos  0  -sin  tx ]
;     [   0   1    0   ty ]
;     [  sin  0   cos  tz ]
;
;     tx = -(cos*cx - sin*cz)   ty = -cy   tz = -(sin*cx + cos*cz)
; ===========================================================================

MatrixCamera:
    sms (T_LINK), r11
    sms (T_ANGLE), r0

    ibt r6, #GSU_BANK
    from r6
    romb

    ; sin(yaw)
    iwt r6, #ModelData
    to r14
    add r0                      ; index * 2
    with r14
    add r6
    GFCALL RomWordAt
    sms (M_20), r0              ; m20 =  sin
    with r0
    not
    inc r0                      ; two's complement negate
    sms (M_02), r0              ; m02 = -sin

    ; cos(yaw) = sin(yaw + quarter turn)
    lms r0, (T_ANGLE)
    ibt r6, #64
    with r0
    add r6
    iwt r6, #$00FF
    with r0
    and r6                      ; wrap into the table
    iwt r6, #ModelData
    to r14
    add r0
    with r14
    add r6
    GFCALL RomWordAt
    sms (M_00), r0
    sms (M_22), r0

    ibt r0, #0
    sms (M_01), r0
    sms (M_10), r0
    sms (M_12), r0
    sms (M_21), r0
    iwt r0, #$7FFF
    sms (M_11), r0              ; 1.0 in 1.15

    ; tx = -(m00*cx + m02*cz), remembering FMULT halves a 1.15 product
    lms r6, (M_00)
    lms r7, (R_CAMX)
    from r7
    to r5
    fmult
    lms r6, (M_02)
    lms r7, (R_CAMZ)
    from r7
    to r8
    fmult
    with r5
    add r8
    with r5
    add r5
    with r5
    not
    inc r5
    sms (M_TX), r5

    ; ty = -cy
    lms r5, (R_CAMY)
    with r5
    not
    inc r5
    sms (M_TY), r5

    ; tz = -(m20*cx + m22*cz)
    lms r6, (M_20)
    lms r7, (R_CAMX)
    from r7
    to r5
    fmult
    lms r6, (M_22)
    lms r7, (R_CAMZ)
    from r7
    to r8
    fmult
    with r5
    add r8
    with r5
    add r5
    with r5
    not
    inc r5
    sms (M_TZ), r5

    lms r11, (T_LINK)
    GRET

; ===========================================================================
; RoomFind -- which room is the camera in?
;
; Out: R0 = the room index, or $FFFF if the camera is outside every one.
;
; The host cannot answer this. It is a question about level data, and while
; the GSU holds the ROM bus the 65816 reads dummy data -- so like the portal
; walk, it belongs on this side. The answer is staged into game pak RAM for
; the host to pick up in V-Blank, which is the channel every future piece of
; game logic will need.
;
; The test is the room's sector grid, less its border ring: TR rooms share a
; ring of wall sectors with their neighbours, so using the full extent would
; let two rooms both claim a doorway. RoomLoad has already put the camera in
; each room's own frame, so this is a comparison against zero and a size.
; ===========================================================================

RoomFind:
    sms (RF_LINK), r11

    ibt r6, #LEVEL_BANK_BASE
    from r6
    romb
    iwt r14, #0
    GFCALL RomWordAt
    sms (RF_COUNT), r0

    ibt r0, #0
    sms (RF_I), r0
    iwt r0, #$FFFF
    sms (RF_BEST), r0
    sms (RF_ANY), r0

RFD_Room:
    lms r0, (RF_I)
    GFCALL RoomLoad

    ; x and z decide which room; y only decides between rooms stacked on the
    ; same ground. A probe a step above or below a neighbour's floor still has
    ; to resolve to that neighbour, or a doorway with a step in it reads as a
    ; wall -- so a room matching in x and z is kept as the answer of last
    ; resort while the scan looks for one that matches in y as well.
    lms r5, (R_CAMX)
    lms r0, (R_XS)
    GFCALL RoomSpan
    ibt r0, #0
    from r5
    cmp r0
    beq RFD_Next
    nop

    lms r5, (R_CAMZ)
    lms r0, (R_ZS)
    GFCALL RoomSpan
    ibt r0, #0
    from r5
    cmp r0
    beq RFD_Next
    nop

    lms r0, (RF_ANY)
    iwt r5, #$FFFF
    from r0
    cmp r5
    bne +
    nop
    lms r0, (RF_I)
    sms (RF_ANY), r0
+
    lms r5, (R_CAMY)
    ibt r0, #0
    from r5
    to r6
    sub r0
    bmi RFD_Next                ; above the ceiling
    nop
    lms r0, (R_YBOT)
    from r5
    to r6
    sub r0
    beq +                       ; standing exactly on the floor plane counts
    nop
    bpl RFD_Next                ; below the floor
    nop
+
    lms r0, (RF_I)
    sms (RF_BEST), r0
    GFJMP RFD_Done

RFD_Next:
    lms r0, (RF_I)
    inc r0
    sms (RF_I), r0
    lms r5, (RF_COUNT)
    to r6
    sub r5
    bmi +
    nop
    GFJMP RFD_Done
+   GFJMP RFD_Room

RFD_Done:
    lms r0, (RF_BEST)
    iwt r5, #$FFFF
    from r0
    cmp r5
    bne +
    nop
    lms r0, (RF_ANY)            ; no vertical match; take the horizontal one
+   lms r11, (RF_LINK)
    GRET

; ---------------------------------------------------------------------------
; RoomSpan -- is R5, a coordinate in the room's frame, inside its sector grid
; less the border ring? R0 is the sector count on that axis. Out: R5 = 0 or 1.
; ---------------------------------------------------------------------------

RoomSpan:
    sms (RC_SLOT), r0           ; free between portal appends
    ibt r0, #0
    from r5
    to r6
    sub r0
    bpl +
    nop
    ibt r5, #0                  ; negative: before the room even starts
    GRET
+
    ; sector = coordinate >> 10, inline: RoomSpan is a leaf, and calling
    ; SectorShift would need a link slot to protect R11
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr

    ibt r0, #1
    from r5
    to r6
    sub r0
    bpl +
    nop
    ibt r5, #0                  ; in the border ring
    GRET
+   lms r0, (RC_SLOT)
    dec r0
    from r5
    to r6
    sub r0
    bmi +
    nop
    ibt r5, #0                  ; past the far border
    GRET
+   ibt r5, #1
    GRET

; ===========================================================================
; SectorAt -- the floor and ceiling under the camera, in the loaded room.
;
; TR's world is a 1024-unit grid and a sector stores its floor and ceiling as
; signed bytes of 256 units, so the height in world units is the byte in the
; *high* half of a word -- which is what GETBH produces, sign and all, for
; nothing. Sectors are x major.
;
; Out: SC_FLOOR, SC_CEIL, or SECTOR_NONE in SC_FLOOR for a wall.
;
; This is the second thing the GSU stages for the host, and the reason the
; first one mattered: the host is going to want to walk on floors, and the
; floor is level data.
; ===========================================================================

SectorAt:
    sms (SC_LINK), r11

    iwt r0, #SECTOR_NONE
    sms (SC_FLOOR), r0
    sms (SC_CEIL), r0
    iwt r0, #$FFFF
    sm (SC_TRIG), r0            ; past the LMS window, so the 16-bit form

    lms r5, (R_CAMX)
    lms r0, (R_XS)
    GFCALL RoomSpan
    ibt r0, #0
    from r5
    cmp r0
    bne +
    nop
    GFJMP SA_Done
+   lms r5, (R_CAMZ)
    lms r0, (R_ZS)
    GFCALL RoomSpan
    ibt r0, #0
    from r5
    cmp r0
    bne +
    nop
    GFJMP SA_Done
+
    ; sector index = (x >> 10) * zSectors + (z >> 10)
    lms r5, (R_CAMX)
    GFCALL SectorShift
    move r8, r5
    lms r5, (R_CAMZ)
    GFCALL SectorShift
    move r9, r5

    ; and where that sector starts, in the world
    move r5, r8
    GFCALL SectorScale
    lms r0, (R_X)
    with r5
    add r0
    sms (SC_SX), r5
    move r5, r9
    GFCALL SectorScale
    lms r0, (R_Z)
    with r5
    add r0
    sms (SC_SZ), r5

    lms r6, (R_ZS)
    with r8
    umult r6
    with r8
    add r9                      ; the sector's index in the grid

    ; and its address: base + index * 6
    from r8
    to r5
    add r8                      ; * 2
    from r5
    to r8
    add r5                      ; * 4
    with r8
    add r5                      ; * 6
    lms r0, (R_SADDR)
    from r8
    to r14
    add r0

    lms r6, (R_ROMB)
    from r6
    romb
    move r14, r14               ; ROMB does not reload the buffer

    ibt r0, #0
    to r0
    getbh                       ; floor, already scaled by 256
    iwt r5, #(0 - 127 * 256)
    from r0
    cmp r5
    bne +
    nop
    iwt r0, #SECTOR_NONE        ; TR's wall marker; one sentinel is enough
+   sms (SC_FLOOR), r0
    inc r14
    ibt r0, #0
    to r0
    getbh                       ; ceiling
    sms (SC_CEIL), r0

    ; and the trigger this sector fires, which the host is the only side that
    ; can do anything with. Two bytes past the two room links.
    ibt r0, #3
    with r14
    add r0
    GFCALL RomWordAt
    sm (SC_TRIG), r0

SA_Done:
    lms r11, (SC_LINK)
    GRET

; ---------------------------------------------------------------------------
; SectorScale -- R5 <<= 10, back from sectors to world units.
; ---------------------------------------------------------------------------

SectorScale:
    with r5
    add r5
    with r5
    add r5
    with r5
    add r5
    with r5
    add r5
    with r5
    add r5
    with r5
    add r5
    with r5
    add r5
    with r5
    add r5
    with r5
    add r5
    with r5
    add r5
    GRET

; ---------------------------------------------------------------------------
; SectorShift -- R5 >>= 10, the world-to-sector divide.
; ---------------------------------------------------------------------------

SectorShift:
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    with r5
    lsr
    GRET

; ===========================================================================
; Probe -- resolve PB_X/PB_Y/PB_Z to a room and the floor under it.
;
; Out: RF_BEST = room or $FFFF, SC_FLOOR/SC_CEIL, SC_SX/SC_SZ.
;
; Collision needs to ask about points the camera is not at -- the sector next
; door, to know whether walking that way is walking into a wall -- and the
; question has to be asked here, because the answer is in ROM. Four of these
; per frame is nothing next to a room's worth of vertices.
; ===========================================================================

Probe:
    sms (PB_LINK), r11
    GFCALL RoomFind
    iwt r5, #$FFFF
    from r0
    cmp r5
    bne +
    nop
    iwt r0, #SECTOR_NONE        ; nowhere: as good as a wall
    sms (SC_FLOOR), r0
    sms (SC_CEIL), r0
    iwt r0, #$FFFF
    sm (SC_TRIG), r0            ; past the LMS window, so the 16-bit form
    lms r11, (PB_LINK)
    GRET
+   GFCALL RoomLoad             ; RoomFind left the last room it tried loaded
    GFCALL SectorAt
    lms r11, (PB_LINK)
    GRET

; ===========================================================================
; StageProbes -- everything the host needs to decide where it may walk.
;
; Five probes: the camera's own sector, and the four around it. Each is a full
; room lookup, so a probe that crosses into the next room answers with that
; room's floor rather than with a wall -- which is what makes walking through
; a doorway work without any of TR's floor data.
;
; PB_X/PB_Y/PB_Z hold the camera on entry and the last neighbour on exit; the
; caller puts them back.
; ===========================================================================

StageProbes:
    sms (PB_LINK2), r11

    GFCALL Probe
    iwt r10, #GS_ROOM
    lms r0, (RF_BEST)
    from r0
    stw (r10)
    iwt r10, #GS_FLOOR
    lms r0, (SC_FLOOR)
    from r0
    stw (r10)
    iwt r10, #GS_CEIL
    lms r0, (SC_CEIL)
    from r0
    stw (r10)
    iwt r10, #GS_SX
    lms r0, (SC_SX)
    from r0
    stw (r10)
    iwt r10, #GS_SZ
    lms r0, (SC_SZ)
    from r0
    stw (r10)
    iwt r10, #GS_TRIG           ; and what standing here sets off
    lm r0, (SC_TRIG)
    from r0
    stw (r10)

    ; keep the camera; each probe wanders off it and comes back
    lms r0, (PB_X)
    sms (PB_CX), r0
    lms r0, (PB_Z)
    sms (PB_CZ), r0

    iwt r0, #(0 - PROBE_STEP)
    ibt r5, #0
    GFCALL ProbeOffset
    iwt r10, #GS_FXNEG
    lms r0, (SC_FLOOR)
    from r0
    stw (r10)

    iwt r0, #PROBE_STEP
    ibt r5, #0
    GFCALL ProbeOffset
    iwt r10, #GS_FXPOS
    lms r0, (SC_FLOOR)
    from r0
    stw (r10)

    ibt r0, #0
    iwt r5, #(0 - PROBE_STEP)
    GFCALL ProbeOffset
    iwt r10, #GS_FZNEG
    lms r0, (SC_FLOOR)
    from r0
    stw (r10)

    ibt r0, #0
    iwt r5, #PROBE_STEP
    GFCALL ProbeOffset
    iwt r10, #GS_FZPOS
    lms r0, (SC_FLOOR)
    from r0
    stw (r10)

    lms r11, (PB_LINK2)
    GRET

; ---------------------------------------------------------------------------
; ProbeOffset -- probe the camera's position plus (R0, 0, R5).
; ---------------------------------------------------------------------------

ProbeOffset:
    sms (PB_LINK3), r11
    lms r6, (PB_CX)
    with r6
    add r0
    sms (PB_X), r6
    lms r6, (PB_CZ)
    with r6
    add r5
    sms (PB_Z), r6
    GFCALL Probe
    lms r11, (PB_LINK3)
    GRET

; ===========================================================================
; PortalVisible -- can anything be seen through the portal at R14?
;
; R14 points just past the portal's room index; the normal and four corners
; follow. Out: R5 non-zero if the room on the far side is worth drawing.
;
; Two tests, in the order that rejects most cheaply. First the facing test, in
; room space, with no transform at all: TR portal normals point out of the room
; they belong to, so the portal is only a way *out* if the camera is on the
; inside of it. Then the four corners go through the matrix and their screen
; bounding box is tested against the frame -- which is what stops the walk
; fanning out through the whole level, since without it every room reachable
; by any chain of portals would be drawn.
;
; A portal that straddles the near plane is accepted without a box: part of it
; is behind the camera, its projection is meaningless, and guessing wrong there
; makes rooms vanish at doorways.
; ===========================================================================

PortalVisible:
    sms (P_LINK), r11

    ; --- normal, and the facing test --------------------------------------
    ; The normal's components are 0 or +/-1, so the dot product is a signed
    ; accumulate rather than three multiplies.
    ibt r0, #0
    sms (P_DOT), r0

    GFCALL RomWordAt            ; nx
    sms (T_X), r0
    GFCALL RomWordAt            ; ny
    sms (T_Y), r0
    GFCALL RomWordAt            ; nz
    sms (T_Z), r0
    sms (P_ROM), r14

    ; the first corner, as the point on the plane
    GFCALL RomWordAt
    sms (T_CX), r0              ; borrowed as scratch: corner x
    GFCALL RomWordAt
    sms (T_CY), r0
    GFCALL RomWordAt
    sms (T_CZ), r0

    lms r0, (T_X)
    lms r5, (T_CX)
    lms r6, (R_CAMX)
    with r5
    sub r6                      ; dx = corner.x - camera.x
    GFCALL PortalAxis

    lms r0, (T_Y)
    lms r5, (T_CY)
    lms r6, (R_CAMY)
    with r5
    sub r6
    GFCALL PortalAxis

    lms r0, (T_Z)
    lms r5, (T_CZ)
    lms r6, (R_CAMZ)
    with r5
    sub r6
    GFCALL PortalAxis

    ; dot >= 0 means the camera is on the outside; not a way through
    lms r0, (P_DOT)
    ibt r5, #0
    to r6
    sub r5
    bmi PV_Box
    nop
    ibt r5, #0
    lms r11, (P_LINK)
    GRET

PV_Box:
    ; --- the four corners, and their screen box ---------------------------
    lms r6, (R_ROMB)
    from r6
    romb
    lms r14, (P_ROM)

    ibt r0, #0
    sms (P_FRONT), r0
    ibt r0, #4
    sms (P_I), r0
    iwt r0, #PORT_MIN
    sms (P_MINX), r0
    sms (P_MINY), r0
    iwt r0, #PORT_MAX
    sms (P_MAXX), r0
    sms (P_MAXY), r0

PV_Corner:
    GFCALL RomWordAt
    sms (T_X), r0
    GFCALL RomWordAt
    sms (T_Y), r0
    GFCALL RomWordAt
    sms (T_Z), r0
    sms (P_ROM), r14

    GFCALL TransformPoint
    GFCALL ProjectPoint

    lms r0, (T_REJECT)
    ibt r5, #0
    from r0
    cmp r5
    bne PV_NextCorner           ; behind the near plane; it has no screen box
    nop

    lms r0, (P_FRONT)
    inc r0
    sms (P_FRONT), r0

    lms r5, (T_SX)
    GFCALL PortalClamp
    sms (T_SX), r5
    lms r5, (T_SY)
    GFCALL PortalClamp
    sms (T_SY), r5

    lms r5, (T_SX)
    lms r0, (P_MINX)
    from r5
    to r6
    sub r0
    bpl +
    nop
    sms (P_MINX), r5
+   lms r5, (T_SX)
    lms r0, (P_MAXX)
    from r5
    to r6
    sub r0
    bmi +
    nop
    sms (P_MAXX), r5
+
    lms r5, (T_SY)
    lms r0, (P_MINY)
    from r5
    to r6
    sub r0
    bpl +
    nop
    sms (P_MINY), r5
+   lms r5, (T_SY)
    lms r0, (P_MAXY)
    from r5
    to r6
    sub r0
    bmi +
    nop
    sms (P_MAXY), r5
+
PV_NextCorner:
    lms r6, (R_ROMB)
    from r6
    romb
    lms r14, (P_ROM)
    lms r0, (P_I)
    dec r0
    sms (P_I), r0
    beq +
    nop
    GFJMP PV_Corner
+
    ; nothing in front of the camera at all
    lms r0, (P_FRONT)
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    ibt r5, #0
    lms r11, (P_LINK)
    GRET

+   ; part of it behind the near plane: the box would be a lie, so the far
    ; room inherits the rectangle this one was seen through
    lms r0, (P_FRONT)
    ibt r5, #4
    from r0
    cmp r5
    beq PV_Clip
    nop
    lms r0, (RC_X0)
    sms (P_MINX), r0
    lms r0, (RC_X1)
    sms (P_MAXX), r0
    lms r0, (RC_Y0)
    sms (P_MINY), r0
    lms r0, (RC_Y1)
    sms (P_MAXY), r0
    ibt r5, #1
    lms r11, (P_LINK)
    GRET

PV_Clip:
    ; Does the portal's box meet the rectangle this room was seen through? If
    ; not, whatever is beyond it cannot be on screen, and the walk stops here.
    ibt r5, #1                  ; assume visible, then look for a reason not
    lms r0, (P_MAXX)
    lms r6, (RC_X0)
    to r6
    sub r6
    bpl +
    nop
    ibt r5, #0                  ; entirely left of the rectangle
+   lms r0, (P_MINX)
    lms r6, (RC_X1)
    to r6
    sub r6
    bmi +
    nop
    ibt r5, #0                  ; entirely right of it
+   lms r0, (P_MAXY)
    lms r6, (RC_Y0)
    to r6
    sub r6
    bpl +
    nop
    ibt r5, #0
+   lms r0, (P_MINY)
    lms r6, (RC_Y1)
    to r6
    sub r6
    bmi +
    nop
    ibt r5, #0
+   lms r11, (P_LINK)
    GRET

; ---------------------------------------------------------------------------
; PortalClamp -- R5 into +/-PORT_CLAMP, so the box arithmetic cannot overflow.
; ---------------------------------------------------------------------------

PortalClamp:
    iwt r0, #PORT_CLAMP
    from r5
    to r6
    sub r0
    bmi +
    nop
    iwt r5, #PORT_CLAMP
+   iwt r0, #(0 - PORT_CLAMP)
    from r5
    to r6
    sub r0
    bpl +
    nop
    iwt r5, #(0 - PORT_CLAMP)
+   GRET

; ---------------------------------------------------------------------------
; PortalAxis -- accumulate one axis of dot(normal, delta) into P_DOT.
;
; In: R0 = the normal's component, R5 = the delta. TR's portal normals are
; axis aligned unit vectors, so a component is 0 or +/-1 and the product is
; the delta, its negation, or nothing.
; ---------------------------------------------------------------------------

PortalAxis:
    ibt r6, #0
    from r0
    cmp r6
    beq PA_Done
    nop
    ibt r6, #0
    to r6
    sub r6
    bmi PA_Neg
    nop
    lms r0, (P_DOT)
    with r0
    add r5
    sms (P_DOT), r0
    GRET

PA_Neg:
    lms r0, (P_DOT)
    with r0
    sub r5
    sms (P_DOT), r0
PA_Done:
    GRET

; ---------------------------------------------------------------------------
; RoomClip -- load the clip rectangle room RL_J was seen through.
; ---------------------------------------------------------------------------

RoomClip:
    lms r0, (RL_J)
    to r10
    add r0
    with r10
    add r10
    with r10
    add r10                     ; index * 8
    iwt r5, #RL_RECT
    with r10
    add r5

    ibt r5, #0                  ; accumulate zero only for the full frame

    to r0
    ldw (r10)
    sms (V_CLIPX0), r0
    move r7, r0
    with r5
    or r7
    inc r10
    inc r10
    to r0
    ldw (r10)
    sms (V_CLIPX1), r0
    iwt r6, #FRAME_WIDTH
    from r0
    to r7
    sub r6
    with r5
    or r7
    inc r10
    inc r10
    to r0
    ldw (r10)
    sms (V_CLIPY0), r0
    move r7, r0
    with r5
    or r7
    inc r10
    inc r10
    to r0
    ldw (r10)
    sms (V_CLIPY1), r0
    iwt r6, #FRAME_HEIGHT
    from r0
    to r7
    sub r6
    with r5
    or r7
    sms (R_NOTFULL), r5
    GRET

; ===========================================================================
; The matrix stack.
;
; Static meshes did not need one -- a Y rotation composes with the camera's
; into a single Y rotation, which is two subtractions. Models will: a node
; hierarchy translates to a pivot, rotates about all three axes and recurses,
; and there is no folding that into one angle.
;
; "The matrix" is the twelve words at M_00, which is what TransformMesh reads,
; so a push is a copy out and a pop is a copy back and nothing downstream
; changes. Elements are 1.15, so FMULT returns a product halved and every sum
; of two products is doubled once at the end rather than twice on the way.
; ===========================================================================

MatrixPush:
    ; Bounds, because a model stream decides how deep this goes and nothing
    ; upstream of here checks. Overflowing writes past MX_STACK into whatever
    ; game pak RAM comes next; dropping the push instead costs one wrong
    ; limb. TR's deepest model uses four of the eight.
    lms r0, (MX_SP)
    ibt r5, #MX_MAX
    from r0
    cmp r5
    GBLT +
    nop
    GRET
+   lms r0, (MX_SP)
    to r10
    add r0                      ; * 2
    with r10
    add r10                     ; * 4
    with r10
    add r10                     ; * 8
    with r10
    add r10                     ; * 16, and MX_WORDS*2 is 24 -- so 16 + 8
    lms r0, (MX_SP)
    to r5
    add r0
    with r5
    add r5
    with r5
    add r5                      ; * 8
    with r10
    add r5                      ; * 24
    iwt r0, #MX_STACK
    with r10
    add r0

    iwt r8, #M_00_BYTE
    ibt r12, #MX_WORDS
    iwt r13, #MP_Loop
MP_Loop:
    to r5
    ldw (r8)
    from r5
    stw (r10)
    inc r8
    inc r8
    inc r10
    inc r10
    loop
    nop

    lms r0, (MX_SP)
    inc r0
    sms (MX_SP), r0
    GRET

MatrixPop:
    lms r0, (MX_SP)
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    GRET
+   lms r0, (MX_SP)
    dec r0
    sms (MX_SP), r0

    to r10
    add r0
    with r10
    add r10
    with r10
    add r10
    with r10
    add r10
    lms r0, (MX_SP)
    to r5
    add r0
    with r5
    add r5
    with r5
    add r5
    with r10
    add r5
    iwt r0, #MX_STACK
    with r10
    add r0

    iwt r8, #M_00_BYTE
    ibt r12, #MX_WORDS
    iwt r13, #MQ_Loop
MQ_Loop:
    to r5
    ldw (r10)
    from r5
    stw (r8)
    inc r8
    inc r8
    inc r10
    inc r10
    loop
    nop
    GRET

; ---------------------------------------------------------------------------
; MatrixSinCos -- MX_SIN and MX_COS for the angle in R0, out of the model
; sine table. Same table MatrixCamera uses: 256 entries, 1.15.
; ---------------------------------------------------------------------------

MatrixSinCos:
    sms (MX_LINK2), r11
    sms (T_ANGLE), r0

    ibt r6, #GSU_BANK
    from r6
    romb

    iwt r6, #ModelData
    to r14
    add r0
    with r14
    add r6
    GFCALL RomWordAt
    sms (MX_SIN), r0

    lms r0, (T_ANGLE)
    ibt r6, #64
    with r0
    add r6
    iwt r6, #$00FF
    with r0
    and r6
    iwt r6, #ModelData
    to r14
    add r0
    with r14
    add r6
    GFCALL RomWordAt
    sms (MX_COS), r0

    lms r11, (MX_LINK2)
    GRET

; ---------------------------------------------------------------------------
; MatrixRotate{X,Y,Z} -- M = M * R(R0).
;
; All three are the same operation on a different pair of columns -- upstream's
; X_ROTXY, which is worth keeping as one routine rather than three copies of
; it, since code size is the currency here:
;
;   a' = a*cos - b*sin      b' = a*sin + b*cos
;
; and the column pairs are upstream's too, signs and order included:
;
;   matrixRotateX   X_ROTXY(e02, e01)   so a = column 2, b = column 1
;   matrixRotateY   X_ROTXY(e00, e02)        a = column 0, b = column 2
;   matrixRotateZ   X_ROTXY(e01, e00)        a = column 1, b = column 0
;
; MX_CA and MX_CB are byte offsets within a row; the rows are eight bytes
; apart because each carries its own translate. The entry points stash the
; angle first -- setting the offsets costs R0, which is where it arrives.
; ---------------------------------------------------------------------------

MatrixRotateX:
    sms (MX_ANG), r0
    ibt r0, #4
    sms (MX_CA), r0
    ibt r0, #2
    sms (MX_CB), r0
    GFJMP MatrixRotate

MatrixRotateY:
    sms (MX_ANG), r0
    ibt r0, #0
    sms (MX_CA), r0
    ibt r0, #4
    sms (MX_CB), r0
    GFJMP MatrixRotate

MatrixRotateZ:
    sms (MX_ANG), r0
    ibt r0, #2
    sms (MX_CA), r0
    ibt r0, #0
    sms (MX_CB), r0
    GFJMP MatrixRotate

; Tail-jumped to, so R11 is still the original caller's.
MatrixRotate:
    sms (MX_LINK), r11
    ; MR_Row and MTR_Row are the next 300 bytes and run three times per
    ; rotate or translate, several of those per mesh, out of every window:
    ; 160 K cycles a frame of fetch for 230 bytes of code. This anchors
    ; one on them; TransformMesh moves it on before anything else runs hot.
    cache
    lms r0, (MX_ANG)
    GFCALL MatrixSinCos

    iwt r0, #M_00_BYTE
    sms (MX_ROW), r0
    ibt r0, #3
    sms (MX_I), r0

MR_Row:
.IFDEF FX3
    ; Keep both source elements until all four FMULTs have consumed them.
    ; Their high-word truncation still happens separately, before the sum
    ; and doubling: fusing the products would change the rendered pose.
    lms r0, (MX_CA)
    lms r10, (MX_ROW)
    with r10
    add r0
    to r7
    ldw (r10)                   ; a
    lms r0, (MX_CB)
    lms r10, (MX_ROW)
    with r10
    add r0
    to r8
    ldw (r10)                   ; b, and leave R10 at its output address

    lms r6, (MX_COS)
    from r7
    to r5
    fmult                      ; a*cos
    from r8
    to r0
    fmult                      ; b*cos
    lms r6, (MX_SIN)
    with r7
    fmult                      ; a*sin: the old a is no longer needed
    with r8
    fmult                      ; b*sin: likewise b

    with r0
    add r7
    with r0
    add r0
    stw (r10)                  ; b' = 2 * (a*sin + b*cos)
    with r5
    sub r8
    with r5
    add r5
    lms r0, (MX_CA)
    lms r10, (MX_ROW)
    with r10
    add r0
    from r5
    stw (r10)                  ; a' = 2 * (a*cos - b*sin)
.ELSE
    lms r0, (MX_CA)
    lms r10, (MX_ROW)
    with r10
    add r0
    to r5
    ldw (r10)                   ; a
    sms (MX_A), r5
    lms r0, (MX_CB)
    lms r10, (MX_ROW)
    with r10
    add r0
    to r5
    ldw (r10)                   ; b
    sms (MX_B), r5

    ; a' = 2 * (a*cos - b*sin)
    lms r6, (MX_COS)
    lms r7, (MX_A)
    from r7
    to r5
    fmult
    lms r6, (MX_SIN)
    lms r7, (MX_B)
    from r7
    to r8
    fmult
    with r5
    sub r8
    with r5
    add r5
    lms r0, (MX_CA)
    lms r10, (MX_ROW)
    with r10
    add r0
    from r5
    stw (r10)

    ; b' = 2 * (a*sin + b*cos)
    lms r6, (MX_SIN)
    lms r7, (MX_A)
    from r7
    to r5
    fmult
    lms r6, (MX_COS)
    lms r7, (MX_B)
    from r7
    to r8
    fmult
    with r5
    add r8
    with r5
    add r5
    lms r0, (MX_CB)
    lms r10, (MX_ROW)
    with r10
    add r0
    from r5
    stw (r10)

.ENDIF
    ibt r0, #8                  ; next row
    lms r5, (MX_ROW)
    with r5
    add r0
    sms (MX_ROW), r5

    lms r0, (MX_I)
    dec r0
    sms (MX_I), r0
    beq +
    nop
    GFJMP MR_Row
+   lms r11, (MX_LINK)
    GRET
.IFDEF FX3
    .DSB 35, $01                ; retain the later routines' cache alignment
.ENDIF

; ---------------------------------------------------------------------------
; MatrixTranslateRel -- move the origin by (MX_X, MX_Y, MX_Z) in the frame the
; matrix already describes: T += M * v.
; ---------------------------------------------------------------------------

MatrixTranslateRel:
    sms (MX_LINK), r11

    iwt r0, #M_00_BYTE
    sms (MX_ROW), r0
    ibt r0, #3
    sms (MX_I), r0

MTR_Row:
    lms r10, (MX_ROW)
    to r6
    ldw (r10)
    lms r7, (MX_X)
    from r7
    to r5
    fmult

    ibt r0, #2
    lms r10, (MX_ROW)
    with r10
    add r0
    to r6
    ldw (r10)
    lms r7, (MX_Y)
    from r7
    to r8
    fmult
    with r5
    add r8

    ibt r0, #4
    lms r10, (MX_ROW)
    with r10
    add r0
    to r6
    ldw (r10)
    lms r7, (MX_Z)
    from r7
    to r8
    fmult
    with r5
    add r8

    with r5
    add r5                      ; undo the 1.15 halving, once

    ibt r0, #6                  ; the row's translate
    lms r10, (MX_ROW)
    with r10
    add r0
    to r8
    ldw (r10)
    with r5
    add r8
    from r5
    stw (r10)

    ibt r0, #8
    lms r5, (MX_ROW)
    with r5
    add r0
    sms (MX_ROW), r5

    lms r0, (MX_I)
    dec r0
    sms (MX_I), r0
    beq +
    nop
    GFJMP MTR_Row
+   lms r11, (MX_LINK)
    GRET

; ===========================================================================
; DrawRoomMeshes -- the scenery standing in the room RoomLoad last read.
;
; A static mesh is placed with a position and a Y rotation, and the camera
; matrix is a Y rotation too -- so the two compose into a *single* Y rotation
; and there is no matrix stack here yet. The instance matrix is exactly what
; MatrixCamera builds for a camera at (roomCamera - instancePosition) turned
; by (yaw - instanceAngle), which is two subtractions rather than a matrix
; multiply.
;
; They are drawn after the room's own geometry, so they paint over its walls.
; That is right for scenery standing in a room and wrong in general: one
; ordering table across both would be the honest fix.
; ===========================================================================

DrawRoomMeshes:
    sms (MI_LINK), r11

    lms r0, (R_ICOUNT)
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    lms r11, (MI_LINK)
    GRET
+   sms (MI_I), r0

    lms r0, (R_IADDR)
    sms (MI_ROM), r0

    ; and the room's bank. Drawing an instance points R_ROMB at the mesh, so
    ; reading the next placement out of R_ROMB would read it from whichever
    ; bank the last mesh happened to live in -- which is where the room table
    ; is, and a vertex count of 38 followed by one of 0.
    lms r0, (R_ROMB)
    sms (MI_ROMB), r0

DRM_Inst:
    lms r6, (MI_ROMB)
    from r6
    romb
    lms r14, (MI_ROM)

    GFCALL RomWordAt
    sms (MI_ADDR), r0
    GFCALL RomByteAt
    sms (MI_BANK), r0
    GFCALL RomByteAt
    sms (MI_ANG), r0
    GFCALL RomWordAt
    sms (MI_X), r0
    GFCALL RomWordAt
    sms (MI_Y), r0
    GFCALL RomWordAt
    sms (MI_Z), r0
    GFCALL RomByteAt            ; g, the placement's shade, unread here
    GFCALL RomByteAt            ; the mesh's bounding radius, in units of 32
    ibt r6, #32
    to r5
    umult r6
    sms (S_R), r5

    ; step the cursor whatever happens to this one
    ibt r0, #INST_SIZE
    lms r5, (MI_ROM)
    with r5
    add r0
    sms (MI_ROM), r5

    iwt r0, #INST_NONE
    lms r5, (MI_BANK)
    from r5
    cmp r0
    bne +
    nop
    GFJMP DRM_Next              ; the mesh had nothing drawable
+
    ; its bounding sphere against the clip rectangle, as an item's
    lms r0, (MI_X)
    sms (T_X), r0
    lms r0, (MI_Y)
    sms (T_Y), r0
    lms r0, (MI_Z)
    sms (T_Z), r0
    GFCALL SphereVisible
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    GFJMP DRM_Next              ; nothing of it can reach the screen
+
    ; Place it: translate to where it stands, then turn it. The room's matrix
    ; is on the stack meanwhile, and comes back for the next one.
    ;
    ; This could be the composition trick instead -- a Y rotation folds into
    ; the camera's, and that is two subtractions against thirty instructions --
    ; but models cannot fold, and one way of placing a mesh that the regression
    ; test exercises every run is worth more than the instructions.
    GFCALL MatrixPush

    lms r0, (MI_X)
    sms (MX_X), r0
    lms r0, (MI_Y)
    sms (MX_Y), r0
    lms r0, (MI_Z)
    sms (MX_Z), r0
    GFCALL MatrixTranslateRel

    lms r0, (MI_ANG)
.IFDEF FX3
    GFCALL InstTurn             ; or face the camera: a room sprite (8 bytes)
.ELSE
    GFCALL MatrixRotateY
.ENDIF

    ; point the geometry pipeline at the mesh and run it unchanged
    lms r0, (MI_ADDR)
    sms (R_ADDR), r0
    ibt r6, #LEVEL_BANK_BASE
    lms r0, (MI_BANK)
    with r0
    add r6
    sms (R_ROMB), r0

    GFCALL TransformRoom
    GFCALL DrawMesh
    GFCALL MatrixPop

DRM_Next:
    lms r0, (MI_I)
    dec r0
    sms (MI_I), r0
    beq +
    nop
    GFJMP DRM_Inst

    ; and put the room's bank back, because R_ROMB means "the room" to whoever
    ; runs next and has meant "the last mesh drawn" ever since the first
    ; instance. Leaving it wrong cost the entities their first evening: they
    ; read their placements out of a static mesh's bank and found geometry.
+   lms r0, (MI_ROMB)
    sms (R_ROMB), r0
    lms r11, (MI_LINK)
    GRET

; ===========================================================================
; StageItemList -- copy the packer's host table into game pak RAM.
;
; The only thing the host is told about the level, and the only reason the
; GSU is involved at all: game pak ROM is unreadable from the other side of
; this bus, so a table meant for the host has to be carried across by
; whatever can read it. Nothing is interpreted here. The packer decided the
; shape; this moves bytes.
;
; The first two words say how many entities and how many models, which is
; what says how much to move. A byte at a time, because the source is the
; ROM buffer and the destination is game pak RAM, and neither is wider.
; ===========================================================================

.DEFINE SI_LINK     $124
.DEFINE SI_ROM      $126
.DEFINE SI_RAM      $128
.DEFINE SI_LEFT     $12A

StageItemList:
    sms (SI_LINK), r11

    lm r0, (GS_LEVEL_READY)
    ibt r5, #1
    from r0
    cmp r5
    bne SIL_Stage
    nop
    lms r11, (SI_LINK)
    GRET

SIL_Stage:

    ibt r6, #LEVEL_BANK_BASE
    from r6
    romb

    ibt r14, #2                 ; where the packer left the table's address
    GFCALL RomWordAt
    move r14, r0                ; not from/to and a nop -- the nop would eat
    sms (SI_ROM), r14           ; the prefixes and leave R14 where it was

    GFCALL RomWordAt            ; and how long it is, so nothing is computed
    sms (SI_LEFT), r0

    ; Everything below runs out of registers, because RAMBR banks *every*
    ; game pak RAM access -- LMS and SMS included. Switching to bank 1 for
    ; the destination sends the loop's own scratch there too, where it reads
    ; back as zero, and the copy decides it has nothing to do.
    lms r14, (SI_ROM)
    lms r12, (SI_LEFT)
    ; LOOP decrements before it tests, so a zero length is 65,536 passes.
    ibt r0, #0
    from r12
    cmp r0
    beq SIL_Done
    nop
    iwt r10, #GS_ITEMS

    ibt r6, #GS_ITEMS_BANK
    from r6
    ramb

    iwt r13, #SIL_Copy
SIL_Copy:
    to r5
    getb                        ; from the ROM buffer at R14
    inc r14
    from r5
    stb (r10)
    inc r10
    loop
    nop

SIL_Done:
    ibt r6, #0                  ; back to the bank everything else uses
    from r6
    ramb
    ibt r0, #1                  ; publish only after the final byte arrived
    sm (GS_LEVEL_READY), r0
    lms r11, (SI_LINK)
    GRET

; ===========================================================================
; EntBuild -- the slot table DrawRoomItems draws from, once per level.
;
; Every room's placement list, walked once: slot -> model stream address and
; bank (INST_NONE for a type with nothing to draw), and one past the highest
; slot. The host clears ENT_READY at boot; this sets it.
; ===========================================================================

EntBuild:
    sm (EB_LINK), r11

    iwt r10, #ENT_TABLE         ; no model anywhere until a placement says so
    iwt r12, #GS_ITEM_MAX
    iwt r0, #INST_NONE
    iwt r13, #EB_Clear
EB_Clear:
    inc r10
    inc r10
    stw (r10)
    inc r10
    inc r10
    loop
    nop
    ibt r0, #0
    sm (ENT_COUNT), r0

    ibt r6, #LEVEL_BANK_BASE
    from r6
    romb
    ibt r14, #0
    to r7                       ; the level's room count; ROM reads are
    getb                        ; inline here, a call apiece doubled it
    inc r14
    with r7
    getbh
    iwt r8, #ROOM_TABLE

EB_Room:
    ibt r0, #0
    from r7
    cmp r0
    bne +
    nop
    iwt r15, #EB_Done
    nop
+   dec r7
    ibt r6, #LEVEL_BANK_BASE
    from r6
    romb
    ibt r0, #4                  ; entry: the room's bank at 4
    to r14
    add r8
    to r3
    getb
    ibt r0, #21                 ; itemCount at 21, itemAddr at 22
    to r14
    add r8
    to r9
    getb
    inc r14
    to r1
    getb
    inc r14
    with r1
    getbh
    ibt r0, #32
    with r8
    add r0
    ibt r6, #LEVEL_BANK_BASE    ; the placements are in the room's bank
    from r3
    to r0
    add r6
    romb
    move r14, r1

EB_Item:
    ibt r0, #0
    from r9
    cmp r0
    beq EB_Room
    nop
    dec r9
    to r1                       ; model address
    getb
    inc r14
    with r1
    getbh
    inc r14
    to r2                       ; its bank
    getb
    inc r14
    to r4                       ; the host's slot
    getb
    ibt r0, #(ITEM_SIZE - 3)
    with r14
    add r0

    from r4
    to r0
    add r4
    add r0
    iwt r6, #ENT_TABLE
    to r10
    add r6
    from r1
    stw (r10)
    inc r10
    inc r10
    from r2
    stw (r10)

    inc r4                      ; ENT_COUNT = max(slot + 1)
    lm r0, (ENT_COUNT)
    from r0
    cmp r4
    bcs EB_Item
    nop
    sm (ENT_COUNT), r4
    bra EB_Item
    nop

EB_Done:
    ibt r0, #1
    sm (ENT_READY), r0
    lm r11, (EB_LINK)
    GRET

; ===========================================================================
; DrawRoomItems -- the entities standing in the room RoomLoad last read.
;
; Same shape as DrawRoomMeshes, but what a placement points at is a model
; stream rather than a single mesh, so the work is handed to DrawModel.
; ===========================================================================

DrawRoomItems:
    sms (IT_LINK), r11
    lms r0, (R_ROMB)            ; drawing a model points R_ROMB at its meshes
    sms (IT_ROMB), r0

    ; Every slot the host says is in this room, whichever room's placement
    ; list the packer wrote it into: a creature that walks out of the room
    ; it started in is drawn where it is (upstream's updateRoom relink). The
    ; scan is a cached loop over the room bytes; it leaves only to draw.
    lm r12, (ENT_COUNT)
    iwt r10, #(GS_ITEM + 10)

DRI_Resume:                     ; R12 slots left, R10 at the next room byte
    ibt r0, #0
    from r12
    cmp r0
    bne +
    nop
    GFJMP DRI_Exit
+   lm r5, (R_INDEX)
    ibt r6, #GS_ITEM_SIZE
    iwt r13, #DRI_Scan
    cache
DRI_Scan:
    to r0
    ldb (r10)
    from r0
    cmp r5
    beq DRI_Found
    nop
    with r10
    add r6
    loop
    nop
    GFJMP DRI_Exit

DRI_Found:
    sms (IT_I), r12             ; slots left, this one included
    lm r0, (ENT_COUNT)
    with r0
    sub r12
    sms (IT_NODES), r0          ; so this is slot ENT_COUNT - R12
    ibt r0, #-10
    to r0
    add r10
    sm (IT_SLOT), r0            ; past the LMS window

    lms r0, (IT_NODES)          ; its model, from the slot table
    add r0
    add r0
    iwt r6, #ENT_TABLE
    to r10
    add r6
    to r0
    ldw (r10)
    sms (IT_ADDR), r0
    inc r10
    inc r10
    to r0
    ldw (r10)
    sms (IT_BANK), r0
    lm r10, (IT_SLOT)

    to r0
    ldw (r10)
    sms (MD_PHASE), r0

    ; An animation of $FF means the host wants this one left off the screen.
    ; Lara is the first of those: she is at the camera, so every instruction
    ; spent on her is spent putting nothing there. Checked before the matrix
    ; work rather than after, so a hidden entity costs a compare.
    iwt r6, #$00FF
    to r5
    and r6
    from r5
    cmp r6
    bne +
    nop
    GFJMP DRI_Next
+
    lm r10, (IT_SLOT)
    ibt r0, #2
    with r10
    add r0
    to r5
    ldw (r10)
    lms r0, (R_X)
    with r5
    sub r0
    sms (IT_X), r5

    lm r10, (IT_SLOT)
    ibt r0, #4
    with r10
    add r0
    to r5
    ldw (r10)
    lms r0, (R_Y)
    with r5
    sub r0
    sms (IT_Y), r5

    lm r10, (IT_SLOT)
    ibt r0, #6
    with r10
    add r0
    to r5
    ldw (r10)
    lms r0, (R_Z)
    with r5
    sub r0
    sms (IT_Z), r5

    lm r10, (IT_SLOT)
    ibt r0, #8
    with r10
    add r0
    to r5
    ldw (r10)                   ; the angle, of which the sine table takes
    with r5                     ; the top byte
    hib
    sms (IT_ANG), r5

    iwt r0, #INST_NONE
    lms r5, (IT_BANK)
    from r5
    cmp r0
    bne +
    nop
    GFJMP DRI_Next              ; the type has no model at all
+
    ; Its bounding sphere against the clip rectangle before anything is
    ; built for it. The radius is the model header's second byte, in units
    ; of 32; the bank switch is undone at the top of the next item.
    ibt r6, #LEVEL_BANK_BASE
    lms r0, (IT_BANK)
    with r0
    add r6
    from r0
    romb
    lms r14, (IT_ADDR)
    inc r14
    to r5
    getb
    ibt r6, #32
    with r5
    umult r6
    sms (S_R), r5
    lms r0, (IT_X)
    sms (T_X), r0
    lms r0, (IT_Y)
    sms (T_Y), r0
    lms r0, (IT_Z)
    sms (T_Z), r0
    GFCALL SphereVisible
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    GFJMP DRI_Next              ; nothing of it can reach the screen
+
    ; If the accepted model's own origin is comfortably inside a full-frame
    ; view, all of its visible-node tests would take the fast keep path. Mark
    ; that once here instead of repeating the same projection-free decision
    ; for every joint. A false keep only costs work; face flags still clip.
    ibt r0, #1
    sms (MD_CULL), r0
    lms r5, (R_NOTFULL)
    with r5
    from r5
    bne DRI_CullReady
    nop
    lms r8, (T_CZ)
    iwt r0, #ZMIN
    from r8
    to r6
    sub r0
    bmi DRI_CullReady
    nop
    lms r5, (T_CX)
    ibt r0, #0
    from r5
    to r6
    sub r0
    bpl +
    nop
    from r0
    to r6
    sub r5
+   from r6
    cmp r8
    bcs DRI_CullReady
    nop
    ibt r0, #0
    sms (MD_CULL), r0

DRI_CullReady:
    GFCALL MatrixPush

    lms r0, (IT_X)
    sms (MX_X), r0
    lms r0, (IT_Y)
    sms (MX_Y), r0
    lms r0, (IT_Z)
    sms (MX_Z), r0
    GFCALL MatrixTranslateRel

    lms r0, (IT_ANG)
    GFCALL MatrixRotateY

.IFDEF FX3
    ; Its shadow, then (hers) X by her pitch and Z by her lean, as
    ; upstream's matrixRotateYXZ: ItemTilt, at the end.
    GFCALL ItemTilt
    bra +
    nop
    .DSB 21, $01                ; to 32 bytes: DrawModel and all that follows
+                               ; keep their tuned cache alignment
.ELSE
    ; Then X by its pitch, as upstream's matrixRotateYXZ: GS_ITEM byte 11
    ; is the top byte of angle.x (hers, swimming; nobody else's has one).
    lm r10, (IT_SLOT)
    ibt r0, #11
    with r10
    add r0
    to r0
    ldb (r10)
    ibt r5, #0
    from r0
    cmp r5
    beq +
    nop
    GFCALL MatrixRotateX
    .DSB 5, $01                 ; to 32 bytes: DrawModel and all that follows
+                               ; keep their tuned cache alignment
.ENDIF
    lms r0, (IT_ADDR)
    sms (MD_ROM), r0
    ibt r6, #LEVEL_BANK_BASE
    lms r0, (IT_BANK)
    with r0
    add r6
    sms (MD_ROMB), r0
    GFCALL DrawModel
    GFCALL MatrixPop

DRI_Next:
    lm r10, (IT_SLOT)           ; on to the next slot's room byte
    ibt r0, #(GS_ITEM_SIZE + 10)
    with r10
    add r0
    lms r12, (IT_I)
    dec r12
    GFJMP DRI_Resume
DRI_Exit:
    lms r0, (IT_ROMB)           ; same courtesy to whoever runs next
    sms (R_ROMB), r0
    lms r11, (IT_LINK)
    GRET

; ===========================================================================
; DrawModel -- walk a model's node stream, drawing each mesh where its chain
; of transforms puts it.
;
; In: MD_ROM and MD_ROMB address the stream, MD_I is how many records it has.
;
; This is upstream's drawNodes with the three tables already merged: pop and
; push come from the record's flags, the translate and the rotation are the
; record's own, and the rotation order is Y, X, Z -- matrixFrame's, which is
; a translate in the parent's frame followed by matrixRotateYXZ.
;
; A record whose bank is INST_NONE still moves the matrix. That matters: the
; node is a joint whether or not the mesh hanging off it survived packing,
; and skipping the transform would fold every limb below it into its parent.
; ===========================================================================

DrawModel:
    sms (MD_LINK), r11

    ; --- the header --------------------------------------------------------
    lms r0, (MD_ROM)
    sm (MD_BASE), r0            ; where the animation table will be found

    lms r6, (MD_ROMB)
    from r6
    romb
    lms r14, (MD_ROM)

    GFCALL RomByteAt
    sms (MD_I), r0              ; nodeCount
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    lms r11, (MD_LINK)
    GRET
+
    ; Only Lara reads the weapon channel. Save the object rotation before
    ; the body's root/torso pose changes it, as drawLaraNodes does upstream.
    GFCALL WeaponModelBegin
    lms r6, (MD_ROMB)
    from r6
    romb
    lms r14, (MD_ROM)
    inc r14                    ; resume at the header's second byte
    GFCALL RomByteAt            ; pad
    GFCALL RomWordAt
    sm (MD_FSTRIDE), r0
    GFCALL RomWordAt
    sm (MD_ANIMN), r0
    GFCALL RomWordAt
    sm (MD_ATAB), r0

    sms (MD_ROM), r14           ; R14 now sits on the first node record

    ; --- which animation, and which frame of it ----------------------------
    ;
    ; Both come from the host, in one word: the animation in the low byte and
    ; the frame in the high one. Both are clamped rather than trusted -- an
    ; index out of range would read a mesh address out of unrelated bytes, and
    ; the cost of not finding out is a hang.
    lms r0, (MD_PHASE)
    iwt r6, #$00FF
    to r5
    and r6
    lm r6, (MD_ANIMN)
    from r5
    cmp r6
    GBLT +
    nop
    ibt r5, #0
+
    with r5
    add r5                      ; * 2
    with r5
    add r5                      ; * 4, the animation table's stride
    lm r0, (MD_ATAB)
    with r5
    add r0
    lm r0, (MD_BASE)
    from r5
    to r14
    add r0

    GFCALL RomWordAt            ; the animation's frames, within its bank
    sm (MD_FBASE), r0
    GFCALL RomByteAt            ; the bank it landed in, or the sentinel
    iwt r6, #INST_NONE
    from r0
    cmp r6
    bne +
    nop
    lms r11, (MD_LINK)          ; an animation with no frames
    GRET
+   ibt r6, #LEVEL_BANK_BASE
    to r6
    add r6
    sm (MD_FBANK), r6
    GFCALL RomByteAt            ; how many frames it has
    move r6, r0
    lms r0, (MD_PHASE)
    to r5
    hib                         ; the frame, out of the high byte
    from r5
    cmp r6
    GBLT +
    nop
    ibt r5, #0
+
    lm r6, (MD_FSTRIDE)
    with r5
    umult r6
    lm r0, (MD_FBASE)
    with r5
    add r0
    sms (MD_FRM), r5

    ; The root's translate is the frame's, and it is the only one that is.
    lm r6, (MD_FBANK)
    from r6
    romb
    lms r14, (MD_FRM)
    GFCALL RomWordAt
    sms (MD_FX), r0
    GFCALL RomWordAt
    sms (MD_FY), r0
    GFCALL RomWordAt
    sms (MD_FZ), r0
    sms (MD_FRM), r14

DMD_Node:
    lms r6, (MD_ROMB)
    from r6
    romb

    lms r14, (MD_ROM)
    GFCALL RomWordAt
    sms (MD_ADDR), r0
    GFCALL RomByteAt
    sms (MD_BANK), r0
    GFCALL RomWordAt            ; flags in the low byte, radius in the high
    sms (MD_FLAGS), r0
    GFCALL RomWordAt
    sms (MD_X), r0
    GFCALL RomWordAt
    sms (MD_Y), r0
    GFCALL RomWordAt
    sms (MD_Z), r0
    sms (MD_ROM), r14

    lm r6, (MD_FBANK)
    from r6
    romb
    lms r14, (MD_FRM)
    GFCALL RomByteAt
    sms (MD_AX), r0
    GFCALL RomByteAt
    sms (MD_AY), r0
    GFCALL RomByteAt
    sms (MD_AZ), r0
    sms (MD_FRM), r14

.IFDEF FX3
    GFCALL WeaponNodeFx3        ; all four guns: the same 8 bytes
.ELSE
    GFCALL WeaponModelNode
.ENDIF

    ; pop before push, as upstream has it: a node can do both, and that means
    ; "back to the parent, then branch again from there".
    ibt r6, #NODE_POP
    lms r0, (MD_FLAGS)
    from r0
    and r6
    beq +
    nop
    GFCALL MatrixPop
+
    ibt r6, #NODE_PUSH
    lms r0, (MD_FLAGS)
    from r0
    and r6
    beq +
    nop
    GFCALL MatrixPush
+
    ; The root takes its translate from the frame; every other node carries
    ; its own, which TR does not animate. The packer marks which is which
    ; rather than the loop counting, so there is no first-iteration case.
    ibt r6, #NODE_ROOT
    lms r0, (MD_FLAGS)
    from r0
    and r6
    beq +
    nop
    lms r0, (MD_FX)
    sms (MD_X), r0
    lms r0, (MD_FY)
    sms (MD_Y), r0
    lms r0, (MD_FZ)
    sms (MD_Z), r0
+
    lms r0, (MD_X)
    sms (MX_X), r0
    lms r0, (MD_Y)
    sms (MX_Y), r0
    lms r0, (MD_Z)
    sms (MX_Z), r0
    GFCALL MatrixTranslateRel

    GFCALL WeaponModelBasis

    lms r0, (MD_AY)
    GFCALL MatrixRotateY
    lms r0, (MD_AX)
    GFCALL MatrixRotateX
    lms r0, (MD_AZ)
    GFCALL MatrixRotateZ

    ; Torso/head look is local to the completed body pose. Adding its
    ; angles to MD_AX/AY would rotate about the wrong axes.
.IFDEF FX3
    GFCALL WeaponLookFx3        ; and the shotgun's torso: the same 8 bytes
.ELSE
    GFCALL WeaponModelLook
.ENDIF

    ; A billboard node keeps where it is and forgets which way it is turned:
    ; the 3x3 becomes identity, so the mesh's own axes are the camera's and a
    ; flat quad faces the viewer wherever either of them stands. That is how
    ; a sprite is drawn here -- see buildSpriteModel in the packer. The
    ; translate column is untouched, because it is the one thing that took
    ; the parent's rotation into account and still should have.
    ibt r6, #NODE_BILLBOARD
    lms r0, (MD_FLAGS)
    from r0
    and r6
    beq +
    nop
.IFDEF FX3
    GFCALL BillboardNode        ; and a sprite sequence's frame: at the end
    bra +
    nop
    .DSB 21, $01                ; to the 42 bytes below: what follows keeps
.ELSE                           ; its tuned cache alignment
    iwt r0, #$7FFF                  ; 1.0 in 1.15
    ibt r5, #0
    sms (M_00), r0
    sms (M_01), r5
    sms (M_02), r5
    sms (M_10), r5
    sms (M_11), r0
    sms (M_12), r5
    sms (M_20), r5
    sms (M_21), r5
    sms (M_22), r0
.ENDIF
+
    iwt r0, #INST_NONE
    lms r5, (MD_BANK)
    from r5
    cmp r0
    beq DMD_Next
    nop

    ; Cull only this mesh, after preserving the joint's full matrix transform
    ; for any children. Zero is the packer's conservative escape for a radius
    ; too large for the byte, and therefore bypasses the test.
    lms r5, (MD_CULL)
    with r5
    from r5
    beq DMD_Draw
    nop
    lms r0, (MD_FLAGS)
    from r0
    to r9
    hib                         ; high byte = radius in units of 32, and set Z
    beq DMD_Draw
    nop
    GFCALL SphereOriginVisible
    ibt r5, #0
    from r0
    cmp r5
    beq DMD_Next
    nop

DMD_Draw:
    lms r0, (MD_ADDR)
    sms (R_ADDR), r0
    ibt r6, #LEVEL_BANK_BASE
    lms r0, (MD_BANK)
    with r0
    add r6
    sms (R_ROMB), r0
    GFCALL TransformMesh
.IFDEF FX3
    GFCALL DrawMeshFlash        ; and her pistols' flashes: the same 8 bytes
.ELSE
    GFCALL DrawMesh
.ENDIF
DMD_Next:
    lms r0, (MD_I)
    dec r0
    sms (MD_I), r0
    beq +
    nop
    GFJMP DMD_Node
+   lms r11, (MD_LINK)
    GRET

.INCLUDE "weapon.gsu"

; ===========================================================================
; RoomsCollect -- breadth-first through the portals from room R0.
;
; Leaves RL_COUNT room indices in RL_LIST, nearest first, so drawing them in
; reverse is a painter's order: the room the camera is in goes on top.
; ===========================================================================

RoomsCollect:
    sms (RL_LINK), r11
    sms (RL_TMP), r0

    ; visited[] clear
    iwt r10, #RL_VISITED
    iwt r12, #RL_ROOMS
    ibt r0, #0
    iwt r13, #RC_Clear
    cache
RC_Clear:
    from r0
    stb (r10)
    inc r10
    loop
    nop

    lms r5, (RL_TMP)
    iwt r10, #RL_LIST
    from r5
    stw (r10)

    ; the room the camera is in is seen through all of it
    iwt r10, #RL_RECT
    ibt r0, #0
    from r0
    stw (r10)
    inc r10
    inc r10
    iwt r0, #FRAME_WIDTH
    from r0
    stw (r10)
    inc r10
    inc r10
    ibt r0, #0
    from r0
    stw (r10)
    inc r10
    inc r10
    iwt r0, #FRAME_HEIGHT
    from r0
    stw (r10)

    ibt r0, #1
    sms (RL_COUNT), r0
    ibt r0, #0
    sms (RL_HEAD), r0

    iwt r10, #RL_VISITED
    with r10
    add r5
    ibt r0, #1
    from r0
    stb (r10)

RC_Room:
    lms r0, (RL_HEAD)
    lms r5, (RL_COUNT)
    to r6
    sub r5
    bmi +                       ; head < count: there is a room to expand
    nop
    GFJMP RC_Done
+   iwt r5, #RL_MAX
    lms r0, (RL_COUNT)
    to r6
    sub r5
    bmi +
    nop
    GFJMP RC_Done               ; the list is full; stop looking
+
    lms r0, (RL_HEAD)
    to r10
    add r0
    iwt r5, #RL_LIST
    with r10
    add r5
    to r0
    ldw (r10)
    sms (RL_TMP), r0            ; the room index, past the pointer arithmetic

    lms r0, (RL_HEAD)
    to r10
    add r0
    with r10
    add r10
    with r10
    add r10
    iwt r5, #RL_RECT
    with r10
    add r5
    to r0
    ldw (r10)
    sms (RC_X0), r0
    inc r10
    inc r10
    to r0
    ldw (r10)
    sms (RC_X1), r0
    inc r10
    inc r10
    to r0
    ldw (r10)
    sms (RC_Y0), r0
    inc r10
    inc r10
    to r0
    ldw (r10)
    sms (RC_Y1), r0

    lms r5, (RL_HEAD)
    inc r5
    sms (RL_HEAD), r5
    lms r0, (RL_TMP)

    GFCALL RoomLoad
    lm r0, (FR_ANGLE)
    GFCALL MatrixCamera

    lms r0, (R_PCOUNT)
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    GFJMP RC_Room               ; no portals out of this one
+   sms (RL_I), r0

    lms r6, (R_ROMB)
    from r6
    romb
    lms r14, (R_PADDR)

RC_Portal:
    sms (RL_LINK2), r14
    GFCALL RomWordAt            ; the room on the far side
    sms (P_ROOM), r0

    ; already queued?
    iwt r10, #RL_VISITED
    lms r5, (P_ROOM)
    with r10
    add r5
    to r0
    ldb (r10)
    ibt r5, #0
    from r0
    cmp r5
    beq +
    nop
    GFJMP RC_PortalNext
+
    GFCALL PortalVisible
    ibt r0, #0
    from r5
    cmp r0
    bne +
    nop
    GFJMP RC_PortalNext
+
    ; append, and mark it so a loop of portals cannot go round for ever
    lms r0, (RL_COUNT)
    sms (RC_SLOT), r0
    to r10
    add r0
    iwt r5, #RL_LIST
    with r10
    add r5
    lms r5, (P_ROOM)
    from r5
    stw (r10)
    lms r0, (RL_COUNT)
    inc r0
    sms (RL_COUNT), r0

    ; the rectangle the far room is seen through: the portal's box, cut down
    ; to the one this room was seen through
    lms r0, (RC_SLOT)
    to r10
    add r0
    with r10
    add r10
    with r10
    add r10
    iwt r5, #RL_RECT
    with r10
    add r5

    lms r5, (P_MINX)
    lms r0, (RC_X0)
    from r5
    to r6
    sub r0
    bpl +
    nop
    lms r5, (RC_X0)
+   from r5
    stw (r10)
    inc r10
    inc r10

    lms r5, (P_MAXX)
    lms r0, (RC_X1)
    from r5
    to r6
    sub r0
    bmi +
    nop
    lms r5, (RC_X1)
+   from r5
    stw (r10)
    inc r10
    inc r10

    lms r5, (P_MINY)
    lms r0, (RC_Y0)
    from r5
    to r6
    sub r0
    bpl +
    nop
    lms r5, (RC_Y0)
+   from r5
    stw (r10)
    inc r10
    inc r10

    lms r5, (P_MAXY)
    lms r0, (RC_Y1)
    from r5
    to r6
    sub r0
    bmi +
    nop
    lms r5, (RC_Y1)
+   from r5
    stw (r10)

    iwt r10, #RL_VISITED
    lms r5, (P_ROOM)
    with r10
    add r5
    ibt r0, #1
    from r0
    stb (r10)

RC_PortalNext:
    ; the record is a fixed size, so step past it whatever the test read
    lms r6, (R_ROMB)
    from r6
    romb
    ibt r0, #PORTAL_SIZE
    lms r5, (RL_LINK2)
    from r5
    to r14
    add r0

    lms r0, (RL_I)
    dec r0
    sms (RL_I), r0
    beq +
    nop
    GFJMP RC_Portal
+   GFJMP RC_Room

RC_Done:
    lms r11, (RL_LINK)
    GRET

; ===========================================================================
; TransformMesh / TransformRoom -- vertices through the matrix and projection.
;
; Reads the packed room's vertex count and int16 triples from ROM, then writes
; screen position and camera-space coordinates to TV_BASE. Rooms use the
; camera matrix directly: it is yaw-only, so four of its nine multiplies are
; known zero. Models enter through TransformMesh after modifying that matrix
; and take the general 3x3 path.
; ===========================================================================

TransformMesh:
    iwt r0, #TM_Vertex
    bra TransformBegin
    nop

TransformRoom:
    iwt r0, #TM_RoomVertex

TransformBegin:
    sms (T_LOOP), r0
    sms (T_LINK), r11

    lms r6, (R_ROMB)
    from r6
    romb
    lms r14, (R_ADDR)
    GFCALL RomWordAt
    sms (T_COUNT), r0           ; vertex count
    GFCALL RomWordAt
    sms (F_COUNT), r0           ; face count, handed to DrawMesh

    ; A count of zero would walk 65536 vertices, because the loop decrements
    ; and tests -- and 65536 of them is a megabyte written from TV_BASE, over
    ; the ordering table, the frame buffer and everything else. Bad data
    ; should draw nothing, not take the machine with it.
    lms r0, (T_COUNT)
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    lms r11, (T_LINK)
    GRET
+
    ; The loop's registers: R7 walks the transformed vertex array, R12 and
    ; R13 are LOOP's, and nothing in the body calls anything, so R11 is the
    ; camera Z and R1-R3 the vertex. See TM_Vertex.
    iwt r7, #TV_BASE
    lms r12, (T_COUNT)
    lms r13, (T_LOOP)

    ; The two vertex entries and their shared projection are contiguous and
    ; fit one cache window. Nothing between here and DrawMesh's OTClear
    ; executes CACHE, so it keeps that window for the loop. Before this was
    ; cached, instruction fetch alone cost 3 M cycles a frame -- five cycles
    ; a byte for every vertex of every room and mesh -- against one refill per
    ; TransformMesh call. OTClear moves CBR immediately afterwards anyway. A
    ; mesh needs about four vertices to pay for its refill.
    cache
TM_Vertex:
    ; The packed vertex: x, y, z into R1-R3 and, in a shaded build, shade into
    ; R4, which FMULT leaves alone. The last INC starts the next vertex's fetch.
    to r1
    getb
    inc r14
    with r1
    getbh
    inc r14
    to r2
    getb
    inc r14
    with r2
    getbh
    inc r14
    to r3
    getb
    inc r14
    with r3
    getbh
    inc r14
.IFDEF SHADING
    to r4
    getb
    inc r14
    with r4
    getbh
    inc r14                     ; travels with the vertex, untransformed
.ELSE
    inc r14
    inc r14                     ; packed shade is absent from the unlit path
.ENDIF

    ; --- room space to camera space -------------------------------------
    ; TransformPoint, with the vertex in registers rather than in RAM: nine
    ; FMULTs and a translate. Matrix elements are 1.15, so each product
    ; comes back halved and the doubling is put back once per row. This
    ; used to be a call whose every operand went through RAM, three loads
    ; of each coordinate and a store and reload of each result -- twenty
    ; RAM accesses a vertex that the registers had room for all along.
    lms r6, (M_00)
    from r1
    to r9
    fmult
    lms r6, (M_01)
    from r2
    to r8
    fmult
    with r9
    add r8
    lms r6, (M_02)
    from r3
    to r8
    fmult
    with r9
    add r8
    with r9
    add r9                      ; undo the 1.15 halving
    lms r8, (M_TX)
    with r9
    add r8                      ; R9 = camera X

    lms r6, (M_10)
    from r1
    to r10
    fmult
    lms r6, (M_11)
    from r2
    to r8
    fmult
    with r10
    add r8
    lms r6, (M_12)
    from r3
    to r8
    fmult
    with r10
    add r8
    with r10
    add r10
    lms r8, (M_TY)
    with r10
    add r8                      ; R10 = camera Y

    lms r6, (M_20)
    from r1
    to r11
    fmult
    lms r6, (M_21)
    from r2
    to r8
    fmult
    with r11
    add r8
    lms r6, (M_22)
    from r3
    to r8
    fmult
    with r11
    add r8
    with r11
    add r11
    lms r8, (M_TZ)
    with r11
    add r8                      ; R11 = camera Z

    bra TM_Project
    nop

TM_RoomVertex:
    ; Rooms have their own loop entry so selecting the yaw-only matrix is a
    ; once-per-mesh RAM load, not a once-per-vertex one. The small duplicated
    ; ROM loader is cheaper than testing a selector in every iteration, and
    ; both paths still share projection, clipping, and the output stores.
    to r1
    getb
    inc r14
    with r1
    getbh
    inc r14
    to r2
    getb
    inc r14
    with r2
    getbh
    inc r14
    to r3
    getb
    inc r14
    with r3
    getbh
    inc r14
.IFDEF SHADING
    to r4
    getb
    inc r14
    with r4
    getbh
    inc r14
.ELSE
    inc r14
    inc r14
.ENDIF

    ; The room matrix comes straight from MatrixCamera and has only yaw:
    ;
    ;   [ m00   0  m02 ]
    ;   [   0  m11   0 ]
    ;   [ m20   0  m22 ]
    ;
    ; Skip its four multiply-by-zero terms. Keep m11's multiply rather than
    ; replacing it with Y so the $7FFF fixed-point rounding stays bit-exact
    ; with the general path.
    ; camera X = 2 * (x*m00 + z*m02) + tx
    lms r6, (M_00)
    from r1
    to r9
    fmult
    lms r6, (M_02)
    from r3
    to r8
    fmult
    with r9
    add r8
    with r9
    add r9
    lms r8, (M_TX)
    with r9
    add r8

    ; camera Y = 2 * y*m11 + ty
    lms r6, (M_11)
    from r2
    to r10
    fmult
    with r10
    add r10
    lms r8, (M_TY)
    with r10
    add r8

    ; camera Z = 2 * (x*m20 + z*m22) + tz
    lms r6, (M_20)
    from r1
    to r11
    fmult
    lms r6, (M_22)
    from r3
    to r8
    fmult
    with r11
    add r8
    with r11
    add r11
    lms r8, (M_TZ)
    with r11
    add r8

TM_Project:
    ; --- perspective ------------------------------------------------------
    ; Reject a near vertex before doing a reciprocal lookup and two FMULTs.
    ; Its screen coordinates are meaningless and OTBuild never reads them:
    ; bit 0 sends every face that references it through ClipNear, which uses
    ; the camera-space triple stored below.
    iwt r0, #ZMIN
    from r11
    sub r0
    bpl @project
    nop
.IFDEF FX3
    ; Nearer than the table reaches: TM_Near, at the end, projects it or
    ; flags it, and comes back to TM_Store or TM_Flagged. Padded to the arm
    ; it replaces, so the window below keeps its alignment. R13 is LOOP's:
    ; the jump is a write to R15, not GFJMP.
    iwt r15, #TM_Near
    nop
.IFDEF SHADING
    .DSB 9, $01
.ELSE
    .DSB 7, $01
.ENDIF
.ELSE
    ibt r1, #1
    ibt r0, #TV_G
    with r7
    add r0
.IFDEF SHADING
    from r4
    stw (r7)
.ENDIF
    inc r7
    inc r7                      ; TV_CX
    bra TM_Flagged
    nop
.ENDIF

@project:
    ; dz = z >> 7, done as (z >> 8) * 2 rather than seven LSRs; 65536 / dz
    ; from the table in RAM; x / dz and y / dz by FMULT. The test above
    ; proves signed z is 512..32767, so dz is 4..254 and needs neither of the
    ; old reciprocal-table clamps.
    from r11
    to r5
    hib
    with r5
    add r5
    iwt r6, #M7_PROJTAB          ; 65536 / dz, or half of it in the Mode 7 frame
    with r5
    add r5                      ; index * 2
    with r6
    add r5
    to r6
    ldw (r6)                    ; R6 = 65536 / dz
    from r9
    to r5
    fmult                       ; x / dz
    iwt r0, #SCREEN_CX
    with r5
    add r0                      ; R5 = screen X
    from r10
    to r8
    fmult
    lms r0, (FR_CY)             ; the sheared centre line
    with r8
    add r0                      ; R8 = screen Y

TM_Store:
    ; --- the transformed vertex, in TV order, R7 walking it ---------------
    from r5
    stw (r7)                    ; screen X
    inc r7
    inc r7
    from r8
    stw (r7)                    ; screen Y
    inc r7
    inc r7
.IFDEF SHADING
    from r4
    stw (r7)                    ; shade
.ENDIF
    inc r7
    inc r7
    ; Clip flags in R1 (the vertex's own X is spent): which sides of the
    ; room's clip rectangle the point is off, x0 and y0 inclusive, x1 and
    ; y1 exclusive, as the rasterizer clips. Near vertices took the arm
    ; above and carry bit 0 alone. What the GBA's transformRoom calls
    ; CLIP_LEFT and the rest.
    ibt r1, #0
    lms r0, (V_CLIPX0)
    from r5
    sub r0                      ; x - x0
    bpl +
    nop
    ibt r1, #2                  ; off the left
+   lms r0, (V_CLIPX1)
    from r5
    sub r0                      ; x - x1
    bmi +
    nop
    ibt r2, #4
    with r1
    or r2                       ; off the right
+   lms r0, (V_CLIPY0)
    from r8
    sub r0                      ; y - y0
    bpl +
    nop
    ibt r2, #8
    with r1
    or r2                       ; above
+   lms r0, (V_CLIPY1)
    from r8
    sub r0                      ; y - y1
    bmi +
    nop
    ibt r2, #16
    with r1
    or r2                       ; below
+
TM_Flagged:
    from r9
    stw (r7)                    ; camera X, for the clipper
    inc r7
    inc r7
    from r10
    stw (r7)                    ; camera Y
    inc r7
    inc r7
    from r11
    stw (r7)                    ; camera Z
    inc r7
    inc r7
    from r1
    stw (r7)                    ; TV_CLIP
    inc r7                      ; TV_SIZE - TV_CLIP is two bytes
    loop
    inc r7                      ; complete the vertex cursor in the delay slot
    sms (F_ROM), r14            ; the face list starts where the vertices end
    lms r11, (T_LINK)
    GRET
    .DSB 3, $01                 ; preserve the later matrix/cull window addresses

; ===========================================================================
; TransformPoint -- T_X/T_Y/T_Z through the matrix into T_CX/T_CY/T_CZ.
;
; Room space to camera space, nine FMULTs and a translate. The portal test
; and the clipper's ProjectClip call this and ProjectPoint below with their
; operands in RAM; the vertex loop above has the same arithmetic inline
; with its operands in registers, which is the version that runs per
; vertex of every room and mesh.
; ===========================================================================

TransformPoint:
    sms (T_LINK3), r11
    ; --- camera X ---------------------------------------------------------
    lms r6, (M_00)
    lms r7, (T_X)
    from r7
    to r5
    fmult
    lms r6, (M_01)
    lms r7, (T_Y)
    from r7
    to r8
    fmult
    with r5
    add r8
    lms r6, (M_02)
    lms r7, (T_Z)
    from r7
    to r8
    fmult
    with r5
    add r8
    with r5
    add r5                      ; undo the 1.15 halving
    lms r8, (M_TX)
    with r5
    add r8
    sms (T_CX), r5

    ; --- camera Y ---------------------------------------------------------
    lms r6, (M_10)
    lms r7, (T_X)
    from r7
    to r5
    fmult
    lms r6, (M_11)
    lms r7, (T_Y)
    from r7
    to r8
    fmult
    with r5
    add r8
    lms r6, (M_12)
    lms r7, (T_Z)
    from r7
    to r8
    fmult
    with r5
    add r8
    with r5
    add r5
    lms r8, (M_TY)
    with r5
    add r8
    sms (T_CY), r5

    ; --- camera Z ---------------------------------------------------------
    lms r6, (M_20)
    lms r7, (T_X)
    from r7
    to r5
    fmult
    lms r6, (M_21)
    lms r7, (T_Y)
    from r7
    to r8
    fmult
    with r5
    add r8
    lms r6, (M_22)
    lms r7, (T_Z)
    from r7
    to r8
    fmult
    with r5
    add r8
    with r5
    add r5
    lms r8, (M_TZ)
    with r5
    add r8
    sms (T_CZ), r5

    lms r11, (T_LINK3)
    GRET

; ===========================================================================
; ProjectPoint -- camera space in T_CX/T_CY/T_CZ to screen space in T_SX/T_SY.
;
; T_REJECT comes back non-zero when the point is at or behind the near plane,
; in which case the screen values are meaningless -- the clipper deals with it.
; ===========================================================================

ProjectPoint:
    sms (T_LINK2), r11

    ibt r0, #0
    sms (T_REJECT), r0

    iwt r0, #ZMIN
    lms r5, (T_CZ)
    from r5
    to r6
    sub r0
    bpl +
    nop
    ibt r0, #1
    sms (T_REJECT), r0
+
    ; dz = z >> 7, done as (z >> 8) * 2 rather than seven LSRs.
    lms r5, (T_CZ)
    with r5
    hib
    with r5
    add r5

    ibt r0, #1
    from r5
    cmp r0
    bcs +                       ; dz >= 1
    nop
    ibt r5, #1
+   iwt r0, #255
    from r5
    cmp r0
    bcc +                       ; dz < 255
    nop
    iwt r5, #255
+   ; 65536 / dz from the table in RAM -- dz is 1..255 here, so no
    ; normalising. This was a far call to DivTable, out of this window and
    ; through the ROM buffer, per vertex of every room.
    iwt r6, #M7_PROJTAB
    with r5
    add r5                      ; index * 2
    with r6
    add r5
    to r6
    ldw (r6)                    ; R6 = 65536 / dz, FMULT's multiplier
    lms r7, (T_CX)
    from r7
    to r5
    fmult                       ; x / dz
    iwt r0, #SCREEN_CX
    with r5
    add r0
    sms (T_SX), r5

    lms r7, (T_CY)
    from r7
    to r5
    fmult
    lms r0, (FR_CY)             ; the sheared centre line
    with r5
    add r0
    sms (T_SY), r5

    lms r11, (T_LINK2)
    GRET

; ===========================================================================
; DrawMesh -- order the faces by depth, then draw them back to front.
;
; Pass one reads each face just far enough to find its depth and files it in
; the ordering table. Pass two walks the buckets from far to near and draws.
; The face data is read from ROM twice rather than cached in RAM; ROM reads go
; through the buffer and overlap with other work, and RAM is scarcer here.
; ===========================================================================
; SphereVisible -- can anything within S_R of the point T_X/T_Y/T_Z, in the
; frame of the current matrix (the room's), reach the clip rectangle?
; R0 = 0 if not.
;
; What the GBA's boxIsVisible asks of an item's box before its nodes are
; built -- a sphere here, since one radius per model is a byte in ROM and
; the test is a transform, a projection and four compares. Conservative on
; purpose: the radius is projected at the sphere's nearest depth, two
; pixels are added for the roundings, and a sphere that reaches the near
; plane is visible without asking. In the room 14 view 49 of 85 model
; nodes and 12 of 24 static instances were built to file no face at all.
; ===========================================================================
SphereVisible:
    sms (S_LINK), r11
    GFCALL TransformPoint

SV_Camera:
    ; wholly behind the near plane: cz + r < ZNEAR
    lms r0, (T_CZ)
    lms r5, (S_R)
    to r6
    add r5
    iwt r0, #ZNEAR
    with r6
    sub r0
    bpl +
    nop
    GFJMP SV_No
+   ; reaching it: cz - r < ZMIN, no projection to trust, so visible
    lms r0, (T_CZ)
    lms r5, (S_R)
    to r6
    sub r5                      ; R6 = cz - r, the nearest depth
    iwt r0, #ZMIN
    from r6
    to r7
    sub r0
    bpl +
    nop
    GFJMP SV_Yes
+   ; the radius on the screen at that depth: dz = (cz - r) >> 7, 1..255,
    ; through the projection table as TM_Vertex does it
    from r6
    to r5
    hib
    with r5
    add r5
    ibt r0, #1
    from r5
    cmp r0
    bcs +
    nop
    ibt r5, #1
+   iwt r0, #255
    from r5
    cmp r0
    bcc +
    nop
    iwt r5, #255
+   iwt r6, #M7_PROJTAB
    with r5
    add r5
    with r6
    add r5
    to r6
    ldw (r6)                    ; 65536 / dz, or half of it in the Mode 7 frame
    lms r5, (S_R)
    from r5
    to r7
    fmult                       ; r / dz
    inc r7
    inc r7                      ; and two pixels
    sms (S_RS), r7
    ; the centre at its own depth, then the disc against the rectangle
    GFCALL ProjectPoint
SV_Rect:
    lms r5, (S_RS)
    lms r0, (T_SX)
    to r6
    add r5                      ; the disc's right edge
    lms r0, (V_CLIPX0)
    with r6
    sub r0
    bmi SV_No                   ; wholly left of the rectangle
    nop
    lms r0, (T_SX)
    to r6
    sub r5                      ; its left edge
    lms r0, (V_CLIPX1)
    with r6
    sub r0
    bpl SV_No                   ; wholly right of it (x1 is exclusive)
    nop
    lms r0, (T_SY)
    to r6
    add r5
    lms r0, (V_CLIPY0)
    with r6
    sub r0
    bmi SV_No                   ; wholly above
    nop
    lms r0, (T_SY)
    to r6
    sub r5
    lms r0, (V_CLIPY1)
    with r6
    sub r0
    bpl SV_No                   ; wholly below
    nop
SV_Yes:
    ibt r0, #1
    lms r11, (S_LINK)
    GRET
SV_No:
    ibt r0, #0
    lms r11, (S_LINK)
    GRET

; A model node has already translated the matrix to its own origin; R9 is its
; packed radius in units of 32. Its sphere centre is therefore the translation
; column. Work from it directly rather
; than storing three zero coordinates, multiplying them by the matrix, then
; loading the result back. The projection arithmetic is the shared path's:
; radius at the nearest depth, centre at its own depth.
SphereOriginVisible:
    sms (S_LINK), r11

    ; Most visible actors are in the camera room, through the whole frame. If
    ; the node origin is in front and inside that horizontal frustum, keeping
    ; it is always safe: this test is allowed a false positive, never a false
    ; negative. It avoids two reciprocal lookups and three FMULTs for the
    ; ordinary on-screen case; narrow portal rectangles still take the exact
    ; sphere path below.
    lms r5, (R_NOTFULL)
    with r5
    from r5                     ; MOVES: set Z from the precomputed difference
    bne SOV_Near
    nop

    lms r8, (M_TZ)
    iwt r0, #ZMIN
    from r8
    to r6
    sub r0
    bmi SOV_Near
    nop
    lms r5, (M_TX)
    ibt r0, #0
    from r5
    to r6
    sub r0                      ; R6 = x, with its sign in S
    bpl +
    nop
    from r0
    to r6
    sub r5                      ; R6 = abs(x)
+   from r6
    cmp r8
    bcs SOV_Near                ; outside the full horizontal frustum
    nop
    ibt r0, #1                  ; inline the hot return; SV_Yes is a far jump
    lms r11, (S_LINK)
    GRET

    ; wholly behind the near plane: cz + r < ZNEAR
SOV_Near:
    ibt r6, #32                 ; packed byte becomes the full radius
    from r9
    to r5
    umult r6
    sms (S_R), r5
    lms r0, (M_TZ)
    lms r5, (S_R)
    to r6
    add r5
    iwt r0, #ZNEAR
    with r6
    sub r0
    bpl SOV_Depth
    nop
    GFJMP SV_No

SOV_Depth:
    ; A sphere reaching the near plane stays: its projection is unbounded.
    lms r0, (M_TZ)
    lms r5, (S_R)
    to r6
    sub r5                      ; R6 = nearest depth
    iwt r0, #ZMIN
    from r6
    to r8
    sub r0
    bpl SOV_Radius
    nop
    GFJMP SV_Yes

SOV_Radius:
    ; Project the radius at the nearest depth. It is at least ZMIN here, so
    ; the lower clamp in the general path cannot fire.
    from r6
    to r5
    hib
    with r5
    add r5
    iwt r0, #255
    from r5
    cmp r0
    bcc +
    nop
    iwt r5, #255
+   iwt r6, #M7_PROJTAB
    with r5
    add r5
    with r6
    add r5
    to r6
    ldw (r6)
    lms r5, (S_R)
    from r5
    to r7
    fmult
    inc r7
    inc r7
    sms (S_RS), r7

    ; And the centre at its own depth, with the same table and rounding as
    ; ProjectPoint. R7 keeps the projected radius for the rectangle test.
    lms r0, (M_TZ)
    from r0
    to r5
    hib
    with r5
    add r5
    iwt r0, #255
    from r5
    cmp r0
    bcc +
    nop
    iwt r5, #255
+   iwt r6, #M7_PROJTAB
    with r5
    add r5
    with r6
    add r5
    to r6
    ldw (r6)

    lms r8, (M_TX)
    from r8
    to r5
    fmult
    iwt r0, #SCREEN_CX
    with r5
    add r0
    sms (T_SX), r5

    lms r8, (M_TY)
    from r8
    to r5
    fmult
    lms r0, (FR_CY)             ; the sheared centre line
    with r5
    add r0
    sms (T_SY), r5
    GFJMP SV_Rect

; ===========================================================================

DrawMesh:
    sms (F_LINK), r11
    GFCALL OTClear
    GFCALL OTBuild
    GFCALL OTDraw
    lms r11, (F_LINK)
    GRET

; ---------------------------------------------------------------------------

    ; Sphere visibility grew the cold half above this window. Thirty-eight dead
    ; bytes restore the exact modulo-16 phase the measured ordering
    ; window had before it, keeping OTB_Vertex and DrawFace on the same cache
    ; block boundaries. This is never reached: DrawMesh returns above.
    .DSB 38, $01

OTClear:
    iwt r10, #OT_HEAD
    iwt r12, #OT_BUCKETS
    iwt r0, #$FFFF
    iwt r13, #OTC_Loop
    ; This CACHE looks like a per-mesh thrash of the rasterizer's window --
    ; DrawMesh runs once per static-mesh instance and per model node, and
    ; every CACHE moves CBR -- but it stays, because it was measured: the
    ; window it anchors also holds OTBuild and OTDraw, whose per-face loops
    ; are hotter than the SpanFillT refault it forces. Removing it cost
    ; 2.5 M cycles a frame in gsusim (29.2 M -> 31.7 M, cache hits 43% -> 34%).
    cache
OTC_Loop:
    stw (r10)
    inc r10
    loop
    inc r10                     ; delay slot: advance the word on every iteration
    nop
    nop                         ; preserve the following ordering window's phase
    GRET

; ---------------------------------------------------------------------------
; OTBuild -- file every face under its depth bucket.
; ---------------------------------------------------------------------------

OTBuild:
    sms (F_LINK4), r11

    lms r6, (R_ROMB)
    from r6
    romb
    lms r14, (F_ROM)
    ibt r0, #0
    sms (F_IDX), r0
    sms (F_BMAX), r0            ; no bucket used yet: max below min
    iwt r0, #(OT_BUCKETS - 1)
    sms (F_BMIN), r0
    lms r3, (F_COUNT)           ; no calls below: keep the outer count live

OTB_Face:
    with r3
    or r3                       ; zero test without a temporary zero register
    bne +
    dec r3                      ; safe one-byte delay slot; unused on zero
    GFJMP OTB_Done
+

    ; Remember where this face started, then skip its unused page byte.
    ; Only DrawFace consumes that byte; the ordering pass needs the count.
    sms (F_CURSOR), r14
    inc r14                     ; the page byte is never consumed by this pass

    ; depth = the largest camera z of the face's vertices, so a face is drawn
    ; after everything behind it. R11 holds it: OTBuild saved the link.
    ibt r11, #0
    getb                        ; vertex count: triangle or quad; default R0
    inc r14
    move r12, r0
    iwt r13, #OTB_Vertex
    ibt r1, #0                  ; OR of the vertices' flags: bit 0 means any near
    ibt r2, #$1F                ; the clip flags every vertex shares, so far
    iwt r7, #CLIP_A             ; the vertices' addresses, for the cull below;
                                ; the clipper is idle until OTDraw
    ibt r8, #TV_CZ              ; common offset within every transformed vertex

OTB_Vertex:
    ; RomWordAt inlined; see DM_Vertex. The packer has already made the word
    ; TV_BASE + index * TV_SIZE, the address both face passes want.
    to r10
    getb
    inc r14
    with r10
    getbh
    inc r14
    from r10
    stw (r7)                    ; STW takes R0-R11
    inc r7
    with r10
    add r8
    to r5
    ldw (r10)                   ; camera z
    inc r10
    inc r10
    to r4
    ldw (r10)                   ; its clip flags (R4: LMULT's, idle in here)
    with r2
    and r4                      ; over the face
    with r1
    or r4                       ; bit 0 if any vertex needs near clipping
    from r5
    to r6
    sub r11
    bmi +                       ; not deeper than what we have
    inc r14                     ; first byte of the unread u/v pair
    move r11, r5
+   inc r14                     ; second byte; writing R14 starts the buffer
    loop
    inc r7                      ; finish the word cursor in the LOOP delay slot

    ; Every vertex off the same side of the clip rectangle, or every one
    ; short of the near plane: nothing of it reaches the screen, and it is
    ; not filed. Half the faces of a room seen from inside it -- 202 of the
    ; opening view's 406 -- went through the edge setup and the strip walk
    ; to draw nothing before this.
    with r2
    or r2
    beq +
    nop
    GFJMP OTB_Face
+
    ; Facing away, by the sign of the screen-space cross product of the first
    ; three vertices -- the test FaceVisible makes, made here from the
    ; transformed vertices instead of from a copy of them, so a back-facing
    ; face is never copied at all: 312 of the opening view's 714 in front of
    ; the near plane. Only when every vertex is in front of it: a near one has
    ; no screen position until the clipper has replaced it, and its face goes
    ; on to be clipped, then culled by FaceVisible as before. See there for
    ; the 32-bit arithmetic and the zero-area rule.
    ; DrawFace also needs this answer. Keep it beside the ordering tables so
    ; the common path can avoid loading and copying camera-space vertices;
    ; a face rejected below simply has its byte overwritten by the next one
    ; filed at the same F_IDX.
    lms r5, (F_IDX)
    iwt r10, #OT_NEAR
    with r10
    add r5
    from r1
    stb (r10)

    with r1
    lsr                         ; bit 0 -> carry: at least one near vertex
    bcs OTB_File
    nop
    iwt r10, #CLIP_A
    to r9
    ldw (r10)                   ; &v0
    inc r10
    inc r10
    to r8
    ldw (r10)                   ; &v1
    inc r10
    inc r10
    to r7
    ldw (r10)                   ; &v2
    to r1
    ldw (r9)                    ; x0
    inc r9
    inc r9
    to r2
    ldw (r9)                    ; y0
    inc r7
    inc r7
    to r6
    ldw (r7)                    ; y2
    with r6
    sub r2                      ; b = y2 - y0
    to r5
    ldw (r8)                    ; x1
    with r5
    sub r1                      ; a = x1 - x0
    from r5
    to r9
    lmult                       ; R9:R4 = a * b
    move r12, r4
    inc r8
    inc r8
    to r6
    ldw (r8)                    ; y1
    with r6
    sub r2                      ; d = y1 - y0
    dec r7
    dec r7
    to r5
    ldw (r7)                    ; x2
    with r5
    sub r1                      ; c = x2 - x0
    from r5
    to r8
    lmult                       ; R8:R4 = c * d
    with r12
    sub r4                      ; low word, CY = no borrow
    with r9
    sbc r8                      ; high word with the borrow
    with r9
    or r9
    bmi OTB_Skip                ; negative: facing away
    nop
    with r9
    or r12                      ; zero only when the full 32-bit area is zero
    bne OTB_File                ; non-zero positive area
    nop
OTB_Skip:
    GFJMP OTB_Face

OTB_File:
    ; bucket = z >> OT_SHIFT, saturated
    from r11
    to r5
    hib                         ; >> 8
    with r5
    lsr                         ; >> 9
    iwt r0, #(OT_BUCKETS - 1)
    from r5
    cmp r0
    bcc +
    nop
    iwt r5, #(OT_BUCKETS - 1)
+
    ; the range of buckets this mesh uses, for OTDraw to walk and no more:
    ; a mesh that files three faces used to cost a walk of sixty-four
    lms r0, (F_BMAX)
    from r5
    sub r0
    bmi +                       ; not deeper than the deepest so far
    nop
    sms (F_BMAX), r5
+   lms r0, (F_BMIN)
    with r0
    sub r5
    bmi +                       ; not nearer than the nearest so far
    nop
    sms (F_BMIN), r5
+
    ; link this face at the head of its bucket
    from r5
    to r10
    add r5                      ; bucket * 2
    iwt r0, #OT_HEAD
    with r10
    add r0
    to r6
    ldw (r10)                   ; old head

    lms r5, (F_IDX)
    move r8, r5
    with r8
    add r8                      ; index * 2; keep the unscaled index in R5
    iwt r0, #OT_NEXT
    from r8
    to r9
    add r0
    from r6
    stw (r9)                    ; next = old head

    iwt r0, #OT_OFF
    from r8
    to r9
    add r0
    lms r6, (F_CURSOR)
    from r6
    stw (r9)                    ; remember where the face data is

    from r5
    stw (r10)                   ; head = this face

    inc r5
    sms (F_IDX), r5
    GFJMP OTB_Face

    ; R14 already remains on the next face throughout the cull and file paths;
    ; the old RAM save/reload pairs were redundant. Keep the following setup
    ; cache window on its measured ROM-byte phase with equivalent dead space.
    .DSB 17, $01                ; NOPs, never executed; retain OTDraw's phase
OTB_Done:
    lms r11, (F_LINK4)
    GRET

; ---------------------------------------------------------------------------
; OTDraw -- walk the buckets from far to near, setting faces up in batches.
;
; The per-face setup -- the bucket walk, DrawFace and its vertex copy -- and
; the rasterizer each want the one 512-byte instruction window, and a face
; that ran both moved it twice: 4,500 cycles of refill to save 3,650 of
; fetch, which is why a window here was costed and refused twice. Batched, it
; pays: faces are set up into slots in game pak RAM under this window until
; the batch area is full, then BatchFlush rasterizes them all under the
; other one. Two refills per batch of twenty-odd faces rather than per face.
;
; The anchor is the CACHE at OTD_Face, executed per face: when CBR is already
; here it costs one cycle, and after a flush has moved CBR to the raster
; window it brings it back. Everything per face or per bucket sits after it
; in address order; the once-per-mesh entry sits before it.
;
; A slot is the face's VertexLinks, C_NVERT of them, with the flush's header
; in the first link's spare bytes:
;
;   +10 uint16 texture page, or FACE_FLAT | palette index
;   +12 uint16 the address of the topmost vertex's VL_Y word
;   +14 uint16 the next slot: the links, then the face's edge cell
;
; The order is the draw order: a slot is filled and flushed in the sequence
; the buckets hand faces over, so batching changes nothing in the picture.
; ---------------------------------------------------------------------------

OTDraw:
    sms (F_LINK3), r11
    ; Nothing filed -- a mesh wholly off the screen, which the clip flags
    ; make common -- is nothing to walk, set up or flush.
    lms r0, (F_IDX)
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    lms r11, (F_LINK3)
    GRET
+   iwt r0, #BATCH_BASE
    sms (B_SLOT), r0
    lms r0, (F_BMAX)            ; from the deepest bucket used ...
    sms (F_BUCKET), r0
    GFJMP OTD_Bucket

OTD_Face:
    cache                       ; the setup window starts here; see above
    lms r5, (F_IDX)
    iwt r0, #$FFFF
    from r5
    cmp r0
    beq OTD_NextBucket
    nop

    ; fetch this face's position in the packed list and set it up
    from r5
    to r8
    add r5
    iwt r0, #OT_OFF
    from r8
    to r9
    add r0
    to r14
    ldw (r9)

    ; OTBuild already ORed the near flag across this face. Hand it to
    ; DrawFace so a clipped face goes straight to camera-space loading while
    ; the normal loop never touches fields only the clipper consumes.
    iwt r10, #OT_NEAR
    with r10
    add r5
    to r0
    ldb (r10)
    sms (F_NEAR), r0
    GFCALL DrawFace             ; R5 = 1 if a slot was written at B_SLOT
    with r5
    or r5
    beq OTD_Next
    nop
    lms r0, (F_PTR)             ; DrawFace leaves it past the slot's last link
    ibt r5, #VL_SIZE
    with r0
    add r5                      ; and one more cell is the edge cell
    sms (B_SLOT), r0
    iwt r5, #BATCH_LIMIT
    from r0
    cmp r5
    bcc OTD_Next                ; room for another
    nop
    GFCALL BatchFlush

OTD_Next:
    lms r5, (F_IDX)
    from r5
    to r8
    add r5
    iwt r0, #OT_NEXT
    from r8
    to r9
    add r0
    to r5
    ldw (r9)
    sms (F_IDX), r5
    bra OTD_Face
    nop

OTD_NextBucket:
    lms r0, (F_BUCKET)
    lms r5, (F_BMIN)            ; ... down to the nearest
    from r0
    cmp r5
    beq OTD_Done
    nop
    dec r0
    sms (F_BUCKET), r0

OTD_Bucket:
    lms r5, (F_BUCKET)
    from r5
    to r10
    add r5
    iwt r0, #OT_HEAD
    with r10
    add r0
    to r5
    ldw (r10)
    sms (F_IDX), r5
    GFJMP OTD_Face

OTD_Done:
    GFCALL BatchFlush           ; whatever the last bucket left
    lms r11, (F_LINK3)
    GRET
    .DSB 3, $01                 ; retain DrawFace's measured cache alignment

; ===========================================================================
; DrawFace -- set one face up in the slot at B_SLOT, from the packed list
; at R14.
;
; Out: R5 = 1: the slot is filled and F_PTR is just past its last link.
;      R5 = 0: the slot is free again; the face crossed the near plane and
;              the clipper found it facing away or too little of it.
;
; The window is the reason for the shape of this. The unclipped path runs
; straight through DM_Vertex, with the link cycle and the topmost vertex
; found on the way rather than by passes of their own, and no cull: OTBuild
; filed it only after testing the same vertices. The near-plane clipper's
; path jumps out of line at DF_Clip and back in at DF_Header.
; ===========================================================================

DrawFace:
    sms (F_LINK2), r11

    lms r6, (R_ROMB)
    from r6
    romb
    move r14, r14               ; ROMB does not reload the buffer; R14 was
                                ; written while the previous texture bank was
                                ; still selected, so trigger the face-byte read

    to r0                       ; texture page, or FACE_FLAT | palette index
    getb                        ; (RomByteAt, inlined; see OTB_Face)
    inc r14
    sms (F_PAGE), r0

    to r0                       ; vertex count: triangle or quad
    getb
    inc r14
    sms (C_N), r0
    sms (F_VROM), r14           ; saved before the near/normal dispatch
    move r12, r0                ; LOOP's count; nothing in the loop calls
    lms r0, (F_NEAR)
    with r0
    lsr                         ; OTBuild's bit 0: any vertex is near
    bcc +
    nop
    GFJMP DF_ClipLoad
+
    lms r0, (C_N)               ; the flag test consumed the live count
    iwt r13, #DM_Vertex

    ; The link cycle's two special words, held in R1 and R2 -- the PLOT
    ; coordinates, idle until the flush. First: prev = N-1, next = +1. Last:
    ; prev = -1, next = -(N-1), which is what SWAP makes of -(N-1) itself:
    ; $FFFD becomes $FDFF. The middles are all $01FF and DM_Vertex writes
    ; that for every vertex; the two ends are patched after the loop.
    move r5, r0
    dec r5                      ; N-1
    iwt r6, #$0100
    from r5
    to r1
    or r6                       ; OR takes r1-r15; $C0 is HIB, not `or r0`
    ibt r0, #0
    to r2
    sub r5                      ; -(N-1)
    with r2
    swap

    ; Past any screen Y -- a projected vertex is within 8.3 K of the centre,
    ; the near plane and the 128-pixel focal length see to that -- without
    ; being so far past that the first vertex's `Y - this` overflows.
    iwt r4, #$3FFF              ; top Y remains live alongside the reject mask
    lms r8, (B_SLOT)            ; no calls in the loop, so keep both output
    iwt r7, #$01FF              ; every middle link has prev=-1, next=+1

DM_Vertex:
    ; RomWordAt and RomByteAt, inlined. They are three and seven instructions
    ; of real work behind an eight-byte far call, and this runs per vertex of
    ; per face of per room -- the call was costing more to fetch than the work.
    ; The word is the transformed vertex's absolute RAM address: the packer
    ; has already added TV_BASE and multiplied the index by TV_SIZE.
    to r10
    getb
    inc r14
    with r10
    getbh
    inc r14

    ; One walk, not a field address per load. The transformed vertex's screen
    ; triple is laid out in VertexLink order, so this is load, store and step.
    ; Camera space is deliberately absent: OTBuild's near flag sends the rare
    ; face that needs it to DF_LoadClip before this loop.
    to r5                       ; screen X -> VL_X
    ldw (r10)
    from r5
    stw (r8)
    inc r10
    inc r10
    inc r8
    inc r8

    to r5                       ; screen Y -> VL_Y
    ldw (r10)
    from r5
    stw (r8)
    ; the topmost vertex, which is where the rasterizer starts
    from r5
    to r6
    sub r4
    bpl +                       ; lower down the screen than the best so far
    inc r10                     ; first step toward the shade, on either path
    move r4, r5
    sms (F_TOP), r8             ; &VL_Y; the flush backs up to the link
+   inc r10
    inc r8
    inc r8

.IFDEF SHADING
    to r5                       ; shade -> VL_G
    ldw (r10)
    from r5
    stw (r8)
.ENDIF
    inc r10
    inc r10
    inc r8
    inc r8                      ; R8 now at VL_PREV

    from r7                     ; a middle vertex's links, until patched
    stw (r8)

    ; U and V, straight from the packed face into the link's packed word,
    ; which is the word after the links R8 is still at. Camera X/Y/Z and the
    ; clip vertex are cold-path work now; OTBuild proved this face needs
    ; neither before selecting this loop.
    inc r8
    inc r8                      ; R8 = &VL_UV

    to r6                       ; u
    getb
    inc r14

    getb                        ; v; the preceding INC restores default R0
    inc r14
    swap                        ; v into the high byte
    to r5
    or r6                       ; R5 = (v << 8) | u
    from r5
    stw (r8)                    ; VL_UV

    ; the next VertexLink, from where its walk stopped
    ibt r0, #(VL_SIZE - VL_UV)
    with r8
    add r0

    loop
    nop

    ; the cycle's two ends
    sms (F_PTR), r8
    lms r10, (B_SLOT)
    ibt r0, #VL_PREV
    with r10
    add r0
    from r1
    stw (r10)
    iwt r0, #(VL_PREV - VL_SIZE + $10000) ; back into the last link
    with r8
    add r0
    from r2
    stw (r8)

    lms r0, (C_N)               ; OTBuild culled it already, from the same
    sms (C_NVERT), r0           ; vertices: nothing near, and facing us

DF_Header:
    lms r10, (B_SLOT)
    ibt r0, #SL_PAGE
    with r10
    add r0
    lms r0, (F_PAGE)
    from r0
    stw (r10)
    inc r10
    inc r10
    lms r0, (F_TOP)
    from r0
    stw (r10)
    inc r10
    inc r10
    lms r0, (F_PTR)             ; past the last link: the edge cell, then
    ibt r5, #VL_SIZE            ; the next slot
    with r0
    add r5
    from r0
    stw (r10)
    ibt r5, #1

DF_Done:
    lms r11, (F_LINK2)
    GRET
    .DSB 2, $01                 ; cold clipper keeps its previous alignment

; ---------------------------------------------------------------------------
; DF_Clip -- the near-plane path, out of the setup window: clip, project the
; survivors into the slot, then the cycle, the cull and the top by the
; general routines, which the unclipped path has folded into its loop.
; ---------------------------------------------------------------------------

DF_ClipLoad:
    GFCALL DF_LoadClip          ; camera-space inputs are cold-path work
DF_Clip:
    GFCALL ClipNear
    lms r0, (C_M)
    ibt r5, #3
    to r6
    sub r5
    bmi DF_ClipReject           ; fewer than three survivors
    nop
    lms r0, (C_M)
    sms (C_NVERT), r0
    GFCALL ProjectClip          ; into the slot; F_PTR ends past its last link
    GFCALL FaceLinksSet
    GFCALL FaceVisible
    ibt r0, #0
    from r5
    cmp r0
    bmi DF_ClipReject
    nop
    GFCALL FaceTop
    GFJMP DF_Header

DF_ClipReject:
    ibt r5, #0
    GFJMP DF_Done

; ---------------------------------------------------------------------------
; DF_LoadClip -- populate CLIP_A for a face that crosses the near plane.
;
; OTBuild's per-face flag dispatches here before the normal DrawFace loop. A
; near-clipped face needs camera X/Y/Z, UV and (when enabled) shade as
; ClipNear's inputs, so read its three or four packed vertex records into the
; clip buffer here. This path is deliberately outside the setup window's hot
; vertex loop; ordinary faces never touch those fields.
; ---------------------------------------------------------------------------

DF_LoadClip:
    sms (F_LINK5), r11
    lms r6, (R_ROMB)
    from r6
    romb
    lms r14, (F_VROM)
    iwt r9, #CLIP_A
    lms r12, (C_N)
    iwt r13, #@vertex
@vertex:
    ; transformed-vertex address from the packed face
    to r10
    getb
    inc r14
    with r10
    getbh
    inc r14

.IFDEF SHADING
    ; Shade sits before camera space in TV, but after it in a clip vertex.
    ibt r0, #TV_G
    from r10
    to r8
    add r0
    to r5
    ldw (r8)
    ibt r0, #CV_G
    from r9
    to r8
    add r0
    from r5
    stw (r8)
.ENDIF

    ; TV_CX/CY/CZ and CV_X/CV_Y/CV_Z are each contiguous and in the same
    ; order, so both pointers walk instead of recomputing every field.
    ibt r0, #TV_CX
    with r10
    add r0
    to r0
    ldw (r10)
    stw (r9)
    inc r10
    inc r10
    inc r9
    inc r9
    to r0
    ldw (r10)
    stw (r9)
    inc r10
    inc r10
    inc r9
    inc r9
    to r0
    ldw (r10)
    stw (r9)
    inc r9
    inc r9                      ; CV_U

    to r0
    getb                        ; u
    inc r14
    stw (r9)
    inc r9
    inc r9
    to r0
    getb                        ; v
    inc r14
    stw (r9)

    ibt r0, #(CLIP_SIZE - CV_V)
    with r9
    add r0
    loop
    nop

    lms r11, (F_LINK5)
    GRET

; ===========================================================================
; BatchFlush -- rasterize every slot from BATCH_BASE to B_SLOT, in order,
; and empty the batch.
;
; Out of both windows: RasterF and RasterFT anchor the rasterizer's, and the
; setup loop re-anchors its own at the next face. Either rasterizer clobbers
; every register but R3, so the cursor lives in RAM.
; ===========================================================================

BatchFlush:
    sms (B_LINK), r11
    GFCALL EdgePrepBatch        ; every slot's edges, under the edge window
    iwt r0, #BATCH_BASE
    sms (B_CUR), r0

BF_Face:
    lms r10, (B_CUR)
    lms r5, (B_SLOT)
    from r10
    cmp r5
    beq BF_Done
    nop

    ibt r0, #SL_PAGE
    with r10
    add r0
    to r6
    ldw (r10)                   ; the page
    inc r10
    inc r10
    to r9
    ldw (r10)                   ; &VL_Y of the top vertex
    inc r10
    inc r10
    to r5
    ldw (r10)                   ; the next slot
    sms (B_CUR), r5
    ibt r0, #VL_SIZE
    from r5
    to r8
    sub r0                      ; the edge cell before it: the right chain
    to r2
    ldw (r9)                    ; the top Y: the first scanline
    dec r9
    dec r9                      ; the link itself

    iwt r5, #FACE_FLAT
    from r6
    and r5
    beq BF_Texture
    nop

    ; Flat faces used the common setup above. Their low nibble is the final
    ; 4bpp colour, so COLOR followed by RasterF is all the different tail
    ; they need.
    ibt r5, #$0F
    with r6
    and r5
    from r6
    color
    GFCALL RasterF
    bra BF_Face
    nop

BF_Texture:
    ibt r5, #FACE_AKILL
    from r6
    and r5
    bne BF_Keyed
    nop
    ibt r0, #TEXTURE_BANK_BASE
    with r6
    add r0
    GFCALL RasterFT
    bra BF_Face
    nop

BF_Keyed:
    ibt r5, #$3F
    with r6
    and r5
    ibt r0, #TEXTURE_BANK_BASE
    with r6
    add r0
    GFCALL RasterFTA
    GFJMP BF_Face

BF_Done:
    iwt r0, #BATCH_BASE
    sms (B_SLOT), r0
    lms r11, (B_LINK)
    GRET

; ===========================================================================
; EdgePrepBatch -- for every slot in the batch, the edge out of each vertex
; along the chain that will walk it, into the vertex's own cell.
;
; This is EdgeStep, which used to run per edge inside the rasterizer, out of
; every window: 1.6 M cycles of fetch a frame for it and 1.3 M for the copies
; around it. Under a window of its own once per batch it is the same
; arithmetic at cache speed, and EA_Left/EA_Right become copies of a record.
;
; The two chains: from the top vertex, one along prev, one along next, each
; until the next edge would go back up. The first edge of each leaves the
; same vertex, so the right chain's first record goes in the face's edge
; cell -- a copy of the top vertex past the last real one -- and EdgeInit
; starts the right chain there. Where the chains meet at the bottom they
; can both write the bottom cells, and what they write there is a terminator
; or a zero-line hop to one, either of which ends the walk without a line.
;
; The window is the CACHE at EP_Slot, once per slot and free after the
; first; the chain walker, the reciprocal and the step multiply below are
; copies of the rasterizer's so that they sit inside it.
; ===========================================================================

; Scratch, all of it words that are idle while the batch is flushed:
; DrawFace's, FaceVisible's, OTBuild's and the clipper's.
.DEFINE EP_LINK     F_LINK4
.DEFINE EP_CUR      F_COUNT
.DEFINE EP_EXTRA    F_SCR0
.DEFINE EP_TOP      F_SCR1
.DEFINE EC_LINK     F_LINK5
; Direction, output cell, height and record cursor stay in R1, R2, R3 and
; R11. The reciprocal stays in R6, and the two uv words in R12 and R13.

EdgePrepBatch:
    sms (EP_LINK), r11
    iwt r0, #BATCH_BASE
    sms (EP_CUR), r0

EP_Slot:
    cache                       ; the edge window starts here
    lms r10, (EP_CUR)
    lms r5, (B_SLOT)
    from r10
    cmp r5
    bne +
    nop
    lms r11, (EP_LINK)
    GRET

+   ibt r0, #SL_NEXT
    from r10
    to r5
    add r0
    to r5
    ldw (r5)
    sms (EP_CUR), r5            ; the next slot
    ibt r0, #VL_SIZE
    from r5
    to r7
    sub r0                      ; R7 = the edge cell before it
    sms (EP_EXTRA), r7

    ibt r0, #SL_TOP
    from r10
    to r9
    add r0
    to r9
    ldw (r9)
    dec r9
    dec r9                      ; R9 = the top cell
    sms (EP_TOP), r9

    ; the edge cell is the top vertex again: x, g and uv are what the walk
    ; reads from a cell it starts an edge at
    to r0
    ldw (r9)
    from r0
    stw (r7)
.IFDEF SHADING
    ibt r0, #VL_G
    from r9
    to r5
    add r0
    from r7
    to r6
    add r0
    to r0
    ldw (r5)
    from r0
    stw (r6)
.ENDIF
    ibt r0, #VL_UV
    from r9
    to r5
    add r0
    from r7
    to r6
    add r0
    to r0
    ldw (r5)
    from r0
    stw (r6)

    ; the left chain, its first record in the top cell
    move r2, r9
    ibt r0, #VL_PREV
    GFCALL EdgeChain

    ; the right chain, its first record in the edge cell
    lms r9, (EP_TOP)
    lms r2, (EP_EXTRA)
    ibt r0, #VL_NEXT
    GFCALL EdgeChain
    GFJMP EP_Slot

; ---------------------------------------------------------------------------
; EdgeChain -- walk one chain from R9 in the direction R0 (VL_PREV or
; VL_NEXT), writing each vertex's edge into the cell in R2, which is the
; vertex itself after the first.
;
; The arithmetic is EdgeStep's, statement for statement: h = N.y - L.y; for
; two lines and more, 65536/h from the table and the deltas times it, X in
; 16.16 straight out of LMULT, u, v and g in 8.8 through MulRecipE; h = 2
; by arithmetic shift, because the table cannot hold 65536/2.
; ---------------------------------------------------------------------------

EdgeChain:
    sms (EC_LINK), r11
    move r1, r0                 ; VL_PREV/VL_NEXT remains live for the chain

EC_Loop:
    ; N = L + link * VL_SIZE
    from r9
    to r10
    add r1                      ; address of the link byte
    to r5
    ldb (r10)
    ibt r0, #VL_SIZE
    with r5
    mult r0                     ; links are signed bytes and MULT is an 8x8
                                ; signed multiply: link * 32, sign and all,
                                ; where SEX and five doublings stood
    from r9
    to r10
    add r5                      ; R10 = &N

    ; h = N.y - L.y
    ibt r0, #VL_Y
    from r9
    to r6
    add r0
    to r7
    ldw (r6)                    ; R7 = L.y
    from r10
    to r6
    add r0
    to r5
    ldw (r6)                    ; R5 = N.y
    with r5
    sub r7                      ; R5 = h
    bpl EC_Edge
    nop

    ; past the bottom: the walk ends at this vertex
    ibt r0, #E_H
    from r2
    to r6
    add r0
    iwt r0, #$FFFF
    from r0
    stw (r6)
    lms r11, (EC_LINK)
    GRET

EC_Edge:
    move r3, r5                 ; edge height stays live through step setup
    ibt r0, #E_NEXT
    from r2
    to r6
    add r0
    from r10
    stw (r6)                    ; the cell it ends at
    inc r6
    inc r6
    from r5
    stw (r6)                    ; h
    inc r6
    inc r6
    move r11, r6                ; the steps go from here; link is saved in RAM

    ; Zero- and one-line edges never use their steps.
    ibt r0, #2
    from r5
    cmp r0
    bcs EC_Steps                ; h >= 2
    nop
    ibt r0, #0
    from r0
    stw (r6)
    inc r6
    inc r6
    from r0
    stw (r6)
    inc r6
    inc r6
    from r0
    stw (r6)
    inc r6
    inc r6
    from r0
    stw (r6)
    inc r6
    inc r6
    from r0
    stw (r6)
.IFDEF SHADING
    ; The shade the edge starts from, steps or no steps: EA_Take copies it
    ; out of the record with everything else.
    inc r6
    inc r6
    ibt r0, #VL_G
    from r9
    to r5
    add r0
    to r5
    ldw (r5)                    ; L.g
    with r5
    swap                        ; 8.8
.IFDEF SHADE_PIXEL
    with r5
    add r5
    with r5
    add r5                      ; << 2                         ; and the pixel's row in the high byte's bits 4-6
.ENDIF
    from r5
    stw (r6)                    ; E_G0
.ENDIF
    GFJMP EC_Advance

EC_Steps:
    ; R6 = 65536 / h from the table in RAM: an edge taller than the table
    ; is shifted down until it fits and the reciprocal shifted down the
    ; same amount, which is DivTable's arithmetic and the picture's.
    ibt r7, #0                  ; number of normalising shifts
@norm:
    iwt r0, #256
    from r5
    cmp r0
    bcc @fit
    nop
    with r5
    lsr
    inc r7
    bra @norm
    nop
@fit:
    iwt r6, #RECIP_TAB
    with r5
    add r5                      ; index * 2
    with r6
    add r5
    to r6
    ldw (r6)
@scale:
    ibt r0, #0
    from r7
    cmp r0
    beq @have
    nop
    with r6
    lsr
    dec r7
    bra @scale
    nop
@have:
    ; R6 = the reciprocal, and it stays there: nothing below writes R6

    ; dx: 16.16 straight out of LMULT, integer half in R12 and fraction in
    ; R4. h = 2 is special: the table clamps 65536/2 to $7FFF, and a signed
    ; LMULT by that leans every two-line edge by a part in 65536 the wrong
    ; way. Arithmetic shift gives the exact signed high word instead, and CY
    ; selects the $8000 fractional half for odd deltas.
    to r0
    ldw (r10)                   ; R0 = N.x
    to r7
    ldw (r9)                    ; R7 = L.x
    to r7
    sub r7                      ; R7 = N.x - L.x
    ibt r0, #2
    from r3
    cmp r0
    bne EC_XMul
    nop
    from r7
    to r12
    asr
    ibt r4, #0
    bcc EC_XReady
    nop
    iwt r4, #$8000
    bra EC_XReady
    nop

EC_XMul:
    from r7
    to r12
    lmult
EC_XReady:
    ; The record cursor rides in R11 -- EdgeChain saved its link -- and
    ; the two packed uv words in R12 and R13, which nothing calls over.
    from r12
    stw (r11)                   ; dx
    inc r11
    inc r11
    from r4
    stw (r11)                   ; dxf
    inc r11
    inc r11

    ; du and dv, both out of the packed words: (N.u - L.u) * recip >> 8,
    ; which is MulRecipE inline -- LMULT's product across the register and
    ; R4, MERGE on the high bytes of R7 and R8 -- and the same for v.
    ibt r0, #VL_UV
    from r10
    to r5
    add r0
    to r12
    ldw (r5)                    ; R12 = N.uv (LDW's pointer is R0-R11)
    from r9
    to r5
    add r0
    to r13
    ldw (r5)                    ; R13 = L.uv

    from r12
    to r8
    lob                         ; R8 = N.u
    from r13
    lob                         ; R0 = L.u
    with r8
    sub r0                      ; R8 = N.u - L.u
    with r8
    lmult                       ; R8:R4 = delta * recip
    from r8
    to r7
    lob
    with r7
    swap                        ; R7 = (high & $FF) << 8
    move r8, r4
    MERGE_PRODUCT 0
    from r0
    stw (r11)                   ; du
    inc r11
    inc r11

    from r12
    to r8
    hib                         ; R8 = N.v
    from r13
    hib                         ; R0 = L.v
    with r8
    sub r0
    with r8
    lmult
    from r8
    to r7
    lob
    with r7
    swap
    move r8, r4
    MERGE_PRODUCT 0
    from r0
    stw (r11)                   ; dv

.IFDEF SHADING
    inc r11
    inc r11
    ibt r0, #VL_G
    from r10
    to r5
    add r0
    to r8
    ldw (r5)                    ; R8 = N.g
    from r9
    to r5
    add r0
    to r0
    ldw (r5)                    ; R0 = L.g
    with r8
    sub r0
    with r8
    lmult
    from r8
    to r7
    lob
    with r7
    swap
    move r8, r4
    MERGE_PRODUCT 0
.IFDEF SHADE_PIXEL
    ; The Mode 7 shade accumulator carries g << 10 rather than g << 8, so
    ; that its high byte holds the pixel's palette row in bits 4-6 with no
    ; shift in the span loop; the step scales with it.
    with r0
    add r0
    with r0
    add r0                      ; << 2: the GSU has no shift left
.ENDIF
    from r0
    stw (r11)                   ; dg
    inc r11
    inc r11
    ibt r0, #VL_G
    from r9
    to r5
    add r0
    to r5
    ldw (r5)                    ; L.g: the shade the edge starts from
    with r5
    swap
.IFDEF SHADE_PIXEL
    with r5
    add r5
    with r5
    add r5                      ; << 2
.ENDIF
    from r5
    stw (r11)                   ; E_G0
.ENDIF

EC_Advance:
    move r9, r10                ; L = N
    move r2, r10                ; whose own cell takes the next record
    GFJMP EC_Loop

; ===========================================================================
; ClipNear -- Sutherland-Hodgman against z >= ZNEAR.
;
; In:  CLIP_A holds C_N vertices. Out: CLIP_B holds C_M, three to five of them.
; ===========================================================================

ClipNear:
    sms (F_CURSOR), r11
    ; The clipper's window: from here, the edge walk, the intersection,
    ; the lerp, the copy and the projection of what survives are 512
    ; contiguous bytes that ran at ROM speed for every face crossing the
    ; near plane -- 0.9 M cycles of fetch a frame in the opening view once
    ; the camera sat at her side. OTD_Face's CACHE brings the setup window
    ; back for the next face; what runs between is a refill's worth.
    cache
    ibt r0, #0
    sms (C_M), r0
    iwt r0, #CLIP_B
    sms (C_DST), r0
    iwt r10, #CLIP_A
    sms (C_A), r10
    lms r3, (C_N)               ; edges to walk; R3 is nobody's after ClearFrame

    ; A's side of the plane, once: each vertex is B on one edge and A on
    ; the next, and the flag goes round with it.
    ibt r0, #CV_Z
    from r10
    to r5
    add r0
    to r5
    ldw (r5)
    iwt r0, #ZNEAR
    ibt r6, #0
    with r5
    sub r0
    bmi +                       ; behind the plane
    nop
    ibt r6, #1
+   sms (C_AIN), r6

CN_Edge:
    ; B = the next vertex round: A + 16, or the first when A is the last
    lms r10, (C_A)
    ibt r0, #CLIP_SIZE
    with r10
    add r0
    ibt r0, #1
    from r3
    cmp r0
    bne +                       ; not the last edge
    nop
    iwt r10, #CLIP_A
+   sms (C_B), r10

    ibt r0, #CV_Z
    from r10
    to r5
    add r0
    to r5
    ldw (r5)
    iwt r0, #ZNEAR
    ibt r6, #0
    with r5
    sub r0
    bmi +
    nop
    ibt r6, #1
+   sms (C_BIN), r6

    ; A inside: keep it
    lms r0, (C_AIN)
    inc r0
    dec r0
    beq +
    nop
    lms r10, (C_A)
    GFCALL ClipEmit
+
    ; the edge crosses: add the intersection
    lms r0, (C_AIN)
    lms r5, (C_BIN)
    to r6
    sub r5
    beq +
    nop
    GFCALL ClipLerp
+
    ; on to the next edge: B is its A
    lms r0, (C_B)
    sms (C_A), r0
    lms r0, (C_BIN)
    sms (C_AIN), r0
    dec r3
    beq +
    nop
    GFJMP CN_Edge
+   lms r11, (F_CURSOR)
    GRET

; ===========================================================================
; ClipT -- R6 = the intersection parameter, 8.8, for the edge C_A -> C_B.
;
; t = (ZNEAR - a.z) / (b.z - a.z). Both terms are camera Z and can be tens of
; thousands, far past the 256-entry reciprocal table, so numerator and
; denominator are shifted down together until the denominator fits. t is a
; ratio, so that costs nothing but precision in the low bits. And because the
; edge straddles the plane, |num| <= |den| always -- after normalising, the
; numerator fits too.
; ===========================================================================

ClipT:
    sms (C_LINK2), r11

    ibt r0, #CV_Z
    lms r10, (C_A)
    with r10
    add r0
    to r7
    ldw (r10)                   ; a.z

    ibt r0, #CV_Z
    lms r10, (C_B)
    with r10
    add r0
    to r8
    ldw (r10)                   ; b.z

    with r8
    sub r7                      ; den = b.z - a.z
    iwt r0, #ZNEAR
    to r7
    sub r7                      ; num = ZNEAR - a.z

    ; keep the denominator positive; the ratio is unchanged
    ibt r0, #0
    from r8
    to r6
    sub r0
    bpl CT_Norm
    nop
    with r8
    not
    inc r8
    with r7
    not
    inc r7

CT_Norm:
    iwt r0, #256
    from r8
    cmp r0
    bcc CT_Ready
    nop
    with r8
    lsr
    with r7
    lsr
    bra CT_Norm
    nop

CT_Ready:
    ibt r0, #0
    from r8
    cmp r0
    bne +
    nop
    ibt r8, #1                  ; a coincident pair; anything finite will do
+   ; 65536 / den from the table in RAM -- den is 1..255 by now -- and
    ; num * that >> 8: MulRecip inline, LMULT's product across R9 and R4,
    ; MERGE on the high bytes of R7 and R8.
    iwt r6, #RECIP_TAB
    from r8
    to r5
    add r8                      ; den * 2
    with r6
    add r5
    to r6
    ldw (r6)                    ; R6 = 65536 / den
    from r7
    to r9
    lmult                       ; R9:R4 = num * recip
    from r9
    to r7
    lob
    with r7
    swap
    move r8, r4
    MERGE_PRODUCT 6
    lms r11, (C_LINK2)
    GRET

; ===========================================================================
; ClipEmit -- copy the vertex at R10 into CLIP_B[C_M], every component of it.
; ===========================================================================

ClipEmit:
    lms r8, (C_DST)
    ibt r12, #CLIP_COMPS
    ; No CACHE. This runs per clipped vertex, in the middle of drawing, and
    ; CBR belongs to the rasterizer's window by then; six iterations could
    ; never repay flushing it.
    iwt r13, #CE_Loop
CE_Loop:
    to r5
    ldw (r10)
    from r5
    stw (r8)
    inc r10
    inc r10
    inc r8
    loop
    inc r8                      ; safe one-byte delay slot, including final copy

    ibt r0, #(CLIP_SIZE - CLIP_COMPS * 2)
    with r8
    add r0                      ; the next vertex slot
    sms (C_DST), r8
    lms r0, (C_M)
    inc r0
    sms (C_M), r0
    GRET

; ===========================================================================
; ClipLerp -- emit the point where C_A -> C_B crosses the near plane.
;
; Every component interpolates the same way, U, V and the shade included: the
; texture coordinate at the new vertex is what keeps the clipped face's mapping
; continuous with its unclipped neighbours, and the shade is what keeps its
; brightness continuous with them.
; ===========================================================================

ClipLerp:
    sms (C_LINK), r11
    GFCALL ClipT                ; R6 = t, and it stays there: nothing below
                                ; writes R6

    lms r9, (C_A)
    lms r10, (C_B)
    lms r11, (C_DST)            ; no calls in the component loop
    ibt r12, #CLIP_COMPS
    iwt r13, #CL_Comp

CL_Comp:
    to r5
    ldw (r9)                    ; a component
    to r0
    ldw (r10)                   ; b component
    to r8
    sub r5                      ; delta
    with r8
    lmult                       ; R8:R4 = delta * t; MulRecip inline
    from r8
    to r7
    lob
    with r7
    swap
    move r8, r4
    MERGE_PRODUCT 0
    with r5
    add r0                      ; a + delta * t
    from r5
    stw (r11)
    inc r11
    inc r11

    inc r9
    inc r9
    inc r10
    loop
    inc r10                     ; safe one-byte delay slot, including final comp

    ; C_DST has walked CLIP_COMPS words; leave it on the next vertex slot
    ibt r0, #(CLIP_SIZE - CLIP_COMPS * 2)
    with r11
    add r0
    sms (C_DST), r11
    lms r0, (C_M)
    inc r0
    sms (C_M), r0

    lms r11, (C_LINK)
    GRET

; ===========================================================================
; ProjectClip -- project CLIP_B into the face's VertexLinks.
; ===========================================================================

ProjectClip:
    sms (C_LINK), r11
    iwt r10, #CLIP_B
    lms r8, (B_SLOT)
    lms r12, (C_M)
    iwt r13, #PC_Vertex

PC_Vertex:
    ; R10 walks the clip vertex, R8 the VertexLink; the projection is
    ; TM_Vertex's, in registers, where it used to be a call to ProjectPoint
    ; out of every window with its operands through RAM.
    to r9
    ldw (r10)                   ; camera X
    inc r10
    inc r10
    to r11
    ldw (r10)                   ; camera Y
    inc r10
    inc r10
    to r3
    ldw (r10)                   ; camera Z; R3 is nobody's after ClearFrame

    from r3
    to r5
    hib
    with r5
    add r5                      ; dz = (z >> 8) * 2: at least 2, every
                                ; vertex here being at or past the plane
.IFDEF FX3
    ; The plane is ZNEAR: a vertex short of ZMIN (dz < 4) is PC_Near's, at
    ; the end. Same 15 bytes as the dz clamp it replaces, which never fired:
    ; z is a positive word, so dz is at most 254.
    from r5
    sub #4
    bpl +
    nop
    iwt r15, #PC_Near
    nop
    .DB $01, $01
+   iwt r6, #M7_PROJTAB
.ELSE
    iwt r0, #255
    from r5
    cmp r0
    bcc +                       ; dz < 255
    nop
    iwt r5, #255
+   iwt r6, #M7_PROJTAB
.ENDIF
    with r5
    add r5
    with r6
    add r5
    to r6
    ldw (r6)                    ; R6 = 65536 / dz
    from r9
    to r5
    fmult
    iwt r0, #SCREEN_CX
    with r5
    add r0
    from r5
    stw (r8)                    ; VL_X
    inc r8
    inc r8
    from r11
    to r5
    fmult
    lms r0, (FR_CY)             ; the sheared centre line
    with r5
    add r0
    from r5
    stw (r8)                    ; VL_Y

PC_Stored:

    ; u and v travel as separate words in the clip buffer, packed for the
    ; link. A byte each: a kept vertex's came out of the packed word, and
    ; a lerp between two bytes at a t of at most one stays between them.
    inc r10
    inc r10
    to r5
    ldw (r10)                   ; CV_U
    inc r10
    inc r10
    to r0
    ldw (r10)                   ; CV_V
    with r0
    swap                        ; v << 8
    to r5
    or r5                       ; OR takes r1-r15: R5 = (v << 8) | u
    ibt r0, #(VL_UV - VL_Y)
    with r8
    add r0
    from r5
    stw (r8)                    ; VL_UV

.IFDEF SHADING
    inc r10
    inc r10
    to r5
    ldw (r10)                   ; CV_G
    ibt r0, #(VL_G - VL_UV)
    from r8
    to r6
    add r0
    from r5
    stw (r6)                    ; VL_G
    ibt r0, #(CLIP_SIZE - CV_G)
.ELSE
    ibt r0, #(CLIP_SIZE - CV_V)
.ENDIF
    with r10
    add r0                      ; the next clip vertex
    ibt r0, #(VL_SIZE - VL_UV)
    with r8
    add r0                      ; and the next link
    loop
    nop
    sms (F_PTR), r8             ; past the last link, for the edge cell
    lms r11, (C_LINK)
    GRET

; ===========================================================================
; FaceLinksSet -- write the prev/next bytes of a C_NVERT-vertex cycle.
;
; Was a fixed four, written once. The clipper produces three to five vertices,
; so the cycle has to be built per face:
;
;   first  prev = N-1   next = +1
;   middle prev = -1    next = +1
;   last   prev = -1    next = -(N-1)
; ===========================================================================

FaceLinksSet:
    ; Only two of the words vary. Every vertex between the first and the last
    ; has prev = -1 and next = +1 whatever the count; the first wraps back to
    ; the last and the last wraps forward to the first. Deriving all of them
    ; per vertex, which is what this did, cost 188 instructions a face to
    ; write four bytes that were never going to be anything else.
    sms (C_LINK), r11

    lms r10, (B_SLOT)
    ibt r0, #VL_PREV
    with r10
    add r0

    ; first: prev = N-1, next = +1
    lms r7, (C_NVERT)
    dec r7                      ; keep N-1 for the middle count and last link
    iwt r6, #$0100
    from r7
    to r5
    or r6
    from r5
    stw (r10)

    ; middle: N-2 of them, all identical
    move r12, r7
    dec r12
    beq FLS_Last
    nop

    ; No CACHE. Two iterations for a quad, and CBR belongs to the rasterizer's
    ; window by the time this runs -- anchoring here would flush it once a face.
    iwt r5, #$01FF
    iwt r13, #FLS_Loop
FLS_Loop:
    ibt r0, #VL_SIZE
    with r10
    add r0
    from r5
    stw (r10)
    loop
    nop

FLS_Last:
    ; last: prev = -1, next = -(N-1)
    ibt r0, #VL_SIZE
    with r10
    add r0
    move r5, r7
    with r5
    not
    inc r5
    iwt r6, #$00FF
    with r5
    and r6
    with r5
    swap
    iwt r6, #$00FF
    with r5
    or r6
    from r5
    stw (r10)

    lms r11, (C_LINK)
    GRET

; ===========================================================================
; FaceVisible -- R5 = the sign of the screen-space cross product of the face
; in the slot at B_SLOT.
;
; (x1-x0)(y2-y0) - (x2-x0)(y1-y0), evaluated in 32 bits because the deltas
; are screen pixels and their product overflows a word long before the sign
; stops being meaningful. Clobbers R1 and R2, which DrawFace has finished
; with by the time this runs.
; ===========================================================================

FaceVisible:
    sms (F_LINK5), r11

    lms r10, (B_SLOT)
    to r1
    ldw (r10)                   ; x0
    inc r10
    inc r10
    to r2
    ldw (r10)                   ; y0
    ibt r0, #(VL_SIZE - 2)
    with r10
    add r0
    to r7
    ldw (r10)                   ; x1
    inc r10
    inc r10
    to r8
    ldw (r10)                   ; y1
    ibt r0, #(VL_SIZE - 2)
    with r10
    add r0
    to r9
    ldw (r10)                   ; x2
    inc r10
    inc r10
    to r6
    ldw (r10)                   ; y2

    with r6
    sub r2                      ; b = y2 - y0
    with r7
    sub r1                      ; a = x1 - x0
    from r7
    to r5
    lmult                       ; R5:R4 = a * b
    move r12, r4               ; keep the first product in registers

    from r8
    to r6
    sub r2                      ; d = y1 - y0
    from r9
    to r7
    sub r1                      ; c = x2 - x0
    from r7
    to r9
    lmult                       ; R9:R4 = c * d

    with r12
    sub r4                      ; low word, CY = no borrow
    with r5
    sbc r9                      ; high word with the borrow

    ; A zero-area face has to go the same way as a back-facing one: it is what
    ; a floor seen exactly edge-on produces, and the rasterizer's edge walk
    ; never terminates on one.
    ibt r0, #0
    from r5
    cmp r0
    bne +
    nop
    from r12
    cmp r0
    bne +
    nop
    iwt r5, #$FFFF              ; call it back-facing
+
    lms r11, (F_LINK5)
    GRET

; ===========================================================================
; FaceTop -- find the topmost link of the slot at B_SLOT.
;
; Out: F_TOP = the address of its VL_Y word. The unclipped path finds this in
; DM_Vertex as the vertices go by; this is for the clipper's, whose links
; ProjectClip wrote.
; ===========================================================================

FaceTop:
    lms r10, (B_SLOT)
    inc r10
    inc r10                     ; &VL_Y of the first link
    sms (F_TOP), r10
    to r4
    ldw (r10)
    lms r3, (C_NVERT)
    dec r3                      ; candidates after the first; no calls below

FT_Loop:
    ibt r0, #VL_SIZE
    with r10
    add r0
    to r5
    ldw (r10)                   ; candidate Y

    ; A sign test of the subtraction rather than a signed branch: see GBLT in
    ; gsu.inc for the manual's swapped BLT/BGE opcodes.
    from r5
    to r6
    sub r4                      ; candidate - current top
    bpl +                       ; candidate is lower down the screen, keep
    dec r3                      ; common one-byte delay slot and loop counter
    move r4, r5
    sms (F_TOP), r10

+
    bne FT_Loop
    nop
    GRET

; ===========================================================================
; Sine table and model geometry, generated by tools/mkmodel.py. Kept in this
; bank so ROMBR does not have to move between reading code-adjacent tables and
; reading the model.
; ===========================================================================

ModelData:
    .INCBIN "model.bin"


.ENDS

.IFDEF FX3
.SECTION "inventory" FREE
; ===========================================================================
; FrameBody -- what frame.gsu's entry draws between its setup and the C2P:
; the inventory's ring while GS_INV has items, else the clear and the rooms.
; Here, after everything else, so that nothing before it moved.
; ===========================================================================

FrameBody:
    sm (INV_LINK), r11
    iwt r0, #$FFFF              ; every node of every model, but a ring item's
    sm (MD_VIS), r0             ; (InvRender, from its record)
    ; The projection's reciprocals: RECIP_TAB's own for the game, doubled
    ; (clamped to the signed word the FMULTs read) for the inventory, whose
    ; matrices the host scales across by 23/32 to meet upstream's framing.
    ; Rewritten only when the kind of frame changes -- PROJ_MODE carries a
    ; tag, as game pak RAM comes up undefined -- and without a CACHE, which
    ; would take RoomsRender out of the window RT_Loop left it in.
    iwt r10, #GS_INV
    to r0
    ldw (r10)
    sm (INV_N), r0
    iwt r6, #PROJ_GAME
    ibt r5, #0
    from r0
    cmp r5
    beq +
    nop
    iwt r6, #PROJ_INV
+   lm r0, (PROJ_MODE)
    from r0
    cmp r6
    beq FB_Ready
    nop
    from r6
    sm (PROJ_MODE), r6
    iwt r10, #RECIP_TAB
    iwt r9, #M7_PROJTAB
    iwt r12, #256
    iwt r13, #FB_Fill
FB_Fill:
    to r0
    ldw (r10)
    iwt r5, #PROJ_INV
    from r6
    cmp r5
    bne ++
    nop
    with r0
    add r0
    bvc ++
    nop
    iwt r0, #32767
++  from r0
    stw (r9)
    inc r10
    inc r10
    inc r9
    loop
    inc r9
FB_Ready:
    lm r0, (INV_N)
    ibt r5, #0
    from r0
    cmp r5
    bne FB_Inv
    nop
    ibt r0, #0                  ; the next ring captures this frame
    sm (BG_STATE), r0
    GFCALL ClearFrame
    GFCALL RoomsRender
    ; drawFPS (settings.c): any text the host left for a game frame. Tested
    ; here, not in TextRender, whose CACHE would move RoomsRender's window.
    lm r0, (GS_TEXT)
    ibt r5, #0
    from r0
    cmp r5
    beq +
    nop
    GFCALL TextRender
+   lm r11, (INV_LINK)
    GRET
FB_Inv:
    GFCALL InvNear              ; InvRender, NK_MASK cleared
    GFCALL RectRender
    GFCALL TextRender
    lm r11, (INV_LINK)
    GRET

; ===========================================================================
; InvRender -- the inventory: per ring item, the host's finished model-view
; matrix (inventory_draw.c, upstream's drawPage) into M_00..M_TZ and the
; model drawn under it, on the whole frame. No rooms, no shear.
; ===========================================================================

InvRender:
    sm (FR_LINK), r11
    ; The background: upstream's copyBackground, the game's last frame in
    ; eight greys, captured on the ring's first frame (BgCapture) and
    ; plotted back under every one after it, line by line from BG_BUF.
    ; Without the font's remap (no FONT.BIN), black: index $80, the sprite
    ; palettes' colour 0.
    lm r0, (GS_TEXT + 4)
    ibt r5, #0
    from r0
    cmp r5
    bne IR_Grey
    nop
    iwt r0, #$80
    color
    ibt r2, #0
IR_Line:
    ibt r1, #0
    iwt r12, #FRAME_WIDTH
    iwt r13, #IR_Pix
    cache
IR_Pix:
    loop
    plot
    inc r2
    iwt r0, #FRAME_HEIGHT
    from r2
    cmp r0
    bne IR_Line
    nop
    bra IR_Set
    nop
IR_Grey:
    lm r0, (BG_STATE)
    ibt r5, #1
    from r0
    cmp r5
    beq +
    nop
    GFCALL BgCapture
    ibt r0, #1
    sm (BG_STATE), r0
+   iwt r10, #BG_BUF
    ibt r2, #0
IR_GLine:
    ibt r1, #0
    iwt r12, #FRAME_WIDTH
    iwt r13, #IR_GPix
    cache
IR_GPix:
    ldb (r10)
    inc r10
    color
    loop
    plot
    inc r2
    iwt r0, #FRAME_HEIGHT
    from r2
    cmp r0
    bne IR_GLine
    nop
IR_Set:
    ibt r0, #0
    sms (V_CLIPX0), r0
    sms (V_CLIPY0), r0
    sms (R_NOTFULL), r0
    sms (MD_CULL), r0
    sm (MX_SP), r0
    iwt r0, #FRAME_WIDTH
    sms (V_CLIPX1), r0
    iwt r0, #FRAME_HEIGHT
    sms (V_CLIPY1), r0
    iwt r0, #SCREEN_CY
    sm (FR_CY), r0
    iwt r0, #$FF                ; no entity slot: not Lara's weapon channel
    sms (IT_NODES), r0
    iwt r10, #GS_INV
    to r0
    ldw (r10)
    iwt r5, #$7FFF              ; the count, without INV_GSU_FRAME (an END page's)
    with r0
    and r5
    sm (INV_N), r0
    iwt r0, #(GS_INV + 2)
    sm (INV_P), r0
IR_Item:
    lm r0, (INV_N)
    ibt r5, #0
    from r0
    cmp r5
    bne +
    nop
    lm r11, (FR_LINK)
    GRET
+   dec r0
    sm (INV_N), r0
    lm r10, (INV_P)
    iwt r9, #M_00_BYTE
    ibt r12, #12
    iwt r13, #IR_Copy
IR_Copy:
    to r0
    ldw (r10)
    from r0
    stw (r9)
    inc r10
    inc r10
    inc r9
    inc r9
    loop
    nop
    to r0
    ldw (r10)                   ; the model's stream
    sms (MD_ROM), r0
    inc r10
    inc r10
    to r0
    ldw (r10)                   ; its bank, relative to the level's
    ibt r6, #LEVEL_BANK_BASE
    with r0
    add r6
    sms (MD_ROMB), r0
    inc r10
    inc r10
    to r0
    ldw (r10)                   ; its pose: animation, frame << 8
    sms (MD_PHASE), r0
    inc r10
    inc r10
    to r0
    ldw (r10)                   ; upstream's itemVisMask (the passport's pages)
    sm (MD_VIS), r0
    lm r0, (INV_P)
    ibt r6, #32
    with r0
    add r6
    sm (INV_P), r0
    GFCALL DrawModel
    GFJMP IR_Item

; ===========================================================================
; BgCapture -- upstream's copyBackground and palGrayRemap: the frame the
; game drew last is still in the plot buffer (the ring's frames skip the
; clear), so RPIX reads it back a pixel at a time, and the packer's remap
; (FONT.BIN; in the glyphs' bank) turns each into one of eight greys, $B0-
; $B7, stored in BG_BUF. Once an opening: a million cycles, one frame.
; ===========================================================================

BgCapture:
    lm r0, (GS_TEXT + 2)        ; the font's bank, relative to the level's
    ibt r6, #LEVEL_BANK_BASE
    with r0
    add r6
    romb
    lm r9, (GS_TEXT + 4)        ; the remap
    iwt r10, #BG_BUF
    ibt r2, #0
BC_Line:
    ibt r1, #0
    iwt r12, #FRAME_WIDTH
    iwt r13, #BC_Pix
    cache
BC_Pix:
    rpix                        ; the game's pixel at (R1, R2)
    to r14
    add r9                      ; its remap entry: the ROM buffer starts
    getb
    stb (r10)
    inc r10
    loop
    inc r1
    inc r2
    iwt r0, #FRAME_HEIGHT
    from r2
    cmp r0
    bne BC_Line
    nop
    GRET

; ===========================================================================
; ItemTilt -- after DrawRoomItems' yaw, before the model: the entity's
; shadow, if GS_SHADOW has a record for its slot (ShadowRender, on the
; floor, under it); and for her, X by GS_ITEM byte 11, then Z by GS_ROLL,
; each only when it is not zero -- upstream's matrixRotateYXZ.
; ===========================================================================

ItemTilt:
    sm (TILT_LINK), r11
    lm r8, (GS_SHADOW)
    ibt r0, #0
    from r8
    cmp r0
    beq TL_Tilt
    nop
    lm r9, (IT_SLOT)
    iwt r10, #(GS_SHADOW + 6)
TL_Find:
    to r0
    ldw (r10)
    from r0
    cmp r9
    beq TL_Found
    nop
    ibt r0, #12
    with r10
    add r0
    dec r8
    bne TL_Find
    nop
    bra TL_Tilt
    nop
TL_Found:
    sm (SH_REC), r10
    GFCALL ShadowRender
TL_Tilt:
    lm r0, (IT_SLOT)            ; hers alone from here
    iwt r5, #GS_ITEM
    from r0
    cmp r5
    beq +
    nop
    lm r11, (TILT_LINK)
    GRET
+   iwt r10, #(GS_ITEM + 11)
    to r0
    ldb (r10)
    ibt r5, #0
    from r0
    cmp r5
    beq +
    nop
    GFCALL MatrixRotateX
+   iwt r10, #GS_ROLL
    to r0
    ldb (r10)
    ibt r5, #0
    from r0
    cmp r5
    beq +
    nop
    GFCALL MatrixRotateZ
+   lm r11, (TILT_LINK)
    GRET

; ===========================================================================
; ShadowRender -- upstream's renderShadow for the record at SH_REC: its
; octagon, x +- sx or 2 sx and z +- 2 sz or sz round the box's middle, at
; the floor's depth below the entity, through its matrix (before her pitch
; and lean), projected, and every pixel inside it darkened -- RPIX, the
; font's second remap, PLOT -- inside the room's clip rectangle.
; The renderer takes its reciprocal at 256-unit steps of depth and its
; view's pitch is a shear, so a patch of floor that small, projected the
; renderer's way, is a line or a step; the corners are projected exactly
; instead (ShadowProject) and the whole moved to where the renderer puts
; the octagon's centre -- under her feet, which it projected the same way.
; Each edge is walked into the lines' left and right (SH_XL/SH_XR):
; x = x0 + 2 FMULT(dx, t (32768 / dy)), from RECIP_TAB. A corner at or
; behind the near plane, or an edge taller than the table, and there is
; no shadow this frame.
; ===========================================================================

ShadowRender:
    sm (SH_LINK), r11
    lm r10, (SH_REC)
    inc r10
    inc r10
    to r0
    ldw (r10)                   ; the floor's depth
    sms (T_Y), r0
    inc r10
    inc r10
    to r1
    ldw (r10)                   ; x
    inc r10
    inc r10
    to r2
    ldw (r10)                   ; z
    inc r10
    inc r10
    to r5
    ldw (r10)                   ; sx
    inc r10
    inc r10
    to r6
    ldw (r10)                   ; sz
    from r5
    to r7
    add r5                      ; 2 sx
    from r6
    to r8
    add r6                      ; 2 sz
    ; renderShadow's corners, in order round it
    iwt r10, #SH_CORN
    from r1
    to r0
    sub r5
    stw (r10)                   ; x - sx, z + 2 sz
    inc r10
    inc r10
    from r2
    to r0
    add r8
    stw (r10)
    inc r10
    inc r10
    from r1
    to r0
    add r5
    stw (r10)                   ; x + sx, z + 2 sz
    inc r10
    inc r10
    from r2
    to r0
    add r8
    stw (r10)
    inc r10
    inc r10
    from r1
    to r0
    add r7
    stw (r10)                   ; x + 2 sx, z + sz
    inc r10
    inc r10
    from r2
    to r0
    add r6
    stw (r10)
    inc r10
    inc r10
    from r1
    to r0
    add r7
    stw (r10)                   ; x + 2 sx, z - sz
    inc r10
    inc r10
    from r2
    to r0
    sub r6
    stw (r10)
    inc r10
    inc r10
    from r1
    to r0
    add r5
    stw (r10)                   ; x + sx, z - 2 sz
    inc r10
    inc r10
    from r2
    to r0
    sub r8
    stw (r10)
    inc r10
    inc r10
    from r1
    to r0
    sub r5
    stw (r10)                   ; x - sx, z - 2 sz
    inc r10
    inc r10
    from r2
    to r0
    sub r8
    stw (r10)
    inc r10
    inc r10
    from r1
    to r0
    sub r7
    stw (r10)                   ; x - 2 sx, z - sz
    inc r10
    inc r10
    from r2
    to r0
    sub r6
    stw (r10)
    inc r10
    inc r10
    from r1
    to r0
    sub r7
    stw (r10)                   ; x - 2 sx, z + sz
    inc r10
    inc r10
    from r2
    to r0
    add r6
    stw (r10)
    sms (T_X), r1               ; the centre, both ways
    sms (T_Z), r2
    GFCALL TransformPoint
    GFCALL ShadowCentre         ; ProjectPoint, and 64..511 as TM_Near
    lms r0, (T_REJECT)
    ibt r5, #0
    from r0
    cmp r5
    beq +
    nop
    GFJMP SH_Done
+   GFCALL ShadowProjectFx      ; ShadowProject, and 64..511 as TM_Near
    bne +                       ; past the table: none
    nop
    GFJMP SH_Done
+   lms r0, (T_SX)
    with r0
    sub r1
    sm (SH_OFFX), r0
    lms r0, (T_SY)
    with r0
    sub r2
    sm (SH_OFFY), r0
    iwt r0, #SH_CORN
    sm (SH_SRC), r0
    iwt r0, #SH_PTS
    sm (SH_DST), r0
    ibt r0, #8
    sm (SH_N), r0
SH_Vtx:
    lm r10, (SH_SRC)
    to r0
    ldw (r10)
    sms (T_X), r0
    inc r10
    inc r10
    to r0
    ldw (r10)
    sms (T_Z), r0
    inc r10
    inc r10
    sm (SH_SRC), r10
    GFCALL TransformPoint
    iwt r0, #ZNEAR              ; at or behind the near plane: none
    lms r5, (T_CZ)
    from r5
    cmp r0
    bge +
    nop
    GFJMP SH_Done
+   GFCALL ShadowProjectFx
    bne +
    nop
    GFJMP SH_Done
+   lm r10, (SH_DST)
    lm r0, (SH_OFFX)
    with r0
    add r1
    stw (r10)
    inc r10
    inc r10
    lm r0, (SH_OFFY)
    with r0
    add r2
    stw (r10)
    inc r10
    inc r10
    sm (SH_DST), r10
    lm r0, (SH_N)
    dec r0
    sm (SH_N), r0
    beq +
    nop
    GFJMP SH_Vtx
+
    ; the lines it covers, inside the clip rectangle
    iwt r10, #(SH_PTS + 2)
    iwt r7, #$7FFF
    iwt r8, #$8000
    ibt r12, #8
    iwt r13, #SH_MinMax
SH_MinMax:
    to r0
    ldw (r10)
    from r0
    cmp r7
    bge +
    nop
    move r7, r0
+   from r0
    cmp r8
    blt +
    nop
    move r8, r0
+   inc r10
    inc r10
    inc r10
    loop
    inc r10
    lms r0, (V_CLIPY0)
    from r7
    cmp r0
    bge +
    nop
    move r7, r0
+   lms r0, (V_CLIPY1)
    dec r0
    from r8
    cmp r0
    blt +
    nop
    move r8, r0
+   from r8
    cmp r7
    bge +
    nop
    GFJMP SH_Done
+   sm (SH_YMIN), r7
    sm (SH_YMAX), r8
    ; every line's span empty
    from r8
    to r12
    sub r7
    inc r12
    from r7
    to r0
    add r7
    iwt r10, #SH_XL
    with r10
    add r0
    iwt r9, #SH_XR
    with r9
    add r0
    iwt r5, #$7FFF
    iwt r6, #$8000
    iwt r13, #SH_Init
SH_Init:
    from r5
    stw (r10)
    inc r10
    inc r10
    from r6
    stw (r9)
    inc r9
    loop
    inc r9

    ; the eight edges into it
    iwt r0, #SH_PTS
    sm (SH_SRC), r0
    ibt r0, #8
    sm (SH_N), r0
SH_Edge:
    lm r10, (SH_SRC)
    to r1
    ldw (r10)                   ; x0
    inc r10
    inc r10
    to r2
    ldw (r10)                   ; y0
    inc r10
    inc r10
    sm (SH_SRC), r10
    lm r0, (SH_N)
    ibt r5, #1
    from r0
    cmp r5
    bne +
    nop
    iwt r10, #SH_PTS            ; the last edge closes on the first corner
+   to r5
    ldw (r10)                   ; x1
    inc r10
    inc r10
    to r9
    ldw (r10)                   ; y1
    from r2
    cmp r9
    bne +
    nop
    GFJMP SH_EdgeNext           ; level: no line of its own
+   blt +
    nop
    move r0, r1                 ; top first
    move r1, r5
    move r5, r0
    move r0, r2
    move r2, r9
    move r9, r0
+   sm (SH_Y0), r2
    from r9
    to r0
    sub r2                      ; dy
    iwt r7, #256
    from r0
    cmp r7
    blt +
    nop
    GFJMP SH_Done
+   with r0
    add r0
    iwt r7, #RECIP_TAB
    with r7
    add r0
    to r7
    ldw (r7)
    with r7
    lsr                         ; 32768 / dy
    with r5
    sub r1                      ; dx
    lm r8, (SH_YMIN)            ; from max(y0, ymin)
    from r2
    cmp r8
    blt +
    nop
    move r8, r2
+   dec r9                      ; to min(y1 - 1, ymax)
    lm r0, (SH_YMAX)
    from r9
    cmp r0
    blt +
    nop
    move r9, r0
+   from r9
    to r12
    sub r8
    bpl +
    inc r12
    GFJMP SH_EdgeNext
+   from r8
    to r0
    add r8
    iwt r10, #SH_XL
    with r10
    add r0
    iwt r11, #SH_XR
    with r11
    add r0
    iwt r13, #SH_EY
SH_EY:
    lm r0, (SH_Y0)
    from r8
    sub r0                      ; t = y - y0
    move r6, r7
    lmult                       ; R4 = t (32768 / dy), below 32768
    move r6, r4
    from r5
    fmult                       ; dx t / dy / 2
    with r0
    add r0
    with r0
    add r1                      ; x
    to r9
    ldw (r10)
    from r0
    cmp r9
    bge +
    nop
    from r0
    stw (r10)
+   to r9
    ldw (r11)
    from r0
    cmp r9
    blt +
    nop
    from r0
    stw (r11)
+   inc r10
    inc r10
    inc r11
    inc r11
    loop
    inc r8
SH_EdgeNext:
    lm r0, (SH_N)
    dec r0
    sm (SH_N), r0
    beq +
    nop
    GFJMP SH_Edge
+
    ; and every line's span darkened
    lm r0, (GS_SHADOW + 2)      ; the font's bank, where the remap is
    ibt r6, #LEVEL_BANK_BASE
    with r0
    add r6
    romb
    lm r9, (GS_SHADOW + 4)
    lm r2, (SH_YMIN)
SH_Span:
    from r2
    to r10
    add r2
    iwt r0, #SH_XL
    from r10
    to r5
    add r0
    iwt r0, #SH_XR
    with r10
    add r0
    to r1
    ldw (r5)
    to r7
    ldw (r10)
    lms r0, (V_CLIPX0)
    from r1
    cmp r0
    bge +
    nop
    move r1, r0
+   lms r0, (V_CLIPX1)
    dec r0
    from r7
    cmp r0
    blt +
    nop
    move r7, r0
+   from r7
    to r12
    sub r1
    bmi SH_SpanNext
    inc r12
    iwt r13, #SH_Pix
SH_Pix:
    rpix
    to r14
    add r9
    getb
    color
    loop
    plot
SH_SpanNext:
    inc r2
    lm r0, (SH_YMAX)
    from r0
    cmp r2
    bge SH_Span
    nop
SH_Done:
    lm r11, (SH_LINK)
    GRET

; T_CX/T_CY/T_CZ to the screen in R1/R2, at the exact depth: RECIP_TAB
; (65536 / i) between i = z >> 7 and the next, z & 127 of the way. Z comes
; back clear when z is past the table's last step.
ShadowProject:
    lms r0, (T_CZ)
    from r0
    to r5
    hib
    with r5
    add r5                      ; (z >> 8) * 2
    iwt r6, #$80
    from r0
    to r4
    and r6
    beq +
    nop
    inc r5                      ; i = z >> 7
+   iwt r6, #255
    from r5
    cmp r6
    bcc +
    nop
    ibt r0, #1
    dec r0                      ; Z set: too far to shade
    GRET
+   iwt r6, #$7F
    from r0
    to r7
    and r6
    with r7
    swap                        ; (z & 127) << 8, a fraction in 1.15
    from r5
    to r6
    add r5
    iwt r0, #RECIP_TAB
    with r6
    add r0
    to r8
    ldw (r6)                    ; 65536 / i
    inc r6
    inc r6
    to r9
    ldw (r6)                    ; 65536 / (i + 1)
    from r8
    to r0
    sub r9
    move r6, r7
    fmult                       ; the step times the fraction, halved
    with r0
    add r0
    from r8
    to r6
    sub r0                      ; R6 = 65536 / (z / 128)
    lms r0, (T_CX)
    fmult
    iwt r1, #SCREEN_CX
    with r1
    add r0
    lms r0, (T_CY)
    fmult
    lm r2, (FR_CY)
    with r2
    add r0
    ibt r0, #0
    inc r0                      ; Z clear
    GRET

; ===========================================================================
; RectRender -- the options' box (inventory_text.c drawOptions): upstream's
; renderFill and renderLine. GS_RECT: a count, then per rectangle x, y, w,
; h, a colour and a pad (bytes). Colour 0 is renderFill's shade: every pixel
; read back (RPIX) and darkened through the packer's second remap.
; ===========================================================================

RectRender:
    cache
    iwt r10, #GS_RECT
    to r8
    ldw (r10)                   ; rectangles
    inc r10
    inc r10
    ibt r0, #0
    from r8
    cmp r0
    beq RX_Done
    nop
    lm r0, (GS_TEXT + 2)        ; the font's bank, where the remap is
    ibt r6, #LEVEL_BANK_BASE
    with r0
    add r6
    romb
    lm r9, (GS_TEXT + 6)        ; the darkening remap
RX_Rect:
    to r7
    ldb (r10)                   ; x
    inc r10
    to r2
    ldb (r10)                   ; y
    inc r10
    to r5
    ldb (r10)                   ; w
    inc r10
    to r6
    ldb (r10)                   ; h
    inc r10
    ldb (r10)                   ; the colour
    inc r10
    inc r10
    ibt r4, #0
    from r0
    cmp r4
    beq RX_Dark
    nop
    color
RX_SRow:
    move r1, r7
    move r12, r5
    iwt r13, #RX_SPix
RX_SPix:
    loop
    plot
    inc r2
    dec r6
    bne RX_SRow
    nop
    bra RX_Next
    nop
RX_Dark:
    move r1, r7
    move r12, r5
    iwt r13, #RX_DPix
RX_DPix:
    rpix
    to r14
    add r9
    getb
    color
    loop
    plot
    inc r2
    dec r6
    bne RX_Dark
    nop
RX_Next:
    dec r8
    bne RX_Rect
    nop
RX_Done:
    GRET

; ===========================================================================
; TextRender -- the host's glyphs (inventory_text.c): upstream's drawText,
; laid out and clipped on the host, each glyph a trimmed block of pixel
; bytes in the level's ROM (packer buildFont). GETC under a frozen high
; nibble -- $A0, sprite palette 2, FONT.BIN's colours -- with transparency
; on, so that a zero byte leaves the frame as it was. GS_TEXT: a count, the
; font's GSU bank, the two remaps' addresses, then per glyph x, y, its
; address, w and h (bytes).
; ===========================================================================

TextRender:
    cache
    iwt r10, #GS_TEXT
    to r8
    ldw (r10)                   ; glyphs
    inc r10
    inc r10
    ibt r0, #0
    from r8
    cmp r0
    beq TX_Done
    nop
    to r0
    ldw (r10)                   ; the font's bank, relative to the level's
    ibt r6, #LEVEL_BANK_BASE
    with r0
    add r6
    romb
    inc r10
    inc r10
    inc r10                     ; past the two remaps' addresses
    inc r10
    inc r10
    inc r10
    iwt r0, #$A0
    color                       ; all eight bits, while POR bit 3 is clear
    ibt r0, #POR_FREEZE_HIGH    ; then frozen; transparency on, 4-bit test
    cmode
    iwt r13, #TX_Pix
TX_Glyph:
    to r7
    ldw (r10)                   ; x
    inc r10
    inc r10
    to r2
    ldw (r10)                   ; y
    inc r10
    inc r10
    to r14
    ldw (r10)                   ; its pixels: the ROM buffer starts on them
    inc r10
    inc r10
    to r5
    ldb (r10)                   ; w
    inc r10
    to r6
    ldb (r10)                   ; h
    inc r10
TX_Row:
    move r1, r7
    move r12, r5
TX_Pix:
    getc
    inc r14
    loop
    plot
    inc r2
    dec r6
    bne TX_Row
    nop
    dec r8
    bne TX_Glyph
    nop
    ibt r0, #POR_TRANSPARENT
    cmode
TX_Done:
    GRET

; ===========================================================================
; BillboardNode -- DrawModel's billboard node, FX3: the 3x3 becomes identity,
; as the GSU-2 build does inline; and for a sprite sequence (NODE_SEQUENCE,
; the effects model -- packer buildFxModel) the frame's Y angle byte says
; which of the node's run of one-quad meshes this frame is: MD_ADDR moves on
; MD_AY * SPRITE_MESH. The frame was clamped to the animation's (DrawModel),
; so the byte is one the packer wrote for this run.
; ===========================================================================

; ===========================================================================
; DrawMeshFlash -- DrawModel's DrawMesh, FX3; then, after either of her hands
; (node 10, the right arm's; 13, the left's) while that arm's GS_FLASH timer
; runs, upstream's drawFlash: in the hand's frame, the gun's flashOffset down
; it (GS_KIT + 22: 155, the uzis' 180) and 55 out,
; matrixRotateYXZ(-90 degrees, 0, the shot's random roll), the muzzle-flash
; model's one mesh.
; ===========================================================================

DrawMeshFlash:
    sm (FL_LINK), r11
    GFCALL DrawMesh
.IF PISTOL_AVAILABLE
.IF FLASH_MESH_BANK != 255
    lm r0, (WA_LARA)
    with r0
    from r0
    bne +
    nop
    GFJMP DMF_Done
+   lm r5, (WA_NODE)
    iwt r10, #GS_FLASH
    ibt r6, #10
    from r5
    cmp r6
    beq +
    nop
    inc r10
    inc r10
    ibt r6, #13
    from r5
    cmp r6
    beq +
    nop
    GFJMP DMF_Done
+   to r0
    ldb (r10)                   ; the timer
    with r0
    from r0
    bne +
    nop
    GFJMP DMF_Done
+
    inc r10
    to r0
    ldb (r10)                   ; the roll
    sm (FL_ANG), r0
    GFCALL MatrixPush
    ibt r0, #0
    sms (MX_X), r0
    lm r0, (GS_KIT + 22)        ; weaponParams' flashOffset: 155, the uzis' 180
    sms (MX_Y), r0
    ibt r0, #55
    sms (MX_Z), r0
    GFCALL MatrixTranslateRel
    iwt r0, #$C0                ; -90 degrees, the top byte
    GFCALL MatrixRotateX
    lm r0, (FL_ANG)
    with r0
    from r0
    beq +
    nop
    GFCALL MatrixRotateZ
+   iwt r0, #FLASH_MESH_ADDR
    sms (R_ADDR), r0
    iwt r0, #(LEVEL_BANK_BASE + FLASH_MESH_BANK)
    sms (R_ROMB), r0
    GFCALL TransformMesh
    GFCALL DrawMesh
    GFCALL MatrixPop
DMF_Done:
.ENDIF
.ENDIF
    lm r11, (FL_LINK)
    GRET

; ===========================================================================
; InstTurn -- DrawRoomMeshes' turn, FX3 (R0 = the placement's angle byte):
; MatrixRotateY, unless it is ROOM_SPRITE_TURN, which no static has (TR
; stands them on quarter turns; the packer refuses one that is not): a room
; sprite's quad, which faces the camera -- the 3x3 to identity, as a
; billboard node's, which TransformRoom's yaw-only path takes as yaw 0.
; ===========================================================================

.DEFINE ROOM_SPRITE_TURN $01

InstTurn:
    ibt r6, #ROOM_SPRITE_TURN
    from r0
    cmp r6
    beq +
    nop
    GFJMP MatrixRotateY         ; its GRET returns to DrawRoomMeshes
+   iwt r0, #$7FFF              ; 1.0 in 1.15
    ibt r5, #0
    sms (M_00), r0
    sms (M_01), r5
    sms (M_02), r5
    sms (M_10), r5
    sms (M_11), r0
    sms (M_12), r5
    sms (M_20), r5
    sms (M_21), r5
    sms (M_22), r0
    GRET

BillboardNode:
    iwt r0, #$7FFF              ; 1.0 in 1.15
    ibt r5, #0
    sms (M_00), r0
    sms (M_01), r5
    sms (M_02), r5
    sms (M_10), r5
    sms (M_11), r0
    sms (M_12), r5
    sms (M_20), r5
    sms (M_21), r5
    sms (M_22), r0
    ibt r6, #NODE_SEQUENCE
    lms r0, (MD_FLAGS)
    from r0
    and r6
    beq +
    nop
    lms r0, (MD_AY)
    ibt r6, #SPRITE_MESH
    umult r6                    ; a byte by a byte
    lms r6, (MD_ADDR)
    add r6
    sms (MD_ADDR), r0
+   GRET

; ===========================================================================
; WeaponNodeFx3 -- DrawModel's WeaponModelNode, FX3: upstream's meshSwap for
; all four guns. Her mesh at a node is the host's choice (Weapon_publish,
; weapon.c): GS_KIT holds a byte per node, 0 for the model's own, else an
; index into KitMeshes -- her thighs with or without a gun's holster, her
; hands with the gun of the moment or the shotgun, her torso with or without
; the shotgun on her back, her head or the uzis' gritted one. An arm's nodes
; then take that arm's animation as WeaponModelNode's do, from the pistols'
; four (0-3) or the shotgun's three (4-6), both arms on the same one.
; ===========================================================================

WeaponNodeFx3:
    ; upstream's drawNodes: a node whose visibleMask bit is clear keeps its
    ; transform and draws nothing. Bit 0 is the root's; ASR keeps $FFFF
    ; whole past sixteen nodes, and a mask's clear top bit hides the rest.
    lm r0, (MD_VIS)
    asr
    sm (MD_VIS), r0
    bcs +
    nop
    iwt r0, #INST_NONE
    sms (MD_BANK), r0
+
.IF WEAPON_KIT
    lm r0, (WA_LARA)
    with r0
    from r0
    bne +
    nop
    GRET
+   sm (WA_LINK), r11
    ibt r0, #15
    lms r5, (MD_I)
    to r5
    sub r5                      ; node index, body frame already advanced
    sm (WA_NODE), r5

    iwt r10, #GS_KIT
    with r10
    add r5
    to r0
    ldb (r10)                   ; 0: the model's own mesh
    with r0
    from r0
    beq KN_Pose
    nop
    ibt r6, #KIT_MESHES
    from r0
    cmp r6
    bcs KN_Pose                 ; past the table: stale RAM, draw her own
    nop
    with r0
    add r0
    with r0
    add r0
    iwt r6, #KitMeshes
    to r14
    add r6
    ibt r6, #GSU_BANK
    from r6
    romb
    move r14, r14               ; ROMB alone does not refill the ROM buffer
    GFCALL RomWordAt
    sms (MD_ADDR), r0
    GFCALL RomByteAt
    sms (MD_BANK), r0
    GFCALL RomByteAt
    with r0
    swap
    move r5, r0
    lms r0, (MD_FLAGS)
    iwt r6, #$00FF
    with r0
    and r6
    with r0
    or r5
    sms (MD_FLAGS), r0

KN_Pose:
    lm r5, (WA_NODE)
    ibt r6, #8
    from r5
    cmp r6
    bcs +
    nop
    lm r11, (WA_LINK)
    GRET
+   ibt r6, #14
    from r5
    cmp r6
    bcc +
    nop
    lm r11, (WA_LINK)
    GRET
+   lm r0, (GS_WEAPON)
    ibt r6, #2
    from r0
    cmp r6
    bcs +
    nop
    lm r11, (WA_LINK)
    GRET                        ; FREE/BUSY: the body's animation
+   iwt r10, #(GS_WEAPON + 2)
    ibt r6, #11
    from r5
    cmp r6
    bcc +
    nop
    ibt r0, #12
    with r10
    add r0
+   sm (WA_ARM), r10
    to r0
    ldw (r10)                   ; animation, NONE or invalid => body pose
    ibt r6, #7
    from r0
    cmp r6
    bcc +
    nop
    lm r11, (WA_LINK)
    GRET
+   with r0
    add r0
    with r0
    add r0
    iwt r6, #KitFrames
    to r14
    add r6
    ibt r6, #GSU_BANK
    from r6
    romb
    move r14, r14
    GFCALL RomWordAt
    move r8, r0
    GFCALL RomByteAt
    move r9, r0                 ; frame ROM bank, absolute
    GFCALL RomByteAt
    move r6, r0                 ; final frame index
    lm r10, (WA_ARM)
    inc r10
    inc r10
    to r5
    ldw (r10)
    from r6
    cmp r5
    bcs +
    nop
    ibt r5, #0                  ; clamp a corrupt frame before reading ROM
+   ibt r6, #51                 ; root XYZ and fifteen byte-angle triples
    with r5
    umult r6
    with r8
    add r5
    lm r5, (WA_NODE)
    ibt r6, #3
    with r5
    umult r6
    ibt r0, #6
    with r5
    add r0
    from r8
    to r14
    add r5
    from r9
    romb
    move r14, r14
    GFCALL RomByteAt
    sms (MD_AX), r0
    GFCALL RomByteAt
    sms (MD_AY), r0
    GFCALL RomByteAt
    sms (MD_AZ), r0
    lm r11, (WA_LINK)
    GRET
.ELSE
    GFJMP WeaponModelNode
.ENDIF

; ===========================================================================
; WeaponLookFx3 -- DrawModel's WeaponModelLook, FX3: the torso's turn is
; updateLook's plus, while the shotgun's animation runs, drawLaraNodes'
; "additional torso animation for shotgun" (GS_KIT + 16..21, the host's,
; from the packer's table): matrixRotateYXZ(x, y, z), Y then X then Z. The
; head's is WeaponModelLook's own.
; ===========================================================================

WeaponLookFx3:
.IF WEAPON_KIT
    lm r0, (WA_LARA)
    with r0
    from r0
    bne +
    nop
    GRET
+   lm r5, (WA_NODE)
    ibt r6, #7
    from r5
    cmp r6
    beq +
    nop
    GFJMP WeaponModelLook       ; its GRET returns to DrawModel
+   sm (WA_LINK), r11
    lm r0, (GS_LOOK + 2)
    lm r6, (GS_KIT + 18)
    add r6
    hib
    beq +
    nop
    GFCALL MatrixRotateY
+   lm r0, (GS_LOOK)
    lm r6, (GS_KIT + 16)
    add r6
    hib
    beq +
    nop
    GFCALL MatrixRotateX
+   lm r0, (GS_KIT + 20)
    hib
    beq +
    nop
    GFCALL MatrixRotateZ
+   lm r11, (WA_LINK)
    GRET
.ELSE
    GFJMP WeaponModelLook
.ENDIF

; ===========================================================================
; The near projection, FX3: what lies between the clip plane (ZNEAR, 64,
; upstream's VIEW_MIN_F) and the far end of the first table step (ZMIN).
; The table path takes 65536 / dz for dz = (z >> 8) * 2 and FMULTs by it,
; 128 c / z rounded to 256 units of depth; 65536 / 2 does not fit the signed
; word FMULT reads, so 512 is as near as it goes. Here the same table is
; read at z >> 1 instead -- 32..255, 2048 at the most -- and LMULT keeps
; the whole product: c * 65536 / (z >> 1) >> 10 is 128 c / z again, to 2
; units of depth, and the doubled inventory table doubles it as before.
; The three callers are out of their windows on purpose: this is a few
; vertices a frame, the windows are tuned to the byte.
;
; NEAR_SCALE: R5:R4 (LMULT's high and low words) to R5 = the product >> 10,
; which fits a word when the high word is -128..127; outside that, +-8K,
; the range the table path reaches (128 * 32767 / 512), which every edge
; difference downstream is sized for. R0 is spent; R6 survives for the
; second coordinate.
; ===========================================================================

.MACRO NEAR_SCALE
    iwt r0, #128
    add r5                      ; the high word + 128
    hib                         ; zero when that is 0..255
    beq _ns_in\@
    nop
    ibt r0, #0
    from r5
    cmp r0
    bmi _ns_neg\@
    nop
    iwt r5, #8191
    bra _ns_done\@
    nop
_ns_neg\@:
    iwt r5, #$E000              ; -8192
    bra _ns_done\@
    nop
_ns_in\@:
    from r5
    lob
    swap                        ; the high word's low byte, << 8
    from r4
    to r5
    hib                         ; the low word >> 8
    to r5
    or r5                       ; the product >> 8 (OR takes r1-r15)
    with r5
    asr
    with r5
    asr                         ; >> 10
_ns_done\@:
.ENDM

; TM_Near -- TM_Project's arm for a vertex short of ZMIN. R9/R10/R11 are
; camera X/Y/Z, R7 the transformed vertex, R4 the shade (SHADING), R12/R13
; LOOP's and R14 the vertex stream, all live. Back to TM_Store with R5/R8 the
; screen point, or behind the plane to TM_Flagged with R1 = 1, as before.
TM_Near:
    iwt r0, #ZNEAR
    from r11
    sub r0
    bpl TN_Project
    nop
    ; Behind the plane: bit 0, and -- at or behind the camera -- which
    ; sides of the room's clip rectangle it is past, so that a face wholly
    ; beside or behind the camera is dropped by OTBuild's AND before it is
    ; clipped: the floor under the camera, the walls beside it. "Past the
    ; right" for a vertex in front is 128 x >= k z, k = x1 - SCREEN_CX; at
    ; z <= 0 with k >= 0 that holds whenever x >= 0, and likewise for the
    ; other three sides by the signs of x, y and theirs. RoomClipFx3 keeps
    ; NK_MASK to the sides whose k has that sign; z of 1..63 gets bit 0
    ; alone. DrawFace reads bit 0 alone.
    ibt r1, #1
    from r11
    sub #1
    GBGE TN_Flag                ; z >= 1
    nop
    with r9
    from r9                     ; MOVES: x's sign
    ibt r2, #4                  ; x >= 0: past the right
    bpl +
    nop
    ibt r2, #2                  ; else past the left
+   with r10
    from r10                    ; MOVES: y's sign
    ibt r0, #16                 ; y >= 0: below
    bpl +
    nop
    ibt r0, #8                  ; else above
+   to r2
    or r2                       ; R2 = R0 | R2
    lm r6, (NK_MASK)
    with r2
    and r6
    with r1
    or r2
TN_Flag:
    ibt r0, #TV_G
    with r7
    add r0
.IFDEF SHADING
    from r4
    stw (r7)
.ENDIF
    inc r7
    inc r7                      ; TV_CX
    iwt r15, #TM_Flagged
    nop
TN_Project:
.IFDEF SHADING
    move r2, r4                 ; LMULT writes R4
.ENDIF
    ibt r6, #-2
    with r6
    and r11                     ; (z >> 1) * 2
    iwt r0, #M7_PROJTAB
    with r6
    add r0
    to r6
    ldw (r6)                    ; 65536 / (z >> 1), doubled for the inventory
    from r9
    to r5
    lmult
    NEAR_SCALE
    iwt r0, #SCREEN_CX
    from r5
    to r1
    add r0                      ; R1 = screen X, over the second LMULT
    from r10
    to r5
    lmult
    NEAR_SCALE
    lms r0, (FR_CY)             ; the sheared centre line
    from r5
    to r8
    add r0                      ; R8 = screen Y
    move r5, r1                 ; R5 = screen X
.IFDEF SHADING
    move r4, r2
.ENDIF
    iwt r15, #TM_Store
    nop

; PC_Near -- ProjectClip's arm for a clip vertex short of ZMIN: R9/R11/R3
; camera X/Y/Z, R8 the link, R10 the clip vertex, R12/R13 LOOP's. R4 is free
; (ClipT has spent it). ClipT's t is 8.8, so an intersection can land a few
; units short of the plane on a long edge; z is held at ZNEAR for the table.
PC_Near:
    iwt r0, #ZNEAR
    from r3
    sub r0
    bpl +
    nop
    iwt r3, #ZNEAR
+   ibt r6, #-2
    with r6
    and r3
    iwt r0, #M7_PROJTAB
    with r6
    add r0
    to r6
    ldw (r6)
    from r9
    to r5
    lmult
    NEAR_SCALE
    iwt r0, #SCREEN_CX
    with r5
    add r0
    from r5
    stw (r8)                    ; VL_X
    inc r8
    inc r8
    from r11
    to r5
    lmult
    NEAR_SCALE
    lms r0, (FR_CY)             ; the sheared centre line
    with r5
    add r0
    from r5
    stw (r8)                    ; VL_Y
    iwt r15, #PC_Stored
    nop

; ShearNear -- frame.gsu's pitch for a target short of ZMIN (R5 = its depth
; along the view): the centre line to where the target projects, as TM_Near
; would project it, if it is in front of the plane at all. R3, the frame
; buffer, is FrameBody's. Before FrameBody, so SHEAR_TAB (RECIP_TAB) and not
; M7_PROJTAB, which FrameBody refills.
ShearNear:
    iwt r0, #ZNEAR
    from r5
    sub r0
    bmi SN_Done
    nop
    ibt r6, #-2
    with r6
    and r5
    iwt r0, #SHEAR_TAB
    with r6
    add r0
    to r6
    ldw (r6)                    ; 65536 / (zc >> 1)
    lm r7, (FR_TGTY)
    lm r0, (FR_CAMY)
    with r7
    sub r0                      ; dy: the target below the view is positive
    from r7
    to r5
    lmult
    NEAR_SCALE
    iwt r0, #SCREEN_CY
    with r0
    sub r5
    sm (FR_CY), r0
SN_Done:
    iwt r15, #ShearDone
    nop

; ShadowCentre, ShadowProjectFx -- ShadowRender's projections nearer than
; ZMIN, where the model it lies under is TM_Near's. ShadowProject reads the
; table at z / 128 and ProjectPoint rejects; here a point at 64..511 is
; projected as TM_Near projects it -- exactly, so the centre's anchor offset
; (the bucketed projection less the exact one) is zero there. ShadowRender
; still refuses a corner short of ZNEAR: the octagon is filled on the
; screen, unclipped.
ShadowCentre:
    sm (SHC_LINK), r11
    GFCALL ProjectPoint
    lms r0, (T_REJECT)
    ibt r5, #0
    from r0
    cmp r5
    beq SC_Done                 ; the table's: as before
    nop
    lms r0, (T_CZ)
    iwt r5, #ZNEAR
    cmp r5
    GBLT SC_Done                ; behind the plane: still rejected
    nop
    GFCALL SP_Near
    sms (T_SX), r1
    sms (T_SY), r2
    ibt r0, #0
    sms (T_REJECT), r0
SC_Done:
    lm r11, (SHC_LINK)
    GRET

ShadowProjectFx:
    lms r5, (T_CZ)
    iwt r0, #ZMIN
    from r5
    cmp r0
    GBLT SP_Near
    nop
    GFJMP ShadowProject         ; its GRET returns to the caller

; SP_Near -- T_CX/T_CY at T_CZ (64..511) to R1/R2, Z clear, as ShadowProject
; returns them. RECIP_TAB: the ring draws no shadows.
SP_Near:
    lms r5, (T_CZ)
    ibt r6, #-2
    with r6
    and r5                      ; (z >> 1) * 2
    iwt r0, #RECIP_TAB
    with r6
    add r0
    to r6
    ldw (r6)                    ; 65536 / (z >> 1)
    lms r0, (T_CX)
    to r5
    lmult
    NEAR_SCALE
    iwt r1, #SCREEN_CX
    with r1
    add r5
    lms r0, (T_CY)
    to r5
    lmult
    NEAR_SCALE
    lm r2, (FR_CY)
    with r2
    add r5
SP_Out:                         ; R1/R2 (tools/nearcheck.py reads them here)
    ibt r0, #0
    inc r0                      ; Z clear
    GRET

; RoomClipFx3 -- frame.gsu's RoomClip, FX3, then NK_MASK for TM_Near: the
; sides of the rectangle whose k (its edge less the projection's centre)
; has the sign that makes x, y >= 0 or < 0 enough at z <= 0. Past the
; right: x1 >= SCREEN_CX; left: x0 <= SCREEN_CX; below: y1 >= FR_CY;
; above: y0 <= FR_CY. A portal's rectangle off to one side keeps three.
RoomClipFx3:
    sm (NK_LINK), r11
    GFCALL RoomClip
    ibt r5, #0
    iwt r6, #SCREEN_CX
    lms r0, (V_CLIPX1)
    cmp r6
    GBLT +
    nop
    with r5
    or #4
+   lms r0, (V_CLIPX0)
    from r6
    cmp r0
    GBLT +
    nop
    with r5
    or #2
+   lms r6, (FR_CY)
    lms r0, (V_CLIPY1)
    cmp r6
    GBLT +
    nop
    ibt r0, #16
    to r5
    or r5
+   lms r0, (V_CLIPY0)
    from r6
    cmp r0
    GBLT +
    nop
    with r5
    or #8
+   sm (NK_MASK), r5
    lm r11, (NK_LINK)
    GRET

; InvNear -- FB_Inv's InvRender, with NK_MASK cleared first: the ring has no
; room and no rectangle, and the mask is the last room's.
InvNear:
    ibt r0, #0
    sm (NK_MASK), r0
    GFJMP InvRender             ; its GRET returns to FB_Inv

.IF WEAPON_KIT
